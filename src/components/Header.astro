---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { navItems, siteConfig, withBase } from "@/utils/site";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 py-3">
  <nav class="container exhibition-panel flex min-h-14 items-center justify-between gap-5 rounded-full px-4 md:px-5">
    <a href={withBase("/")} class="group flex items-center gap-3 font-semibold">
      <span class="inverse-control grid size-8 place-items-center rounded-md font-mono text-xs transition">
        {siteConfig.logoText || "M"}
      </span>
      <span class="max-w-[42vw] truncate font-mono text-sm tracking-wide sm:max-w-none">{siteConfig.author}</span>
    </a>

    <div class="flex items-center gap-2">
      <div class="hidden items-center rounded-full border border-[var(--line)] bg-white/20 p-1 md:flex dark:bg-black/10">
        {navItems.map((item) => {
          const href = withBase(item.href);
          const active = item.href === "/" ? currentPath === withBase("/") : currentPath.startsWith(href);
          return (
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-full px-3.5 py-1.5 font-mono text-xs text-[var(--muted)] transition hover:text-[var(--foreground)]",
                active && "nav-pill-active",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
      <ThemeToggle />
    </div>
  </nav>

  <div class="container flex gap-2 overflow-x-auto pt-2 md:hidden">
    {navItems.map((item) => {
      const href = withBase(item.href);
      const active = item.href === "/" ? currentPath === withBase("/") : currentPath.startsWith(href);
      return (
        <a
          href={href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "shrink-0 rounded-full border border-[var(--line)] bg-[var(--glass)] px-3 py-1.5 font-mono text-xs text-[var(--muted)] backdrop-blur-xl",
            active && "nav-pill-active border-[var(--foreground)]",
          ]}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>
