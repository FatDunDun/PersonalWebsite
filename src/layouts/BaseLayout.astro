---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import "@/styles/global.css";
import { absoluteUrl, assetUrl, homeConfig, siteConfig, withBase } from "@/utils/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  type = "website",
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.author}`;
const canonical = Astro.url.href;
const resolvedOgImage = assetUrl(image);
const ogImage = resolvedOgImage.startsWith("http") ? resolvedOgImage : absoluteUrl(image);
const heroBackgroundImage = homeConfig.heroBackgroundImage || "/site-assets/home-exhibition-bg.jpg";
const isHome = Astro.url.pathname === withBase("/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body
    class:list={["site-body", isHome && "site-body--home"]}
    style={`--exhibition-bg: url("${assetUrl(heroBackgroundImage)}")`}
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
