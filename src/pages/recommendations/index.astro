---
import { recommendations } from "@/data/recommendations";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { assetUrl, pageConfig, withBase } from "@/utils/site";

const categoryLabels = {
  book: "书籍",
  film: "影视",
  music: "歌曲",
  game: "游戏",
  other: "其他",
};

const categoryOrder = ["book", "film", "music", "game", "other"];
const groupedRecommendations = categoryOrder
  .map((category) => ({
    category,
    label: categoryLabels[category],
    items: recommendations.filter((item) => item.category === category),
  }))
  .filter((group) => group.items.length);

const isExternalLink = (href: string) => /^https?:\/\//.test(href);
const resolveRecommendationLink = (href?: string) => {
  if (!href) return "#";
  if (href.startsWith("/")) return withBase(href);
  return href;
};
const pageCopy = pageConfig.recommendations;
---

<BaseLayout title={pageCopy.title} description={pageCopy.description}>
  <section class="container py-12 md:py-18">
    <div class="page-hero grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="page-kicker">{pageCopy.kicker}</p>
        <h1 class="page-title mt-4 text-6xl md:text-8xl">{pageCopy.title}</h1>
      </div>
      <p class="note-rule max-w-2xl text-lg leading-8 text-[var(--muted)]">
        {pageCopy.description}
      </p>
    </div>

    <div class="mt-8 flex flex-wrap gap-2">
      {groupedRecommendations.map((group) => (
        <a href={`#${group.category}`} class="tag-chip px-3 py-2 font-mono text-sm transition hover:border-[var(--foreground)] hover:text-[var(--foreground)]">
          {group.label} · {group.items.length}
        </a>
      ))}
    </div>

    <div class="mt-12 grid gap-14">
      {groupedRecommendations.map((group) => (
        <section id={group.category} class="scroll-mt-24">
          <div class="mb-5 flex items-end justify-between gap-4 border-b border-[var(--line)] pb-3">
            <div>
              <p class="page-kicker">{group.category}</p>
              <h2 class="literary-title mt-2 text-3xl">{group.label}</h2>
            </div>
            <span class="folio-number text-sm">{String(group.items.length).padStart(2, "0")}</span>
          </div>

          <div class="grid gap-4 lg:grid-cols-2">
            {group.items.map((item) => {
              const href = resolveRecommendationLink(item.link);
              const external = isExternalLink(href);
              return (
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="artifact-card recommendation-card group grid min-h-full grid-cols-[7rem_minmax(0,1fr)] items-start gap-3 rounded-[1.25rem] p-2.5 transition sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-4 lg:grid-cols-[9.5rem_minmax(0,1fr)]"
                >
                  <div class="recommendation-cover relative overflow-hidden rounded-[0.9rem] border border-[var(--line)] bg-[var(--surface-soft)]">
                    {item.image ? (
                      <img class="aspect-[4/5] w-full object-cover transition duration-500 group-hover:scale-[1.02]" src={assetUrl(item.image)} alt={item.title} loading="lazy" />
                    ) : (
                      <div class="grid aspect-[4/5] place-items-center px-3 text-center">
                        <p class="font-mono text-xs uppercase tracking-[0.22em] text-[var(--muted)]">No Cover</p>
                      </div>
                    )}
                    {item.rating && <span class="recommendation-rating absolute right-2 top-2 px-2 py-1 font-mono text-xs">{item.rating}</span>}
                  </div>
                  <div class="flex min-h-full min-w-0 flex-col py-1.5 pr-1.5 sm:py-2">
                    <h3 class="recommendation-title literary-title text-lg leading-tight group-hover:text-[var(--accent)] sm:text-xl">{item.title}</h3>
                    <p class="mt-2 font-mono text-xs text-[var(--muted)]">{[item.creator, item.year].filter(Boolean).join(" · ")}</p>
                    <p class="recommendation-description mt-3 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
                    <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
                      {(item.tags || []).map((tag) => (
                        <span class="tag-chip px-2 py-1 font-mono text-[11px]">{tag}</span>
                      ))}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
