---
import { assetUrl, pageConfig } from "@/utils/site";

const pageCopy = pageConfig.about;
const profileImage = pageCopy.image || "/personal-photo/gallery-workspace.png";
const profileImageAlt = pageCopy.imageAlt || pageCopy.title;
const summary = Array.isArray(pageCopy.summary) && pageCopy.summary.length ? pageCopy.summary : [pageCopy.description].filter(Boolean);
const focus = Array.isArray(pageCopy.focus) ? pageCopy.focus.filter(Boolean) : [];
const links = Array.isArray(pageCopy.links) ? pageCopy.links.filter((item) => item?.label && item?.href) : [];
const facts = [
  { label: "角色", value: pageCopy.role },
  { label: "公司", value: pageCopy.company },
  { label: "邮箱", value: pageCopy.email, href: pageCopy.email ? `mailto:${pageCopy.email}` : "" },
  { label: "所在地", value: pageCopy.location },
].filter((item) => item.value);
---

<section class="container grid gap-10 py-12 md:grid-cols-[0.9fr_1.1fr] md:py-18">
    <aside>
      <div class="sticky top-28">
        <div class="artifact-card rounded-[2rem] p-2">
          <img class="aspect-[4/5] w-full rounded-[1.5rem] border border-[var(--line)] object-cover photo-shadow" src={assetUrl(profileImage)} alt={profileImageAlt} />
        </div>
        <div class="mt-5 page-hero pb-6">
          <p class="page-kicker">{pageCopy.kicker}</p>
          <h1 class="page-title mt-3 text-6xl">{pageCopy.title}</h1>
          <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{pageCopy.description}</p>
        </div>
      </div>
    </aside>

    <div class="artifact-card about-content-card rounded-[2rem] p-6 md:p-10">
      <div class="space-y-10">
        <section>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Profile</p>
          <h2 class="mt-3 text-4xl font-semibold leading-tight md:text-5xl">{pageCopy.role || pageCopy.title}</h2>
          <div class="profile-index mt-7">
            <div class="profile-index__header">
              <p>Identity / details</p>
              <p>{String(facts.length).padStart(2, "0")} entries</p>
            </div>
            <dl class="profile-index__grid">
              {facts.map((item, index) => (
                <div class="profile-index__item">
                  <div class="profile-index__label">
                    <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <dt>{item.label}</dt>
                  </div>
                  <dd>
                    {item.href ? (
                      <a href={item.href}>{item.value}<span aria-hidden="true">↗</span></a>
                    ) : (
                      <span>{item.value}</span>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </section>

        <section class="prose max-w-none">
          <h2>个人简介</h2>
          {summary.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        {focus.length ? (
          <section class="prose max-w-none">
            <h2>关注方向</h2>
            <ul>
              {focus.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ) : null}

        {links.length ? (
          <section>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Links</p>
            <div class="mt-4 flex flex-wrap gap-3">
              {links.map((link) => (
                <a class="story-button story-button--secondary" href={link.href}>
                  {link.label}
                </a>
              ))}
            </div>
          </section>
        ) : null}
      </div>
    </div>
</section>

<style>
  .about-content-card {
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--surface) 96%, var(--accent-warm)), var(--surface));
  }

  .profile-index {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--surface-soft) 92%, var(--accent-warm)), var(--surface-soft));
    box-shadow:
      inset 0 1px 0 rgb(255 252 246 / 0.38),
      0 10px 28px rgb(61 45 33 / 0.07);
  }

  .profile-index__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.15rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .profile-index__grid {
    display: grid;
  }

  .profile-index__item {
    position: relative;
    min-width: 0;
    padding: 1.25rem 1.15rem 1.35rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 180ms ease;
  }

  .profile-index__item:last-child {
    border-bottom: 0;
  }

  .profile-index__item::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent-warm);
    opacity: 0;
    transform: scaleY(0.35);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .profile-index__item:hover {
    background: color-mix(in srgb, var(--accent-warm) 9%, transparent);
  }

  .profile-index__item:hover::before {
    opacity: 0.9;
    transform: scaleY(1);
  }

  .profile-index__label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .profile-index__label span {
    color: var(--accent-warm);
  }

  .profile-index__item dd {
    min-width: 0;
    margin-top: 0.65rem;
    color: var(--foreground);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 650;
    line-height: 1.45;
  }

  .profile-index__item dd > span,
  .profile-index__item dd a {
    display: block;
    overflow-wrap: anywhere;
  }

  .profile-index__item dd a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
  }

  .profile-index__item dd a span {
    color: var(--accent-strong);
    font-size: 0.85em;
    transition: transform 180ms ease;
  }

  .profile-index__item dd a:hover span {
    transform: translate(0.12rem, -0.12rem);
  }

  @media (min-width: 640px) {
    .profile-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile-index__item:nth-child(odd) {
      border-right: 1px solid var(--line);
    }

    .profile-index__item:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-index__item,
    .profile-index__item::before,
    .profile-index__item dd a span {
      transition: none;
    }
  }
</style>
