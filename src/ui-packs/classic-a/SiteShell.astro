---
import "./styles.css";
import CursorField from "./components/CursorField.astro";
import Footer from "./components/Footer.astro";
import Header from "./components/Header.astro";
import { imageUrl, uiPresetConfig } from "@/utils/site";
import { manifest } from "./manifest";

const packConfig = uiPresetConfig(manifest.id);
const heroImage = packConfig.appearance?.homeHero?.backgroundImage || "/site-assets/home-exhibition-bg.jpg";
const heroFocalPoint = packConfig.appearance?.homeHero?.focalPoint || "center center";
const optimizedHeroImage = imageUrl(heroImage, { width: 1920, quality: 78 });
---

<div
  class="ui-pack-root"
  style={`--exhibition-bg: url("${optimizedHeroImage}"); --exhibition-position: ${heroFocalPoint}`}
>
  <CursorField />
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</div>
