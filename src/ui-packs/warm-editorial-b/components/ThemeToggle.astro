---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="切换深色模式"
  class="theme-toggle grid size-11 place-items-center rounded-full text-[var(--foreground)] transition"
>
  <svg class="theme-icon-sun size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 4V2m0 20v-2M4 12H2m20 0h-2m-2.34-5.66 1.42-1.42M4.92 19.08l1.42-1.42m0-11.32L4.92 4.92m14.16 14.16-1.42-1.42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
  </svg>
  <svg class="theme-icon-moon hidden size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M20 15.4A8 8 0 0 1 8.6 4a8.8 8.8 0 1 0 11.4 11.4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
  </svg>
</button>

<script is:inline>
  const button = document.getElementById("theme-toggle");
  const sun = button?.querySelector(".theme-icon-sun");
  const moon = button?.querySelector(".theme-icon-moon");

  const updateIcon = () => {
    const isDark = document.documentElement.classList.contains("dark");
    sun?.classList.toggle("hidden", isDark);
    moon?.classList.toggle("hidden", !isDark);
  };

  updateIcon();
  button?.addEventListener("click", () => {
    const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
    document.documentElement.classList.toggle("dark", nextTheme === "dark");
    localStorage.setItem("theme", nextTheme);
    window.dispatchEvent(new CustomEvent("theme-change", { detail: nextTheme }));
    updateIcon();
  });
</script>
