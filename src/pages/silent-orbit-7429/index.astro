      const makeUploadName = (file) => {
        const typeExtensions = {
          "image/jpeg": "jpg",
          "image/png": "png",
          "image/webp": "webp",
          "image/gif": "gif",
          "image/avif": "avif",
          "image/svg+xml": "svg",
          "video/mp4": "mp4",
          "video/webm": "webm",
          "video/quicktime": "mov",
        };
        const extension = typeExtensions[file.type] || (file.name.split(".").pop() || "png").toLowerCase();
        const baseName = slugifyFile(file.name.replace(/\.[^.]+$/, "")) || "media";
        const suffix = crypto.randomUUID ? crypto.randomUUID().slice(0, 8) : Math.random().toString(36).slice(2, 10);
        return `${Date.now()}-${baseName}-${suffix}.${extension}`;
      };

      const MEDIA_LIMITS = {
        image: {
          types: ["image/jpeg", "image/png", "image/webp", "image/avif"],
          extensions: ["jpg", "jpeg", "png", "webp", "avif"],
          label: "图片",
          formats: "JPG、PNG、WebP 或 AVIF",
        },
        video: {
          maxSize: 50 * 1024 * 1024,
          types: ["video/mp4", "video/webm", "video/quicktime"],
          extensions: ["mp4", "webm", "mov"],
          label: "视频",
          formats: "MP4、WebM 或 MOV",
        },
      };

      const formatFileSize = (size) => {
        if (size >= 1024 * 1024) return `${(size / 1024 / 1024).toFixed(1).replace(/\.0$/, "")}MB`;
        if (size >= 1024) return `${Math.ceil(size / 1024)}KB`;
        return `${size}B`;
      };

      const getFileExtension = (file) => (file.name.split(".").pop() || "").toLowerCase();

      const validateMediaFile = (file, kind) => {
        const rule = MEDIA_LIMITS[kind];
        const extension = getFileExtension(file);
        const hasAllowedType = file.type ? rule.types.includes(file.type) : false;
        const hasAllowedExtension = rule.extensions.includes(extension);

        if (!hasAllowedType && !hasAllowedExtension) {
          throw new Error(`${file.name} 格式不支持。${rule.label}请上传 ${rule.formats}。`);
        }

        if (rule.maxSize && file.size > rule.maxSize) {
          throw new Error(`${file.name} 太大了：${formatFileSize(file.size)}。${rule.label}请控制在 ${formatFileSize(rule.maxSize)} 以内。`);
        }
      };

      const validateMediaFiles = (files, kind) => {
        files.forEach((file) => validateMediaFile(file, kind));
      };

      const uploadMediaFile = async (file, directory = IMAGES_PATH, publicRoot = "/images") => {
        const safeName = makeUploadName(file);
        const path = `${directory}/${safeName}`;
        const publicPath = `${publicRoot}/${safeName}`;
        const remote = mediaStorageMode() === "r2";
        const isVideo = publicRoot.startsWith("/videos") || publicRoot.startsWith("/personal-video");
        const queued = {
          kind: isVideo ? "video" : "image",
          name: safeName,
          path: remote ? mediaKeyFromPublicPath(publicPath) : path,
          key: mediaKeyFromPublicPath(publicPath),
          publicPath,
          ...(remote ? { file, remote: true } : { content: arrayBufferToBase64(await file.arrayBuffer()) }),
          previewUrl: URL.createObjectURL(file),
          pending: true,
        };
        state.pendingMedia.uploads.push(queued);
        updatePendingChangesUi();
        return queued;
      };

      const addUploadedAssetIfVisible = (asset) => {
        if (asset.publicPath?.startsWith("/images/") && !state.images.some((image) => image.path === asset.path)) {
          state.images = [asset, ...state.images];
        }
        if (asset.publicPath?.startsWith("/videos/") && !state.videos.some((video) => video.path === asset.path)) {
          state.videos = [asset, ...state.videos];
        }
      };

      const removePendingMediaByPath = (path) => {
        const existing = state.pendingMedia.uploads.findIndex((item) => item.path === path);
        if (existing >= 0) {
          const [removed] = state.pendingMedia.uploads.splice(existing, 1);
          if (removed.previewUrl) URL.revokeObjectURL(removed.previewUrl);
        }
        state.pendingMedia.deletes = state.pendingMedia.deletes.filter((item) => item.path !== path);
        state.images = state.images.filter((image) => image.path !== path);
        state.videos = state.videos.filter((video) => video.path !== path);
        updatePendingChangesUi();
      };

      const syncPendingChanges = async () => {
        const uploads = [...state.pendingMedia.uploads];
        const mediaDeletes = [...state.pendingMedia.deletes];
        const remoteUploads = uploads.filter((item) => usesRemoteMedia(item));
        const remoteDeletes = mediaDeletes.filter((item) => usesRemoteMedia(item));
        const gitUploads = uploads.filter((item) => !usesRemoteMedia(item));
        const gitMediaDeletes = mediaDeletes.filter((item) => !usesRemoteMedia(item));
        const files = [...state.pendingChanges.files];
        const deletes = [...state.pendingChanges.deletes];
        if (!uploads.length && !mediaDeletes.length && !files.length && !deletes.length) throw new Error("暂无待同步操作");
        if (files.length || deletes.length || gitUploads.length || gitMediaDeletes.length) requireWriteAccess();
        if (remoteUploads.length || remoteDeletes.length) requireMediaAccess();

        const summaryParts = [];
        if (files.length) summaryParts.push("write " + files.length + " content files");
        if (deletes.length) summaryParts.push("delete " + deletes.length + " content files");
        if (uploads.length) summaryParts.push("upload " + uploads.length + " media files");
        if (mediaDeletes.length) summaryParts.push("delete " + mediaDeletes.length + " media files");
        const summary = summaryParts.join(", ");
        const commitNotice = files.length || deletes.length || gitUploads.length || gitMediaDeletes.length
          ? "这会在 GitHub main 分支生成 1 次 commit。"
          : "这次只有 R2 媒体操作，不会生成 Git commit。";
        if (!confirm("确定同步全部待处理改动吗？\n" + summary + "\n\n" + commitNotice)) return;

        if (remoteUploads.length || remoteDeletes.length) {
          setStatus("同步 R2 媒体文件中...");
          await syncRemoteMediaOperations({ uploads: remoteUploads, deletes: remoteDeletes });
        }

        if (!files.length && !deletes.length && !gitUploads.length && !gitMediaDeletes.length) {
          uploads.forEach((upload) => {
            if (upload.previewUrl) URL.revokeObjectURL(upload.previewUrl);
          });
          state.pendingMedia.uploads = [];
          state.pendingMedia.deletes = [];
          state.pendingMedia.selectedImages.clear();
          state.pendingMedia.selectedVideos.clear();
          await Promise.all([loadImages(), loadVideos()]);
          selectImage(null);
          selectVideo(null);
          updateCounts();
          renderList();
          updatePendingChangesUi();
          setStatus("R2 媒体操作已同步。");
          return;
        }

        setStatus("创建 GitHub 批量提交中...");
        const branchRef = await getBranchRef();
        const parentSha = branchRef.object.sha;
        const parentCommit = await getGitCommit(parentSha);
        const treeEntries = [];

        for (const file of files) {
          const blob = await createGitBlob({ content: toBase64(file.content) });
          treeEntries.push({
            path: file.path,
            mode: "100644",
            type: "blob",
            sha: blob.sha,
          });
        }
        for (const upload of gitUploads) {
          const blob = await createGitBlob({ content: upload.content });
          treeEntries.push({
            path: upload.path,
            mode: "100644",
            type: "blob",
            sha: blob.sha,
          });
        }
        for (const deleted of [...deletes, ...gitMediaDeletes]) {
          treeEntries.push({
            path: deleted.path,
            mode: "100644",
            type: "blob",
            sha: null,
          });
        }

        const tree = await createGitTree({
          baseTreeSha: parentCommit.tree.sha,
          tree: treeEntries,
        });
        const commit = await createGitCommit({
          message: `Sync site updates: ${summary}`,
          treeSha: tree.sha,
          parentSha,
        });
        await updateBranchRef(commit.sha);

        uploads.forEach((upload) => {
          if (upload.previewUrl) URL.revokeObjectURL(upload.previewUrl);
        });
        state.pendingMedia.uploads = [];
        state.pendingMedia.deletes = [];
        state.pendingMedia.selectedImages.clear();
        state.pendingMedia.selectedVideos.clear();
        state.pendingChanges.files = [];
        state.pendingChanges.deletes = [];
        await loadAll();
        selectImage(null);
        selectVideo(null);
        updatePendingChangesUi();
        setStatus("全部待处理改动已同步为 1 次 Git commit。");
      };

      const uploadImages = async (files, options = {}) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        if (!files.length) return [];
        const directory = options.directory || IMAGES_PATH;
        const publicRoot = options.publicRoot || "/images";
        const reloadAssets = options.reloadAssets ?? directory === IMAGES_PATH;
        validateMediaFiles(files, "image");
        setStatus(`上传 ${files.length} 张图片中...`);
        const uploaded = [];
        for (const file of files) {
          const image = await uploadMediaFile(file, directory, publicRoot);
          uploaded.push(image);
          if (reloadAssets) addUploadedAssetIfVisible(image);
        }
        updateCounts();
        renderList();
        if (reloadAssets) selectImage(uploaded.at(-1));
        setStatus("图片已暂存。确认无误后点“同步全部改动”一次提交。");
        return uploaded;
      };

      const uploadVideo = async (file, options = {}) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        validateMediaFile(file, "video");
        const directory = options.directory || VIDEOS_PATH;
        const publicRoot = options.publicRoot || "/videos";
        const reloadAssets = options.reloadAssets ?? directory === VIDEOS_PATH;
        setStatus("上传视频中...");
        const video = await uploadMediaFile(file, directory, publicRoot);
        if (reloadAssets) addUploadedAssetIfVisible(video);
        if (reloadAssets) {
          selectVideo(video);
          updateCounts();
          renderList();
        }
        setStatus("视频已暂存。确认无误后点“同步全部改动”一次提交。");
        return video;
      };

      const selectImage = (image) => {
        state.current.image = image;
        const preview = $("[data-selected-image-preview]");
        const empty = $("[data-selected-image-empty]");
        preview.hidden = !image?.publicPath;
        preview.classList.toggle("hidden", !image?.publicPath);
        empty.hidden = !!image?.publicPath;
        if (image?.publicPath) preview.src = assetPreviewUrl(image);
        else preview.removeAttribute("src");
        $("[data-selected-image-path]").value = image?.publicPath || "";
        renderList();
      };

      const selectVideo = (video) => {
        state.current.video = video;
        const preview = $("[data-selected-video-preview]");
        const empty = $("[data-selected-video-empty]");
        preview.hidden = !video?.publicPath;
        preview.classList.toggle("hidden", !video?.publicPath);
        empty.hidden = !!video?.publicPath;
        if (video?.publicPath) preview.src = assetPreviewUrl(video);
        else preview.removeAttribute("src");
        $("[data-selected-video-path]").value = video?.publicPath || "";
        renderList();
      };

      const queueMediaUploads = async (files, kind) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        if (!files.length) return;
        const isImage = kind === "image";
        const directory = isImage ? IMAGES_PATH : VIDEOS_PATH;
        const publicRoot = isImage ? "/images" : "/videos";
        const remote = mediaStorageMode() === "r2";
        validateMediaFiles(files, kind);
        setStatus("加入" + files.length + " 个" + (isImage ? "图片" : "视频") + "到待同步队列中...");
        for (const file of files) {
          const safeName = makeUploadName(file);
          const publicPath = publicRoot + "/" + safeName;
          const path = remote ? mediaKeyFromPublicPath(publicPath) : directory + "/" + safeName;
          state.pendingMedia.uploads.push({
            kind,
            name: safeName,
            path,
            key: mediaKeyFromPublicPath(publicPath),
            publicPath,
            ...(remote ? { file, remote: true } : { content: arrayBufferToBase64(await file.arrayBuffer()) }),
            previewUrl: URL.createObjectURL(file),
            pending: true,
          });
        }
        clearSelections(kind);
        const latest = state.pendingMedia.uploads.filter((item) => item.kind === kind).at(-1);
        if (isImage) selectImage(latest);
        else selectVideo(latest);
        updatePendingMediaUi();
        setStatus("已加入待同步队列。继续操作，最后点“同步待处理操作”即可一次提交。");
      };

      const queueMediaDeletes = (kind) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        const isImage = kind === "image";
        const assets = selectedAssets(kind);
        if (!assets.length) throw new Error("请先勾选要删除的" + (isImage ? "图片" : "视频"));
        const names = assets.map((asset) => asset.name || asset.publicPath).join("、");
        if (!confirm("确定把 " + assets.length + " 个" + (isImage ? "图片" : "视频") + "加入删除队列吗？\n" + names + "\n\n真正删除会在你点击“同步待处理操作”后发生。")) return;
        for (const asset of assets) {
          const pendingUploadIndex = state.pendingMedia.uploads.findIndex((item) => item.kind === kind && item.path === asset.path);
          if (pendingUploadIndex >= 0) {
            const [removed] = state.pendingMedia.uploads.splice(pendingUploadIndex, 1);
            if (removed.previewUrl) URL.revokeObjectURL(removed.previewUrl);
            continue;
          }
          if (!isPendingDelete(kind, asset.path)) {
            state.pendingMedia.deletes.push({
              kind,
              name: asset.name,
              path: asset.path,
              key: asset.key || mediaKeyFromPublicPath(asset.publicPath),
              publicPath: asset.publicPath,
              remote: usesRemoteMedia(asset),
            });
          }
        }
        clearSelections(kind);
        if (isImage && assets.some((asset) => asset.path === state.current.image?.path)) selectImage(null);
        if (!isImage && assets.some((asset) => asset.path === state.current.video?.path)) selectVideo(null);
        renderList();
        updatePendingMediaUi();
        setStatus("已加入删除队列。继续操作，最后点“同步待处理操作”即可一次提交。");
      };

      const syncPendingMedia = async () => {
        requireWriteAccess();
        const uploads = [...state.pendingMedia.uploads];
        const deletes = [...state.pendingMedia.deletes];
        if (!uploads.length && !deletes.length) throw new Error("暂无待同步操作");
        const summaryParts = [];
        const imageUploads = uploads.filter((item) => item.kind === "image").length;
        const videoUploads = uploads.filter((item) => item.kind === "video").length;
        const imageDeletes = deletes.filter((item) => item.kind === "image").length;
        const videoDeletes = deletes.filter((item) => item.kind === "video").length;
        if (imageUploads) summaryParts.push("add " + imageUploads + " images");
        if (videoUploads) summaryParts.push("add " + videoUploads + " videos");
        if (imageDeletes) summaryParts.push("delete " + imageDeletes + " images");
        if (videoDeletes) summaryParts.push("delete " + videoDeletes + " videos");
        const summary = summaryParts.join(", ");
        if (!confirm("确定同步待处理操作吗？\n" + summary + "\n\n这会在 GitHub main 分支生成 1 次 commit。")) return;

        setStatus("创建 GitHub 批量提交中...");
        const branchRef = await getBranchRef();
        const parentSha = branchRef.object.sha;
        const parentCommit = await getGitCommit(parentSha);
        const treeEntries = [];
        for (const upload of uploads) {
          const blob = await createGitBlob({ content: upload.content });
          treeEntries.push({
            path: upload.path,
            mode: "100644",
            type: "blob",
            sha: blob.sha,
          });
        }
        for (const deleted of deletes) {
          treeEntries.push({
            path: deleted.path,
            mode: "100644",
            type: "blob",
            sha: null,
          });
        }
        const tree = await createGitTree({
          baseTreeSha: parentCommit.tree.sha,
          tree: treeEntries,
        });
        const commit = await createGitCommit({
          message: `Sync media assets: ${summary}`,
          treeSha: tree.sha,
          parentSha,
        });
        await updateBranchRef(commit.sha);

        uploads.forEach((upload) => {
          if (upload.previewUrl) URL.revokeObjectURL(upload.previewUrl);
        });
        state.pendingMedia.uploads = [];
        state.pendingMedia.deletes = [];
        state.pendingMedia.selectedImages.clear();
        state.pendingMedia.selectedVideos.clear();
        await Promise.all([loadImages(), loadVideos()]);
        selectImage(null);
        selectVideo(null);
        updateCounts();
        renderList();
        setStatus("待处理媒体操作已同步为 1 次 Git commit。");
      };

      const deleteImage = async () => {
        requireWriteAccess();
        const image = state.current.image;
        if (!image?.path) throw new Error("请选择一张图片");
        if (!confirm(`确定删除图片「${image.name}」吗？如果文章或图集还在引用它，页面会显示破图。`)) return;
        const sha = image.sha || (await getFile(image.path)).sha;
        await deleteFile({ path: image.path, sha, message: `Delete image: ${image.name}` });
        state.current.image = null;
        await loadImages();
        updateCounts();
        selectImage(null);
        renderList();
        setStatus("图片已删除。");
      };

      const deleteVideo = async () => {
        requireWriteAccess();
        const video = state.current.video;
        if (!video?.path) throw new Error("请选择一个视频");
        if (!confirm(`确定删除视频「${video.name}」吗？如果文章或项目还在引用它，页面会显示无法播放。`)) return;
        const sha = video.sha || (await getFile(video.path)).sha;
        await deleteFile({ path: video.path, sha, message: `Delete video: ${video.name}` });
        state.current.video = null;
        await loadVideos();
        updateCounts();
        selectVideo(null);
        renderList();
        setStatus("视频已删除。");
      };

      const connect = async () => {
        const token = $("[data-token-input]").value.trim();
        const mediaToken = $("[data-media-token-input]").value.trim();
        if (!token && !mediaToken) return;
        state.token = token;
        state.mediaToken = mediaToken;
        state.mode = "github";
        sessionStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem(TOKEN_KEY);
        sessionStorage.removeItem(MEDIA_TOKEN_KEY);
        localStorage.removeItem(MEDIA_TOKEN_KEY);
        const storage = $("[data-remember-token]").checked ? localStorage : sessionStorage;
        if (token) storage.setItem(TOKEN_KEY, token);
        if (mediaToken) storage.setItem(MEDIA_TOKEN_KEY, mediaToken);
        await loadAll();
      };

      const clearToken = async () => {
        state.token = "";
        state.mediaToken = "";
        sessionStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem(TOKEN_KEY);
        sessionStorage.removeItem(MEDIA_TOKEN_KEY);
        localStorage.removeItem(MEDIA_TOKEN_KEY);
        $("[data-token-input]").value = "";
        $("[data-media-token-input]").value = "";
        state.mode = "readonly";
        await loadAll();
      };

      const run = async (task) => {
        try {
          await task();
        } catch (error) {
          setStatus(error.message || "操作失败");
        }
      };

      window.addEventListener("beforeunload", (event) => {
        if (!allPendingChanges().length) return;
        event.preventDefault();
        event.returnValue = "";
      });

      $$("[data-section]").forEach((button) => {
        button.addEventListener("click", () => selectSection(button.dataset.section));
      });

      $("[data-save-token]").addEventListener("click", () => run(connect));
      $("[data-token-input]").value = state.token;
      $("[data-media-token-input]").value = state.mediaToken;
      $("[data-auth-form]").addEventListener("submit", (event) => {
        event.preventDefault();
        run(connect);
      });
      $("[data-clear-token]").addEventListener("click", () => run(clearToken));
      $("[data-new-current]").addEventListener("click", () => {
        if (state.section === "posts") newPost();
        if (state.section === "projects") newProject();
        if (state.section === "recommendations") newRecommendation();
        if (state.section === "gallery") newGallery();
        if (state.section === "personalVideos") newPersonalVideo();
        if (state.section === "images") $("[data-image-file]").click();
        if (state.section === "videos") $("[data-video-file]").click();
        if (state.section === "settings") run(saveSettings);
      });

      $("[data-save-post]").addEventListener("click", () => run(savePost));
      $("[data-delete-post]").addEventListener("click", () => run(deletePost));
      $("[data-post-upload-cover]").addEventListener("click", () => $("[data-post-cover-file]").click());
      $("[data-post-cover-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file]);
          postFields.cover.value = image.publicPath;
        });
      });
      $("[data-post-upload-body-image]").addEventListener("click", () => $("[data-post-body-image-file]").click());
      $("[data-post-body-image-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file]);
          insertImageMarkdown(image);
          setStatus("图片已上传到素材图片库，并插入正文。");
        });
      });
      $("[data-post-upload-video]").addEventListener("click", () => $("[data-post-video-file]").click());
      $("[data-post-video-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const video = await uploadVideo(file);
          insertVideoHtml(video);
          setStatus("视频已上传到 videos，并插入正文。");
        });
      });
      $("[data-post-insert-selected-image]").addEventListener("click", () =>
        run(async () => {
          insertImageMarkdown(state.current.image);
          setStatus("已把选中的素材图片插入正文。");
        }),
      );

      $("[data-save-project]").addEventListener("click", () => run(saveProject));
      $("[data-delete-project]").addEventListener("click", () => run(deleteProject));

      $("[data-save-recommendation]").addEventListener("click", () => run(saveRecommendation));
      $("[data-delete-recommendation]").addEventListener("click", () => run(deleteRecommendation));
      $("[data-recommendation-upload-image]").addEventListener("click", () => $("[data-recommendation-image-file]").click());
      $("[data-recommendation-image-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file]);
          recommendationFields.image.value = image.publicPath;
          renderRecommendationPreview();
          setStatus("推荐封面已上传到素材图片库。");
        });
      });
      $("[data-recommendation-use-selected-image]").addEventListener("click", () =>
        run(async () => {
          if (!state.current.image?.publicPath) throw new Error("请先在素材图片库选择一张图片");
          recommendationFields.image.value = state.current.image.publicPath;
          renderRecommendationPreview();
          setStatus("已把选中的素材图片设为推荐封面。");
        }),
      );

      $("[data-save-gallery]").addEventListener("click", () => run(saveGallery));
      $("[data-delete-gallery]").addEventListener("click", () => run(deleteGallery));
      $("[data-gallery-upload-image]").addEventListener("click", () => $("[data-gallery-image-file]").click());
      $("[data-gallery-image-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file], {
            directory: PERSONAL_PHOTO_PATH,
            publicRoot: "/personal-photo",
            reloadAssets: false,
          });
          galleryFields.image.value = image.publicPath;
          renderGalleryPreview();
          setStatus("PersonalPhoto 已上传，请补充标题和描述后保存照片。");
        });
      });

      $("[data-save-personal-video]").addEventListener("click", () => run(savePersonalVideo));
      $("[data-delete-personal-video]").addEventListener("click", () => run(deletePersonalVideo));
      $("[data-personal-video-upload]").addEventListener("click", () => $("[data-personal-video-file]").click());
      $("[data-personal-video-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const video = await uploadVideo(file, {
            directory: PERSONAL_VIDEO_PATH,
            publicRoot: "/personal-video",
            reloadAssets: false,
          });
          personalVideoFields.video.value = video.publicPath;
          renderPersonalVideoPreview();
          setStatus("PersonalVideo 已上传，请补充标题和描述后保存视频。");
        });
      });
      $("[data-personal-video-poster-upload]").addEventListener("click", () => $("[data-personal-video-poster-file]").click());
      $("[data-personal-video-poster-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file]);
          personalVideoFields.poster.value = image.publicPath;
          renderPersonalVideoPreview();
          setStatus("视频封面图已上传到素材图片库。");
        });
      });

      $("[data-upload-image]").addEventListener("click", () => $("[data-image-file]").click());
      $("[data-image-file]").addEventListener("change", (event) =>
        run(async () => {
          await queueMediaUploads(Array.from(event.target.files || []), "image");
          event.target.value = "";
        }),
      );
      $("[data-delete-image]").addEventListener("click", () => run(() => queueMediaDeletes("image")));

      $("[data-upload-video]").addEventListener("click", () => $("[data-video-file]").click());
      $("[data-video-file]").addEventListener("change", (event) => {
        const files = Array.from(event.target.files || []);
        run(async () => {
          await queueMediaUploads(files, "video");
          event.target.value = "";
        });
      });
      $("[data-insert-selected-video]").addEventListener("click", () =>
        run(async () => {
          insertVideoHtml(state.current.video);
          setStatus("已把选中的素材视频插入正文。");
          selectSection("posts");
        }),
      );
      $("[data-delete-video]").addEventListener("click", () => run(() => queueMediaDeletes("video")));
      $$("[data-sync-media]").forEach((button) => button.addEventListener("click", () => run(syncPendingChanges)));
      $("[data-sync-all]").addEventListener("click", () => run(syncPendingChanges));
      $("[data-save-settings]").addEventListener("click", () => run(saveSettings));
      $("[data-use-selected-hero-background]").addEventListener("click", () => {
        const field = $('[data-settings-field="home.heroBackgroundImage"]');
        if (!state.current.image?.publicPath) {
          setStatus("请先在素材图片库中选择一张背景图。");
          return;
        }
        field.value = state.current.image.publicPath;
        setStatus("已把选中图片填入首页背景图路径，保存页面配置后生效。");
      });

      Object.values(postFields).forEach((field) => field.addEventListener("input", renderMarkdownPreview));
      Object.values(recommendationFields).forEach((field) => field.addEventListener("input", renderRecommendationPreview));
      Object.values(galleryFields).forEach((field) => field.addEventListener("input", renderGalleryPreview));
      Object.values(personalVideoFields).forEach((field) => field.addEventListener("input", renderPersonalVideoPreview));

      updateCounts();
      selectSection("posts");
      newPost();
      newProject();
      newRecommendation();
      newGallery();
      newPersonalVideo();
      updatePendingChangesUi();

      const initialize = async () => {
        if (state.token) $("[data-token-input]").value = state.token;
        await detectLocalApi();
        await loadAll();
      };

      run(initialize);
    </script>
  </body>
</html>
