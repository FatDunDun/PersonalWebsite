---
import "@/styles/global.css";
import { galleryItems } from "@/data/gallery";
import { projects } from "@/data/projects";
import { getCollection } from "astro:content";
import { readdirSync } from "node:fs";

const posts = await getCollection("posts");
const imageNames = readdirSync(new URL("../../../public/images/", import.meta.url)).filter((name) => /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(name));

const initialData = {
  posts: posts
    .map((post) => ({
      name: `${post.id}.mdx`,
      path: `src/content/posts/${post.id}.mdx`,
      data: post.data,
      body: post.body || "",
    }))
    .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()),
  projects,
  gallery: galleryItems,
  images: imageNames.sort((a, b) => a.localeCompare(b)).map((name) => ({
    name,
    path: `public/images/${name}`,
    publicPath: `/images/${name}`,
  })),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Silent Orbit</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23171717'/%3E%3Cpath d='M10 17h12M16 10v12' stroke='white' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E" />
    <style>
      .orbit-shell {
        background:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px),
          var(--background);
        background-size: 80px 80px;
      }

      .orbit-panel {
        border: 1px solid var(--line);
        background: color-mix(in srgb, var(--surface) 92%, transparent);
        box-shadow: 0 24px 80px rgb(0 0 0 / 0.08);
      }

      .orbit-input {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--background);
        padding: 0.72rem 0.82rem;
        color: var(--foreground);
        outline: none;
      }

      .orbit-input:focus {
        border-color: var(--accent);
      }

      .orbit-button {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.62rem 0.9rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
      }

      .orbit-button:hover,
      .orbit-button[data-active="true"] {
        border-color: var(--foreground);
      }

      .orbit-button-primary {
        border-color: var(--foreground);
        background: var(--foreground);
        color: var(--background);
      }

      .orbit-danger {
        border-color: color-mix(in srgb, #dc2626 36%, var(--line));
        color: #dc2626;
      }

      .orbit-danger:hover {
        border-color: #dc2626;
      }

      .orbit-card {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--background);
      }

      .orbit-card[data-active="true"] {
        border-color: var(--foreground);
      }

      .orbit-view[hidden] {
        display: none;
      }

      .orbit-list {
        scrollbar-width: thin;
      }
    </style>
  </head>
  <body class="orbit-shell min-h-screen text-[var(--foreground)]">
    <main class="mx-auto flex min-h-screen w-[min(1440px,calc(100%-1.5rem))] flex-col gap-4 py-4 md:w-[min(1440px,calc(100%-2rem))] md:py-6">
      <header class="orbit-panel rounded-xl p-4">
        <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.26em] text-[var(--accent)]">Silent Orbit</p>
            <h1 class="mt-2 text-3xl font-semibold tracking-normal md:text-5xl">内容工作台</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">
              文章、项目、图集和图片统一在这里维护。保存动作会直接提交到 GitHub main 分支并触发 Pages 部署。
            </p>
          </div>

          <form class="grid gap-3 lg:min-w-[560px] lg:grid-cols-[1fr_auto] lg:items-end" data-auth-form>
            <label class="block">
              <span class="font-mono text-xs text-[var(--muted)]">GitHub Token</span>
              <input
                class="orbit-input mt-2 font-mono text-sm"
                data-token-input
                type="password"
                autocomplete="off"
                placeholder="github_pat_..."
              />
            </label>
            <div class="flex flex-wrap items-center gap-2">
              <label class="flex items-center gap-2 text-sm text-[var(--muted)]">
                <input data-remember-token type="checkbox" />
                记住
              </label>
              <button class="orbit-button orbit-button-primary" data-save-token type="button">connect</button>
              <button class="orbit-button" data-clear-token type="button">clear</button>
            </div>
          </form>
        </div>
      </header>

      <div class="grid flex-1 gap-4 xl:grid-cols-[240px_360px_1fr]">
        <aside class="orbit-panel rounded-xl p-3">
          <nav class="grid gap-2">
            <button class="orbit-button flex items-center justify-between text-left" data-section="posts" data-active="true" type="button">
              <span>文章</span>
              <span class="text-[var(--muted)]" data-count="posts">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="projects" type="button">
              <span>项目</span>
              <span class="text-[var(--muted)]" data-count="projects">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="gallery" type="button">
              <span>图集</span>
              <span class="text-[var(--muted)]" data-count="gallery">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="images" type="button">
              <span>图片库</span>
              <span class="text-[var(--muted)]" data-count="images">0</span>
            </button>
          </nav>

          <section class="mt-4 rounded-lg border border-[var(--line)] bg-[var(--background)] p-3">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--muted)]">Status</p>
            <p class="mt-3 min-h-12 text-sm leading-6 text-[var(--muted)]" data-status>正在读取公开内容。</p>
          </section>

          <section class="mt-4 rounded-lg border border-[var(--line)] bg-[var(--background)] p-3">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--muted)]">Publish</p>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
              每次保存都会成为一次 Git commit。GitHub Actions 会自动重新部署网站。
            </p>
          </section>
        </aside>

        <section class="orbit-panel rounded-xl p-3">
          <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--muted)]" data-list-kicker>Posts</p>
