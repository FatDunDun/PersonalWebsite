            <p class="text-sm text-[var(--muted)]">连接后加载内容。</p>
          </div>
        </section>

        <section class="orbit-panel rounded-xl p-4">
          <section class="orbit-view" data-view="posts">
            <div class="flex flex-col gap-3 border-b border-[var(--line)] pb-4 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">Post Editor</p>
                <h2 class="mt-1 text-2xl font-semibold" data-post-title>新建文章</h2>
              </div>
              <div class="flex flex-wrap gap-2">
                <button class="orbit-button" data-post-upload-cover type="button">上传封面</button>
                <button class="orbit-button orbit-button-primary" data-save-post type="button">保存文章</button>
