---
import { getCollection } from "astro:content";
import AnniversaryTimer from "@/components/AnniversaryTimer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { galleryItems } from "@/data/gallery";
import { projects } from "@/data/projects";
import { recommendations } from "@/data/recommendations";
import { formatDate } from "@/utils/format";
import { assetUrl, homeConfig, siteConfig, withBase } from "@/utils/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const personalPhotoItems = galleryItems.filter((item) => item.image.startsWith("/personal-photo/"));
const featuredFrames = personalPhotoItems.slice(0, 3);
const isExternalLink = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="home-motion" data-home-motion>
  <section class="relative min-h-[calc(100svh-5rem)] overflow-hidden pb-16 pt-8 md:pb-24 md:pt-12">
    <div class="exhibition-line hidden md:block"></div>

    <div class="container grid min-h-[calc(100svh-9rem)] gap-10 md:grid-cols-[1.08fr_0.92fr] md:items-center">
      <div class="reveal-up">
        <p class="exhibition-kicker">{homeConfig.badge}</p>
        <h1 class="editorial-title mt-8 max-w-4xl text-6xl leading-[1.02] text-[var(--foreground)] md:text-8xl">
          {homeConfig.headline}
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-9 text-[var(--muted)] md:text-xl">
          {homeConfig.intro}
        </p>
      </div>

      <aside class="exhibition-panel exhibition-panel-float rounded-[2rem] p-6 md:p-7">
        <div class="flex items-center justify-between border-b border-[var(--line)] pb-4">
          <p class="exhibition-meta text-xs uppercase tracking-[0.28em]">live interface layer</p>
          <span class="size-2 rounded-full bg-[var(--accent-warm)] shadow-[0_0_24px_var(--accent-warm)]"></span>
        </div>

        <div class="grid gap-5 py-6 font-mono text-lg">
          <a href={withBase("/articles/")} class="group flex items-center justify-between gap-4">
            <span>01 Writing</span>
            <span class="text-sm text-[var(--muted)] transition group-hover:text-[var(--foreground)]">{posts.length} notes</span>
          </a>
          <a href={withBase("/projects/")} class="group flex items-center justify-between gap-4">
            <span>02 Works</span>
            <span class="text-sm text-[var(--muted)] transition group-hover:text-[var(--foreground)]">{projects.length} objects</span>
          </a>
          <a href={withBase("/gallery/")} class="group flex items-center justify-between gap-4">
            <span>03 Frames</span>
            <span class="text-sm text-[var(--muted)] transition group-hover:text-[var(--foreground)]">{personalPhotoItems.length} images</span>
          </a>
        </div>

        <div class="border-t border-[var(--line)] pt-5">
          <p class="exhibition-meta text-xs uppercase tracking-[0.22em]">{homeConfig.codePath}</p>
          <div class="mt-4 space-y-3 font-mono text-sm leading-6">
            {homeConfig.codeLines.map((line) => (
              <p>
                <span class="text-[var(--muted)]">{line.label}</span>
                <span class="text-[var(--muted)]"> · </span>
                <span class="text-[var(--foreground)]">{line.value}</span>
              </p>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="container grid gap-4 pb-12 md:grid-cols-[0.76fr_1.24fr] md:pb-20">
    <div class="exhibition-panel rounded-[2rem] p-6 md:p-8">
      <p class="exhibition-kicker">{homeConfig.marginKicker}</p>
      <p class="literary-title mt-6 text-3xl leading-snug md:text-4xl">{homeConfig.marginTitle}</p>
      <p class="mt-5 leading-8 text-[var(--muted)]">{homeConfig.marginDescription}</p>
    </div>
    <div class="exhibition-panel rounded-[2rem] p-4 md:p-5">
      <AnniversaryTimer />
    </div>
  </section>

  <section class="container pb-12 md:pb-20">
    <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="exhibition-kicker">Frames / captured light</p>
        <h2 class="literary-title mt-3 text-4xl md:text-5xl">给时间留几张切片</h2>
      </div>
      <a href={withBase("/gallery/")} class="exhibition-meta text-sm">view gallery</a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {featuredFrames.map((item, index) => (
        <a href={withBase("/gallery/")} class="group block reveal-up">
          <figure class="quiet-card overflow-hidden rounded-[1.5rem] p-2">
            <img
              class="aspect-[16/11] w-full rounded-[1.1rem] object-cover transition duration-700 group-hover:scale-[1.035] group-hover:saturate-110"
              src={assetUrl(item.image)}
              alt={item.title}
            />
          </figure>
          <div class="mt-3 flex items-start justify-between gap-4 px-1">
            <div>
              <h3 class="font-semibold">{item.title}</h3>
              <p class="mt-1 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
            <span class="exhibition-meta text-xs">0{index + 1}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container pb-12 md:pb-20">
    <div class="exhibition-panel rounded-[2rem] p-5 md:p-8">
      <div class="mb-4 flex items-end justify-between gap-4">
        <div>
          <p class="exhibition-kicker">Journal / field notes</p>
          <h2 class="literary-title mt-3 text-4xl md:text-5xl">最近写下的想法</h2>
        </div>
        <a href={withBase("/articles/")} class="exhibition-meta text-sm">all essays</a>
      </div>
      <div class="divide-y divide-[var(--line)]">
        {posts.map((post) => (
          <a href={withBase("/articles/" + post.id + "/")} class="group grid gap-5 py-6 transition md:grid-cols-[160px_1fr_auto] md:items-center">
            {post.data.cover && <img class="aspect-[4/3] w-full rounded-2xl object-cover md:h-28" src={assetUrl(post.data.cover)} alt="" />}
            <div>
              <p class="text-sm text-[var(--muted)]">{formatDate(post.data.publishDate)}</p>
              <h3 class="literary-title mt-2 text-2xl leading-snug group-hover:text-[var(--accent)]">{post.data.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">{post.data.description}</p>
            </div>
            <span class="exhibition-meta text-sm">read</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container grid gap-4 pb-12 md:grid-cols-[0.82fr_1.18fr] md:pb-20">
    <div class="exhibition-panel rounded-[2rem] p-6 md:p-8">
      <p class="exhibition-kicker">Works / small machines</p>
      <h2 class="literary-title mt-3 text-4xl md:text-5xl">把想法做成工具</h2>
    </div>
    <div class="grid gap-4">
      {projects.slice(0, 3).map((project, index) => {
        const external = isExternalLink(project.link);
        return (
          <a
            href={project.link}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="artifact-card group grid gap-4 rounded-[1.5rem] p-5 transition hover:-translate-y-1 hover:border-[var(--foreground)] md:grid-cols-[72px_1fr_auto] md:items-center"
          >
            <div class="folio-number text-3xl">{String(index + 1).padStart(2, "0")}</div>
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="literary-title text-2xl">{project.name}</h3>
                <span class="exhibition-meta text-xs">{project.year}</span>
              </div>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">{project.description}</p>
            </div>
            <span class="exhibition-meta text-sm">open</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container pb-16 md:pb-24">
    <div class="exhibition-panel rounded-[2rem] p-5 md:p-8">
      <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="exhibition-kicker">Taste / private index</p>
          <h2 class="literary-title mt-3 text-4xl md:text-5xl">最近偏爱的事物</h2>
        </div>
        <a href={withBase("/recommendations/")} class="exhibition-meta text-sm">view taste</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {recommendations.slice(0, 2).map((item) => (
          <a href={withBase("/recommendations/")} class="quiet-card group grid grid-cols-[96px_1fr] gap-4 rounded-[1.5rem] p-2 transition hover:border-[var(--foreground)]">
            {item.image && <img class="aspect-[4/5] w-full rounded-[1.1rem] object-cover" src={assetUrl(item.image)} alt={item.title} loading="lazy" />}
            <div class="py-2 pr-2">
              <p class="exhibition-meta text-xs uppercase tracking-[0.2em]">{item.category}</p>
              <h3 class="mt-2 text-lg font-semibold leading-tight group-hover:text-[var(--accent)]">{item.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  </div>

  <script>
    const homeMotion = document.querySelector<HTMLElement>("[data-home-motion]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (homeMotion && !reduceMotion.matches) {
      let pointerFrame = 0;

      const updateHomeLight = (event: PointerEvent) => {
        window.cancelAnimationFrame(pointerFrame);
        pointerFrame = window.requestAnimationFrame(() => {
          const x = (event.clientX / window.innerWidth) * 100;
          const y = (event.clientY / window.innerHeight) * 100;

          homeMotion.style.setProperty("--home-x", Math.min(100, Math.max(0, x)).toFixed(2) + "%");
          homeMotion.style.setProperty("--home-y", Math.min(100, Math.max(0, y)).toFixed(2) + "%");
        });
      };

      window.addEventListener("pointermove", updateHomeLight, { passive: true });

      const motionCards = Array.from(
        homeMotion.querySelectorAll<HTMLElement>(".exhibition-panel, .quiet-card, .artifact-card"),
      );

      for (const card of motionCards) {
        if (card.querySelector("[data-anniversary]")) continue;

        let cardFrame = 0;

        const resetCard = () => {
          card.style.setProperty("--card-x", "50%");
          card.style.setProperty("--card-y", "50%");
          card.style.setProperty("--card-tilt-x", "0deg");
          card.style.setProperty("--card-tilt-y", "0deg");
          card.style.setProperty("--card-lift", "0px");
        };

        const moveCard = (event: PointerEvent) => {
          window.cancelAnimationFrame(cardFrame);
          cardFrame = window.requestAnimationFrame(() => {
            const rect = card.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width) * 100;
            const y = ((event.clientY - rect.top) / rect.height) * 100;
            const clampedX = Math.min(100, Math.max(0, x));
            const clampedY = Math.min(100, Math.max(0, y));

            card.style.setProperty("--card-x", clampedX.toFixed(2) + "%");
            card.style.setProperty("--card-y", clampedY.toFixed(2) + "%");
            card.style.setProperty("--card-tilt-x", ((clampedX - 50) * 0.018).toFixed(3) + "deg");
            card.style.setProperty("--card-tilt-y", ((50 - clampedY) * 0.012).toFixed(3) + "deg");
            card.style.setProperty("--card-lift", "-3px");
          });
        };

        card.addEventListener("pointermove", moveCard, { passive: true });
        card.addEventListener("pointerleave", resetCard);
      }

      const revealItems = Array.from(
        homeMotion.querySelectorAll<HTMLElement>("section, .exhibition-panel, .quiet-card, .artifact-card"),
      );

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-inview");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.14 },
      );

      revealItems.forEach((item, index) => {
        item.classList.add("motion-reveal");
        item.style.setProperty("--reveal-delay", String(Math.min(index * 34, 220)) + "ms");
        observer.observe(item);
      });
    }
  </script>
</BaseLayout>
