---
import { getCollection, render } from "astro:content";
import WalineComments from "@/components/WalineComments.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/utils/format";
import { withBase } from "@/utils/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} type="article">
  <article class="container py-8 md:py-12">
    <header class="grid gap-8 border-b border-[var(--line)] pb-8 md:grid-cols-[0.78fr_1.22fr] md:items-end">
      <div class="flex flex-wrap gap-2 font-mono text-sm text-[var(--muted)] md:block">
        <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
        <div class="mt-3 flex flex-wrap gap-2 md:flex-col">
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
      <div>
        <h1 class="text-4xl font-semibold leading-tight md:text-7xl">{post.data.title}</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">{post.data.description}</p>
      </div>
    </header>

    {post.data.cover && (
      <img class="mt-10 aspect-[16/9] w-full rounded-md border border-[var(--line)] object-cover photo-shadow" src={withBase(post.data.cover)} alt="" />
    )}

    <div class="prose mx-auto mt-12 max-w-3xl">
      <Content />
      <WalineComments pageId={post.id} />
    </div>
  </article>
</BaseLayout>
