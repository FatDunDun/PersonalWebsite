---
interface Props {
  pageId: string;
}

// Frozen comment presentation for the warm editorial B preset.
const { pageId } = Astro.props;
const serverURL = import.meta.env.PUBLIC_WALINE_SERVER_URL;
const enabled = Boolean(serverURL);
const commentPath = `/articles/${pageId}/`;
---

<section class="comments-section mt-14 border-t border-[var(--line)] pt-10">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <p class="page-kicker">Comments / responses</p>
      <h2 class="literary-title mt-2 text-2xl">留言区</h2>
    </div>
  </div>

  {
    enabled ? (
      <div class="comments-card artifact-card p-4">
        <div
          id="waline-thread"
          data-server-url={serverURL}
          data-path={commentPath}
          data-waline-lazy
          class="min-h-28"
        >
          <button class="comments-load-button story-button story-button--secondary font-mono text-sm" data-waline-load type="button">
            加载留言
          </button>
          <p class="mt-3 text-sm leading-6 text-[var(--muted)]">滚动到这里时会自动加载评论，减少文章首屏的外部资源请求。</p>
        </div>
      </div>
    ) : (
      <div class="comments-card artifact-card border-dashed p-5 text-sm leading-6 text-[var(--muted)]">
        留言区已切换为 Waline。部署 Waline 服务并配置 PUBLIC_WALINE_SERVER_URL 后，访客可以用昵称留言、发送表情和参与文章反应。
      </div>
    )
  }
</section>

{
  enabled && (
    <script type="module" is:inline>
      const container = document.querySelector("#waline-thread");
      let hasLoaded = false;

      const loadWalineStyles = () => {
        if (document.querySelector("link[data-waline-style]")) return;
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "https://unpkg.com/@waline/client@v3/dist/waline.css";
        link.dataset.walineStyle = "true";
        document.head.append(link);
      };

      const loadWaline = async () => {
        if (!container || hasLoaded) return;
        hasLoaded = true;
        container.innerHTML = '<p class="font-mono text-sm text-[var(--muted)]">Loading comments...</p>';
        loadWalineStyles();
        const { init } = await import("https://unpkg.com/@waline/client@v3/dist/waline.js");
        container.innerHTML = "";
        init({
          el: container,
          serverURL: container.dataset.serverUrl,
          path: container.dataset.path,
          lang: "zh-CN",
          dark: "html.dark",
          login: "disable",
          meta: ["nick", "mail", "link"],
          requiredMeta: ["nick"],
          commentSorting: "latest",
          pageSize: 10,
          reaction: true,
          imageUploader: false,
          search: false,
        });
      };

      container?.querySelector("[data-waline-load]")?.addEventListener("click", loadWaline);

      if (container && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            loadWaline();
          },
          { rootMargin: "240px 0px" },
        );
        observer.observe(container);
      } else {
        loadWaline();
      }
    </script>
  )
}
