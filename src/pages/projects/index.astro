---
import { projects } from "@/data/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="项目" description="个人项目、实验和作品集合。">
  <section class="container py-12 md:py-18">
    <div class="grid gap-8 border-b border-[var(--line)] pb-10 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Works</p>
        <h1 class="mt-4 text-5xl font-semibold leading-none md:text-7xl">项目</h1>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-[var(--muted)]">
        已完成或正在迭代的数字实验。这里更偏向功能、系统和可复用的小工具。
      </p>
    </div>

    <div class="divide-y divide-[var(--line)]">
      {projects.map((project, index) => (
        <a href={project.link} class="group grid gap-5 py-8 transition hover:text-[var(--accent)] md:grid-cols-[120px_1fr_auto] md:items-center">
          <div class="font-mono text-5xl font-semibold text-[var(--muted)]">{String(index + 1).padStart(2, "0")}</div>
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-3xl font-semibold">{project.name}</h2>
              <span class="font-mono text-sm text-[var(--muted)]">{project.year}</span>
            </div>
            <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{project.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => <span class="rounded border border-[var(--line)] bg-[var(--surface)] px-2 py-1 font-mono text-xs text-[var(--muted)]">{tag}</span>)}
            </div>
          </div>
          <span class="font-mono text-sm text-[var(--accent)]">open</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
