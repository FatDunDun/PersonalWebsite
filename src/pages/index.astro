---
import { getCollection } from "astro:content";
import AnniversaryTimer from "@/components/AnniversaryTimer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { galleryItems } from "@/data/gallery";
import { projects } from "@/data/projects";
import { recommendations } from "@/data/recommendations";
import { formatDate } from "@/utils/format";
import { homeConfig, siteConfig, withBase } from "@/utils/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const personalPhotoItems = galleryItems.filter((item) => item.image.startsWith("/personal-photo/"));
const featuredFrames = personalPhotoItems.slice(0, 3);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="container grid min-h-[calc(100svh-3.5rem)] gap-10 py-14 md:grid-cols-[72px_1.05fr_0.95fr] md:items-center md:py-20">
    <aside class="archive-mark hidden self-stretch rounded-md px-4 py-5 font-mono text-xs uppercase tracking-[0.28em] text-[var(--muted)] md:flex md:items-center md:justify-between">
      <span>Mic / Archive</span>
      <span>2026</span>
    </aside>

    <div>
      <div class="inline-flex items-center gap-2 rounded-md border border-[var(--line)] bg-[var(--surface)] px-3 py-1.5 font-mono text-xs text-[var(--muted)] shadow-sm">
        <span class="size-2 rounded-full bg-[var(--accent-warm)]"></span>
        {homeConfig.badge}
      </div>
      <h1 class="editorial-title mt-8 max-w-4xl text-6xl leading-[1.02] tracking-normal md:text-8xl">
        {homeConfig.headline}
      </h1>
      <p class="note-rule mt-6 max-w-2xl text-lg leading-8 text-[var(--muted)]">
        {homeConfig.intro}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase(homeConfig.primaryButton.href)} class="inverse-control rounded-md px-4 py-2.5 font-mono text-sm transition">
          {homeConfig.primaryButton.label}
        </a>
        <a href={withBase(homeConfig.secondaryButton.href)} class="rounded-md border border-[var(--line)] bg-[var(--surface)] px-4 py-2.5 font-mono text-sm text-[var(--foreground)] transition hover:border-[var(--foreground)]">
          {homeConfig.secondaryButton.label}
        </a>
      </div>
    </div>

    <div class="grid gap-4">
      <div class="quiet-card ink-panel rounded-md p-5">
        <div class="flex items-center justify-between border-b border-[var(--line)] pb-3 font-mono text-xs text-[var(--muted)]">
          <span>{homeConfig.codePath}</span>
          <span>{homeConfig.codeFile}</span>
        </div>
        <div class="space-y-3 pt-4 font-mono text-sm">
          {homeConfig.codeLines.map((line) => (
            <p><span class="text-[var(--muted)]">{line.label}</span>: <span class="text-[var(--accent)]">{line.value}</span></p>
          ))}
        </div>
      </div>
      <div class="quiet-card rounded-md p-6">
        <div class="flex items-start justify-between gap-4">
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">{homeConfig.marginKicker}</p>
          <span class="font-mono text-xs text-[var(--muted)]">{homeConfig.marginNumber}</span>
        </div>
        <p class="literary-title mt-4 text-3xl leading-snug">
          {homeConfig.marginTitle}
        </p>
        <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
          {homeConfig.marginDescription}
        </p>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div class="quiet-card rounded-md p-4">
          <p class="font-mono text-xs text-[var(--muted)]">NOTES</p>
          <p class="mt-2 text-3xl font-semibold">{posts.length}</p>
        </div>
        <div class="quiet-card rounded-md p-4">
          <p class="font-mono text-xs text-[var(--muted)]">FRAMES</p>
          <p class="mt-2 text-3xl font-semibold">{personalPhotoItems.length}</p>
        </div>
        <div class="quiet-card rounded-md p-4">
          <p class="font-mono text-xs text-[var(--muted)]">LIKES</p>
          <p class="mt-2 text-3xl font-semibold">{recommendations.length}</p>
        </div>
      </div>
      <AnniversaryTimer />
    </div>
  </section>

  <section class="container border-t border-[var(--line)] py-14 md:py-18">
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Frames / captured light</p>
        <h2 class="literary-title mt-3 text-3xl md:text-4xl">给时间留几张切片</h2>
      </div>
      <a href={withBase("/gallery/")} class="font-mono text-sm text-[var(--accent)]">进入图集</a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {featuredFrames.map((item, index) => (
        <a href={withBase("/gallery/")} class="group block">
          <figure class="quiet-card overflow-hidden rounded-md p-1">
            <img
              class:list={[
                "aspect-[16/11] w-full object-cover transition duration-500 group-hover:scale-[1.02] group-hover:saturate-110",
              ]}
              src={withBase(item.image)}
              alt={item.title}
            />
          </figure>
          <div class="mt-3 flex items-start justify-between gap-4 border-t border-[var(--line)] pt-3">
            <div>
              <h3 class="font-semibold">{item.title}</h3>
              <p class="mt-1 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
            <span class="font-mono text-xs text-[var(--muted)]">0{index + 1}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-[var(--line)] bg-[var(--surface)]/68 py-14 md:py-18">
    <div class="container">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Journal / field notes</p>
          <h2 class="literary-title mt-3 text-3xl md:text-4xl">最近写下的想法</h2>
        </div>
        <a href={withBase("/articles/")} class="font-mono text-sm text-[var(--accent)]">全部文章</a>
      </div>
      <div class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
        {posts.map((post) => (
          <a href={withBase(`/articles/${post.id}/`)} class="group grid gap-5 py-6 transition md:grid-cols-[180px_1fr_auto] md:items-center">
            {post.data.cover && <img class="aspect-[4/3] w-full object-cover md:h-28" src={withBase(post.data.cover)} alt="" />}
            <div>
              <p class="text-sm text-[var(--muted)]">{formatDate(post.data.publishDate)}</p>
              <h3 class="mt-2 text-2xl font-semibold leading-snug group-hover:text-[var(--accent)]">{post.data.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">{post.data.description}</p>
            </div>
            <span class="font-mono text-sm text-[var(--accent)]">read</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container py-14 md:py-20">
    <div class="grid gap-8 md:grid-cols-[0.82fr_1.18fr]">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Works / small machines</p>
        <h2 class="literary-title mt-3 text-3xl md:text-4xl">把想法做成工具</h2>
      </div>
      <div class="grid gap-0 border-t border-[var(--line)]">
        {projects.slice(0, 2).map((project) => (
          <a href={project.link} class="border-b border-[var(--line)] py-6 transition hover:text-[var(--accent)]">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-semibold">{project.name}</h3>
              <span class="text-sm text-[var(--muted)]">{project.year}</span>
            </div>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{project.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container border-t border-[var(--line)] py-14 md:py-20">
    <div class="grid gap-8 md:grid-cols-[0.82fr_1.18fr]">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Taste / private index</p>
        <h2 class="literary-title mt-3 text-3xl md:text-4xl">最近偏爱的事物</h2>
        <a href={withBase("/recommendations/")} class="mt-4 inline-block font-mono text-sm text-[var(--accent)]">查看全部</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {recommendations.slice(0, 2).map((item) => (
          <a href={withBase("/recommendations/")} class="quiet-card group grid grid-cols-[96px_1fr] gap-4 rounded-md p-2 transition hover:border-[var(--foreground)]">
            {item.image && <img class="aspect-[4/5] w-full rounded border border-[var(--line)] object-cover" src={withBase(item.image)} alt={item.title} loading="lazy" />}
            <div class="py-2 pr-2">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">{item.category}</p>
              <h3 class="mt-2 text-lg font-semibold leading-tight group-hover:text-[var(--accent)]">{item.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
