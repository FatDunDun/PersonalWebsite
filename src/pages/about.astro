---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { assetUrl, pageConfig } from "@/utils/site";

const pageCopy = pageConfig.about;
const profileImage = pageCopy.image || "/personal-photo/gallery-workspace.png";
const profileImageAlt = pageCopy.imageAlt || pageCopy.title;
const summary = Array.isArray(pageCopy.summary) && pageCopy.summary.length ? pageCopy.summary : [pageCopy.description].filter(Boolean);
const focus = Array.isArray(pageCopy.focus) ? pageCopy.focus.filter(Boolean) : [];
const links = Array.isArray(pageCopy.links) ? pageCopy.links.filter((item) => item?.label && item?.href) : [];
const facts = [
  { label: "角色", value: pageCopy.role },
  { label: "公司", value: pageCopy.company },
  { label: "邮箱", value: pageCopy.email, href: pageCopy.email ? `mailto:${pageCopy.email}` : "" },
  { label: "所在地", value: pageCopy.location },
].filter((item) => item.value);
---

<BaseLayout title={pageCopy.title} description={pageCopy.description}>
  <section class="container grid gap-10 py-12 md:grid-cols-[0.9fr_1.1fr] md:py-18">
    <aside>
      <div class="sticky top-28">
        <div class="artifact-card rounded-md p-2">
          <img class="aspect-[4/5] w-full rounded border border-[var(--line)] object-cover photo-shadow" src={assetUrl(profileImage)} alt={profileImageAlt} />
        </div>
        <div class="mt-5 page-hero pb-6">
          <p class="page-kicker">{pageCopy.kicker}</p>
          <h1 class="page-title mt-3 text-6xl">{pageCopy.title}</h1>
          <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{pageCopy.description}</p>
        </div>
      </div>
    </aside>

    <div class="artifact-card rounded-md p-6 md:p-8">
      <div class="space-y-10">
        <section>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Profile</p>
          <h2 class="mt-3 text-4xl font-semibold leading-tight md:text-5xl">{pageCopy.role || pageCopy.title}</h2>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {facts.map((item) => (
              <div class="rounded border border-[var(--line)] bg-[var(--surface-soft)] p-4">
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--muted)]">{item.label}</p>
                {item.href ? (
                  <a class="mt-2 block break-all text-lg font-semibold hover:underline" href={item.href}>{item.value}</a>
                ) : (
                  <p class="mt-2 break-all text-lg font-semibold">{item.value}</p>
                )}
              </div>
            ))}
          </div>
        </section>

        <section class="prose max-w-none">
          <h2>个人简介</h2>
          {summary.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        {focus.length ? (
          <section class="prose max-w-none">
            <h2>关注方向</h2>
            <ul>
              {focus.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ) : null}

        {links.length ? (
          <section>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Links</p>
            <div class="mt-4 flex flex-wrap gap-3">
              {links.map((link) => (
                <a class="border border-[var(--foreground)] px-4 py-2 text-sm font-semibold transition hover:bg-[var(--foreground)] hover:text-[var(--background)]" href={link.href}>
                  {link.label}
                </a>
              ))}
            </div>
          </section>
        ) : null}
      </div>
    </div>
  </section>
</BaseLayout>
