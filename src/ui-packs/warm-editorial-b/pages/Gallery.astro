---
import { galleryItems } from "@/data/gallery";
import { assetUrl, pageConfig } from "@/utils/site";

const isPersonalPhotoImage = (image = "") => {
  if (image.startsWith("/personal-photo/")) return true;
  if (/^https?:\/\//.test(image)) {
    try {
      return new URL(image).pathname.startsWith("/personal-photo/");
    } catch {
      return false;
    }
  }
  return false;
};

const personalPhotoItems = galleryItems.filter((item) => isPersonalPhotoImage(item.image));
const pageCopy = pageConfig.gallery;
---

<section class="container py-12 md:py-18">
    <div class="page-hero grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="page-kicker">{pageCopy.kicker}</p>
        <h1 class="page-title mt-4 text-6xl md:text-8xl">{pageCopy.title}</h1>
      </div>
      <p class="note-rule max-w-2xl text-lg leading-8 text-[var(--muted)]">
        {pageCopy.description}
      </p>
    </div>

    <div class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3">
      {personalPhotoItems.map((item, index) => (
        <figure class="artifact-card group mb-4 break-inside-avoid rounded-[1.75rem] p-2">
          <div class="relative overflow-hidden rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-soft)]">
            <img
              class:list={[
                "w-full object-cover transition duration-500 group-hover:scale-[1.02] group-hover:saturate-110",
                item.height === "tall" && "aspect-[4/5]",
                item.height === "wide" && "aspect-[16/10]",
                item.height === "medium" && "aspect-[5/4]",
              ]}
              src={assetUrl(item.image)}
              alt={item.title}
              loading="lazy"
            />
          </div>
          <figcaption class="flex items-start justify-between gap-4 px-1 py-3">
            <div class="min-w-0">
              <h2 class="font-semibold">{item.title}</h2>
              <p class="mt-1 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
            <span class="folio-number text-xs">{String(index + 1).padStart(2, "0")}</span>
          </figcaption>
        </figure>
      ))}
    </div>
</section>
