---
import { projects } from "@/data/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";

const isExternalLink = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout title="项目" description="个人项目、实验和作品集合。">
  <section class="container py-12 md:py-18">
    <div class="page-hero grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="page-kicker">Works / small machines</p>
        <h1 class="page-title mt-4 text-6xl md:text-8xl">项目</h1>
      </div>
      <p class="note-rule max-w-2xl text-lg leading-8 text-[var(--muted)]">
        已完成或正在迭代的数字实验。这里更偏向功能、系统和可复用的小工具。
      </p>
    </div>

    <div class="mt-8 grid gap-4">
      {projects.map((project, index) => {
        const external = isExternalLink(project.link);
        return (
          <a
            href={project.link}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="artifact-card group grid gap-5 rounded-[1.75rem] p-5 transition hover:-translate-y-0.5 md:grid-cols-[96px_1fr_auto] md:items-center"
          >
            <div class="folio-number text-5xl">{String(index + 1).padStart(2, "0")}</div>
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="literary-title text-3xl">{project.name}</h2>
                <span class="font-mono text-sm text-[var(--muted)]">{project.year}</span>
              </div>
              <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{project.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => <span class="tag-chip px-2 py-1 font-mono text-xs">{tag}</span>)}
              </div>
            </div>
            <span class="font-mono text-sm text-[var(--accent-strong)]">open</span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
