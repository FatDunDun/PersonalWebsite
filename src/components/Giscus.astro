---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const enabled = repo && repoId && category && categoryId;
---

<section class="mt-14 border-t border-[var(--line)] pt-10">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <p class="text-sm uppercase tracking-[0.24em] text-[var(--accent)]">Comments</p>
      <h2 class="mt-2 text-2xl font-semibold">讨论区</h2>
    </div>
  </div>

  {enabled ? (
    <script
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="zh-CN"
      crossorigin="anonymous"
      async
    />
  ) : (
    <div class="rounded-lg border border-dashed border-[var(--line)] bg-[var(--surface-soft)] p-5 text-sm leading-6 text-[var(--muted)]">
      giscus 已接入到文章模板。配置仓库的 giscus 环境变量后，这里会显示评论区。
    </div>
  )}
</section>

<script is:inline>
  const syncGiscusTheme = (theme) => {
    const frame = document.querySelector("iframe.giscus-frame");
    if (!frame) return;
    frame.contentWindow?.postMessage(
      {
        giscus: {
          setConfig: {
            theme: theme === "dark" ? "dark" : "light",
          },
        },
      },
      "https://giscus.app",
    );
  };

  window.addEventListener("theme-change", (event) => syncGiscusTheme(event.detail));
</script>
