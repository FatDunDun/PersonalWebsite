---
---

<canvas id="cursor-field" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("cursor-field") as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (canvas && !reduceMotion.matches) {
    const context = canvas.getContext("2d", { alpha: true });
    const pointer = {
      x: null as number | null,
      y: null as number | null,
      max: 43000,
    };

    let width = 0;
    let height = 0;
    let ratio = 1;
    let raf = 0;
    const particles: Array<{ x: number; y: number; vx: number; vy: number; max: number }> = [];

    const colorForTheme = () => {
      const isDark = document.documentElement.classList.contains("dark");
      return isDark ? "214, 232, 248" : "20, 36, 50";
    };

    const accentForTheme = () => {
      const isDark = document.documentElement.classList.contains("dark");
      return isDark ? "190, 220, 255" : "58, 94, 112";
    };

    const particleCountForViewport = () => {
      const area = width * height;
      if (width < 680) return 58;
      return Math.min(138, Math.max(92, Math.floor(area / 11500)));
    };

    const createParticle = () => {
      const velocityScale = width < 680 ? 0.54 : 0.76;
      return {
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() * 2 - 1) * velocityScale,
        vy: (Math.random() * 2 - 1) * velocityScale,
        max: width < 680 ? 9800 : 14500,
      };
    };

    const syncParticleCount = () => {
      const targetCount = particleCountForViewport();
      while (particles.length < targetCount) particles.push(createParticle());
      while (particles.length > targetCount) particles.pop();
    };

    const resize = () => {
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      canvas.style.width = width + "px";
      canvas.style.height = height + "px";
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      syncParticleCount();
    };

    const drawNode = (x: number, y: number, alpha: number, color: string, radius = 1.55) => {
      if (!context) return;
      context.beginPath();
      context.arc(x, y, radius, 0, Math.PI * 2);
      context.fillStyle = "rgba(" + color + "," + alpha + ")";
      context.fill();
    };

    const drawLine = (
      x1: number,
      y1: number,
      x2: number,
      y2: number,
      alpha: number,
      color: string,
      lineWidth: number,
    ) => {
      if (!context) return;
      context.beginPath();
      context.moveTo(x1, y1);
      context.lineTo(x2, y2);
      context.strokeStyle = "rgba(" + color + "," + alpha + ")";
      context.lineWidth = lineWidth;
      context.lineCap = "round";
      context.stroke();
    };

    const draw = () => {
      if (!context) return;

      const color = colorForTheme();
      const accent = accentForTheme();
      context.clearRect(0, 0, width, height);

      const field: Array<{ x: number | null; y: number | null; max: number }> = pointer.x === null || pointer.y === null
        ? particles
        : particles.concat([pointer]);

      particles.forEach((particle, index) => {
        particle.x += particle.vx;
        particle.y += particle.vy;

        if (particle.x > width || particle.x < 0) particle.vx *= -1;
        if (particle.y > height || particle.y < 0) particle.vy *= -1;

        particle.x = Math.min(width, Math.max(0, particle.x));
        particle.y = Math.min(height, Math.max(0, particle.y));

        drawNode(particle.x, particle.y, 0.54, color);

        for (let nextIndex = index + 1; nextIndex < field.length; nextIndex += 1) {
          const target = field[nextIndex];
          if (target.x === null || target.y === null) continue;

          const dx = particle.x - target.x;
          const dy = particle.y - target.y;
          const distance = dx * dx + dy * dy;
          const maxDistance = target === pointer ? pointer.max : particle.max;

          if (distance < maxDistance) {
            if (target === pointer && distance > maxDistance * 0.34) {
              particle.x -= dx * 0.019;
              particle.y -= dy * 0.019;
            }

            const strength = (maxDistance - distance) / maxDistance;
            const isPointerLine = target === pointer;
            const alpha = isPointerLine ? strength * 0.72 + 0.12 : strength * 0.46 + 0.065;
            const lineWidth = isPointerLine ? strength * 1.18 + 0.32 : strength * 0.62 + 0.18;
            drawLine(particle.x, particle.y, target.x, target.y, alpha, isPointerLine ? accent : color, lineWidth);
          }
        }
      });

      raf = window.requestAnimationFrame(draw);
    };

    const handlePointerMove = (event: PointerEvent) => {
      pointer.x = event.clientX;
      pointer.y = event.clientY;
    };

    const clearPointer = (event?: PointerEvent) => {
      if (event?.relatedTarget) return;
      pointer.x = null;
      pointer.y = null;
    };

    resize();
    draw();

    window.addEventListener("resize", resize);
    window.addEventListener("pointermove", handlePointerMove, { passive: true });
    window.addEventListener("pointerout", clearPointer);
    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) {
        window.cancelAnimationFrame(raf);
        context.clearRect(0, 0, width, height);
      } else {
        draw();
      }
    });
  }
</script>
