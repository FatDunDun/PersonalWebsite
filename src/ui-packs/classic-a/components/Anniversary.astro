---
import { anniversaryConfig } from "@/utils/site";
---

<section
  class="anniversary-mist relative overflow-hidden rounded-[1.6rem] px-5 py-6 md:px-7 md:py-7"
  data-anniversary
  data-start-at={anniversaryConfig.startAt}
>
  <div class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/45 to-transparent"></div>

  <div class="relative grid gap-4 md:grid-cols-[1fr_auto] md:items-start">
    <div class="min-w-0">
      <p class="exhibition-meta text-xs uppercase tracking-[0.26em]">{anniversaryConfig.label}</p>
      <p class="anniversary-title mt-4 max-w-2xl text-lg leading-8 text-[var(--foreground)] md:text-2xl md:leading-10">
        {anniversaryConfig.title}
      </p>
    </div>
    <time
      class="anniversary-date hidden shrink-0 rounded-full px-3 py-1.5 font-mono text-xs tracking-[0.08em] text-[var(--muted)] sm:block"
      data-anniversary-date
    >
      {anniversaryConfig.startAt}
    </time>
  </div>

  <div class="relative mt-7">
    <div class="mb-4 h-px w-full bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
    <div class="anniversary-counter grid grid-cols-4 overflow-hidden rounded-[1.35rem]">
      {["天", "时", "分", "秒"].map((unit) => (
        <div class="anniversary-unit group relative px-3 py-4 transition duration-500 hover:bg-white/12 md:px-5 md:py-5">
          <p class="font-mono text-3xl font-semibold leading-none tracking-tight text-[var(--foreground)] md:text-5xl" data-anniversary-value={unit}>00</p>
          <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.26em] text-[var(--muted)] md:text-xs">{unit}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .anniversary-mist {
    --cursor-x: 50%;
    --cursor-y: 34%;
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    isolation: isolate;
    transform: perspective(920px) rotateX(var(--tilt-y)) rotateY(var(--tilt-x)) translate3d(0, 0, 0);
    transform-style: preserve-3d;
    transition: transform 760ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .anniversary-mist::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -22% -10% auto;
    height: 72%;
    background:
      radial-gradient(circle at var(--cursor-x) var(--cursor-y), rgb(255 255 255 / 0.36), transparent 9.5rem),
      radial-gradient(ellipse at 18% 8%, rgb(255 255 255 / 0.40), transparent 58%),
      radial-gradient(ellipse at 82% 16%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 62%),
      linear-gradient(180deg, rgb(255 255 255 / 0.16), transparent 76%);
    filter: blur(30px);
    opacity: 0.78;
    animation: anniversary-aurora 12s ease-in-out infinite alternate;
    mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0.72) 54%, transparent 100%);
  }

  .anniversary-mist::after {
    content: "";
    position: absolute;
    inset: auto 7% 8% 7%;
    z-index: -1;
    height: 34%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-warm) 16%, transparent);
    filter: blur(38px);
    opacity: 0.58;
  }

  .anniversary-title {
    text-wrap: balance;
    text-shadow: 0 1px 18px rgb(255 255 255 / 0.18);
  }

  .anniversary-date {
    border: 1px solid rgb(255 255 255 / 0.16);
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16);
    backdrop-filter: blur(14px);
  }

  .anniversary-counter {
    position: relative;
    border: 1px solid rgb(255 255 255 / 0.16);
    background:
      linear-gradient(110deg, rgb(255 255 255 / 0.13), rgb(255 255 255 / 0.05) 48%, color-mix(in srgb, var(--accent) 10%, transparent)),
      rgb(255 255 255 / 0.06);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 -1px 0 rgb(255 255 255 / 0.08);
    backdrop-filter: blur(18px) saturate(1.12);
  }

  .anniversary-counter::before,
  .anniversary-counter::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .anniversary-counter::before {
    background: radial-gradient(circle at var(--cursor-x) var(--cursor-y), rgb(255 255 255 / 0.22), transparent 42%);
    opacity: 0.72;
    transition: opacity 500ms ease;
  }

  .anniversary-counter::after {
    background: linear-gradient(105deg, transparent 0 36%, rgb(255 255 255 / 0.18) 48%, transparent 60% 100%);
    mix-blend-mode: screen;
    opacity: 0.58;
    transform: translateX(-125%);
    animation: anniversary-signal 6.8s ease-in-out infinite;
  }

  .anniversary-unit + .anniversary-unit::before {
    content: "";
    position: absolute;
    inset: 18% auto 18% 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgb(255 255 255 / 0.24), transparent);
  }

  .anniversary-unit {
    z-index: 1;
  }

  .anniversary-unit:hover {
    transform: translateY(-2px);
  }

  .anniversary-unit::after {
    content: "";
    position: absolute;
    inset: 12% 14%;
    z-index: -1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-strong) 12%, transparent);
    filter: blur(22px);
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .anniversary-unit:hover::after {
    opacity: 1;
  }

  @keyframes anniversary-aurora {
    from {
      transform: translate3d(-1.2rem, -0.35rem, 0) scale(1);
    }
    to {
      transform: translate3d(1rem, 0.45rem, 0) scale(1.05);
    }
  }

  @keyframes anniversary-signal {
    0%,
    42% {
      transform: translateX(-125%);
    }
    72%,
    100% {
      transform: translateX(125%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anniversary-mist {
      transform: none;
      transition: none;
    }

    .anniversary-counter::after {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  const pad = (value: number) => String(value).padStart(2, "0");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-anniversary]")) {
    const startAt = root.dataset.startAt;
    const start = startAt ? new Date(startAt) : null;
    const dateLabel = root.querySelector<HTMLElement>("[data-anniversary-date]");
    const values = {
      天: root.querySelector<HTMLElement>('[data-anniversary-value="天"]'),
      时: root.querySelector<HTMLElement>('[data-anniversary-value="时"]'),
      分: root.querySelector<HTMLElement>('[data-anniversary-value="分"]'),
      秒: root.querySelector<HTMLElement>('[data-anniversary-value="秒"]'),
    };

    if (!start || Number.isNaN(start.valueOf())) continue;

    if (dateLabel) {
      dateLabel.textContent = new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(start);
    }

    const update = () => {
      const diff = Math.max(0, Date.now() - start.valueOf());
      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      if (values["天"]) values["天"].textContent = String(days);
      if (values["时"]) values["时"].textContent = pad(hours);
      if (values["分"]) values["分"].textContent = pad(minutes);
      if (values["秒"]) values["秒"].textContent = pad(seconds);
    };

    update();
    window.setInterval(update, 1000);

    if (!reduceMotion.matches) {
      let frame = 0;

      const resetMotion = () => {
        root.style.setProperty("--cursor-x", "50%");
        root.style.setProperty("--cursor-y", "34%");
        root.style.setProperty("--tilt-x", "0deg");
        root.style.setProperty("--tilt-y", "0deg");
      };

      const handlePointerMove = (event: PointerEvent) => {
        window.cancelAnimationFrame(frame);
        frame = window.requestAnimationFrame(() => {
          const rect = root.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width) * 100;
          const y = ((event.clientY - rect.top) / rect.height) * 100;
          const clampedX = Math.min(100, Math.max(0, x));
          const clampedY = Math.min(100, Math.max(0, y));
          const tiltX = (clampedX - 50) * 0.026;
          const tiltY = (50 - clampedY) * 0.018;

          root.style.setProperty("--cursor-x", clampedX.toFixed(2) + "%");
          root.style.setProperty("--cursor-y", clampedY.toFixed(2) + "%");
          root.style.setProperty("--tilt-x", tiltX.toFixed(3) + "deg");
          root.style.setProperty("--tilt-y", tiltY.toFixed(3) + "deg");
        });
      };

      root.addEventListener("pointermove", handlePointerMove, { passive: true });
      root.addEventListener("pointerleave", resetMotion);
    }
  }
</script>
