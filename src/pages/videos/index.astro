---
import { videoItems } from "@/data/videos";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { assetUrl } from "@/utils/site";
---

<BaseLayout title="视频" description="PersonalVideo 日常视频记录，保存 vlog、生活片段和动态记忆。">
  <section class="container py-12 md:py-18">
    <div class="page-hero grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="page-kicker">PersonalVideo / moving frames</p>
        <h1 class="page-title mt-4 text-6xl md:text-8xl">视频</h1>
      </div>
      <p class="note-rule max-w-2xl text-lg leading-8 text-[var(--muted)]">
        用短视频保存日常、旅行和 vlog 片段。适合压缩后的 MP4 或 WebM，让动态记忆也能长期整理。
      </p>
    </div>

    {
      videoItems.length ? (
        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          {videoItems.map((item, index) => (
            <article class="artifact-card rounded-md p-2">
              <div class="overflow-hidden rounded border border-[var(--line)] bg-black">
                <video class="aspect-video w-full object-cover" controls playsinline preload="metadata" poster={item.poster ? assetUrl(item.poster) : undefined} src={assetUrl(item.video)}></video>
              </div>
              <div class="flex items-start justify-between gap-4 px-2 py-4">
                <div>
                  <p class="font-mono text-xs text-[var(--muted)]">{item.date}</p>
                  <h2 class="mt-2 text-xl font-semibold">{item.title}</h2>
                  <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
                </div>
                <span class="folio-number text-xs">{String(index + 1).padStart(2, "0")}</span>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="artifact-card mt-10 rounded-md p-8 text-[var(--muted)]">
          还没有 PersonalVideo。可以在隐藏管理页上传日常视频并保存到这里。
        </div>
      )
    }
  </section>
</BaseLayout>
