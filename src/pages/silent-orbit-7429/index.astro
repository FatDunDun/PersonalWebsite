        projects: { kicker: "Projects", title: "项目列表", empty: "暂无项目。" },
        recommendations: { kicker: "Taste", title: "推荐列表", empty: "暂无推荐。" },
        gallery: { kicker: "PersonalPhoto", title: "生活照片", empty: "暂无照片。" },
        personalVideos: { kicker: "PersonalVideo", title: "视频记录", empty: "暂无视频记录。" },
        images: { kicker: "ARTICLE_IMAGE_ASSETS", title: "ARTICLE_IMAGE_ASSETS", empty: "暂无 ARTICLE_IMAGE_ASSETS。" },
        personalPhotoAssets: { kicker: "PersonalPhoto Assets", title: "PersonalPhoto文件", empty: "暂无 PersonalPhoto 文件。" },
        videos: { kicker: "ARTICLE_VIDEO_ASSETS", title: "ARTICLE_VIDEO_ASSETS", empty: "暂无 ARTICLE_VIDEO_ASSETS。" },
        personalVideoAssets: { kicker: "PersonalVideo Assets", title: "PersonalVideo文件", empty: "暂无 PersonalVideo 文件。" },
        settings: { kicker: "Settings", title: "页面配置", empty: "在右侧编辑网站配置。" },
        pageCopy: { kicker: "Page Copy", title: "栏目文案", empty: "在右侧编辑栏目文案。" },
        drafts: { kicker: "LOCAL_DRAFTS", title: "本地保存", empty: "暂无本地保存。" },
      };

      const mediaLibraries = {
        images: {
          kind: "image",
          stateKey: "images",
          directory: ARTICLE_IMAGE_ASSETS_PATH,
          publicRoot: "/article-assets",
          summaryKey: "images",
          empty: "暂无 ARTICLE_IMAGE_ASSETS。",
        },
        personalPhotoAssets: {
          kind: "image",
          stateKey: "personalPhotoAssets",
          directory: PERSONAL_PHOTO_PATH,
          publicRoot: "/personal-photo",
          summaryKey: "personalPhotoAssets",
          empty: "暂无 PersonalPhoto 文件。",
        },
        videos: {
          kind: "video",
          stateKey: "videos",
          directory: ARTICLE_VIDEO_ASSETS_PATH,
          publicRoot: "/article-videos",
          summaryKey: "videos",
          empty: "暂无 ARTICLE_VIDEO_ASSETS。",
        },
        personalVideoAssets: {
          kind: "video",
          stateKey: "personalVideoAssets",
          directory: PERSONAL_VIDEO_PATH,
          publicRoot: "/personal-video",
          summaryKey: "personalVideoAssets",
          empty: "暂无 PersonalVideo 文件。",
        },
      };

      const isMediaLibrarySection = (section) => !!mediaLibraries[section];

      const mediaDirectoryState = (section) => state.mediaDirectoryState[section];

      const sectionForMediaRoot = (publicRoot = "") =>
        Object.keys(mediaLibraries).find((section) => {
          const root = mediaLibraries[section].publicRoot;
          return publicRoot === root || publicRoot.startsWith(`${root}/`);
        });

      const normalizePublicRoot = (publicRoot = "") => `/${mediaRootFromPublicRoot(publicRoot)}`;

      const mediaCurrentPublicRoot = (section) => mediaDirectoryState(section)?.currentPublicRoot || mediaLibraries[section]?.publicRoot || "";

      const mediaTargetPublicRoot = (kindOrSection) => {
        const section = mediaLibraries[kindOrSection] ? kindOrSection : kindOrSection === "image" ? "images" : "videos";
        return mediaCurrentPublicRoot(section);
      };

      const mediaTargetDirectory = (section) => {
        const config = mediaLibraries[section];
        const currentRoot = mediaCurrentPublicRoot(section);
        const suffix = currentRoot.startsWith(`${config.publicRoot}/`) ? currentRoot.slice(config.publicRoot.length + 1) : "";
        return suffix ? `${config.directory}/${suffix}` : config.directory;
      };

      const setStatus = (message) => {
        status.textContent = message;
      };

      const escapeHtml = (value = "") =>
        String(value).replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);

      const formatDate = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.valueOf())) return String(value);
        return new Intl.DateTimeFormat("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        }).format(date);
      };

      const postSlug = (post) => post.slug || post.name?.replace(/\.(md|mdx)$/, "") || "";
      const postDisplayTitle = (post) => post.data?.title || post.title || postSlug(post) || "未命名文章";
      const isPersonalPhotoPath = (path = "") => path.startsWith("/personal-photo/");
      const isPersonalPhotoValue = (path = "") => {
        if (isPersonalPhotoPath(path)) return true;
        if (/^https?:\/\//.test(path)) {
          try {
            return new URL(path).pathname.startsWith("/personal-photo/");
          } catch {
            return false;
          }
        }
        return false;
      };
      const isMediaLibraryValue = (path = "", libraryKey = "") => {
        const publicRoot = mediaLibraries[libraryKey]?.publicRoot;
        if (!publicRoot || !path) return false;
        if (path.startsWith(`${publicRoot}/`)) return true;
        if (/^https?:\/\//.test(path)) {
          try {
            return new URL(path).pathname.startsWith(`${publicRoot}/`);
          } catch {
            return false;
          }
        }
        return false;
      };
      const isPersonalVideoValue = (path = "") => {
        if (path.startsWith("/personal-video/")) return true;
        if (/^https?:\/\//.test(path)) {
          try {
            return new URL(path).pathname.startsWith("/personal-video/");
          } catch {
            return false;
          }
        }
        return false;
      };

      const slugify = (value) =>
        value
          .trim()
          .toLowerCase()
          .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 80);

      const slugifyFile = (value) =>
        value
          .trim()
          .toLowerCase()
          .normalize("NFKD")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 60);

      const toBase64 = (text) => {
        const bytes = new TextEncoder().encode(text);
        let binary = "";
        for (let index = 0; index < bytes.length; index += 1) binary += String.fromCharCode(bytes[index]);
        return btoa(binary);
      };

      const fromBase64 = (base64) => {
        const binary = atob(base64.replace(/\n/g, ""));
        const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
        return new TextDecoder().decode(bytes);
      };

      const arrayBufferToBase64 = (buffer) => {
        const bytes = new Uint8Array(buffer);
        let binary = "";
        for (let index = 0; index < bytes.length; index += 1) binary += String.fromCharCode(bytes[index]);
        return btoa(binary);
      };

      const withBase = (path) => {
        if (!path) return "";
        if (/^https?:\/\//.test(path)) return path;
        const base = BASE_URL.endsWith("/") ? BASE_URL : `${BASE_URL}/`;
        return new URL(`${base}${path.replace(/^\/+/, "")}`, location.origin).toString();
      };

      const assetUrl = (path) => {
        if (!path) return "";
        if (/^https?:\/\//.test(path)) return path;
        return withBase(path);
      };

      const publicPathToRepoPath = (path) => (path?.startsWith("/") ? `public${path}` : "");

      const clone = (value) => JSON.parse(JSON.stringify(value));

      const mediaStorageMode = () => (MEDIA_API_URL ? "r2" : "github");

      const usesRemoteMedia = (item) => item?.remote === true || mediaStorageMode() === "r2";

      const detectLocalApi = async () => {
        state.mode = state.token ? "github" : "readonly";
      };

      const requireWriteAccess = () => {
        if (!state.token) throw new Error("暂存、删除、上传和同步需要先输入 GitHub Token。改动会先留在当前页面，点“同步全部改动”后才提交到 GitHub main 分支。");
        if (!state.remoteContentReady) {
          throw new Error("GitHub 最新内容尚未完整加载。请检查 Token 后重新连接，避免用旧内容覆盖线上配置。");
        }
      };

      const requireMediaAccess = () => {
        if (mediaStorageMode() !== "r2") return;
        if (!state.mediaToken) throw new Error("R2 上传、删除和读取素材库需要先输入 Media Token。这个值对应 Cloudflare Worker 的 ADMIN_TOKEN。");
      };

      const describeMediaError = (error) => {
        const message = error instanceof Error ? error.message : "";
        if (!message || message === "Failed to fetch") {
          return "R2 API 无法访问：请检查 PUBLIC_MEDIA_API_URL、Cloudflare Worker CORS 配置和 Media Token 是否正确。";
        }
        return message;
      };

      const mediaApi = async (path, options = {}) => {
        requireMediaAccess();
        let response;
        try {
          response = await fetch(`${MEDIA_API_URL.replace(/\/$/, "")}${path}`, {
            ...options,
            headers: {
              Authorization: `Bearer ${state.mediaToken}`,
              ...(options.headers || {}),
            },
          });
        } catch (error) {
          throw new Error(describeMediaError(error));
        }
        const data = await response.json().catch(() => null);
        if (!response.ok) throw new Error(data?.message || `Media API error ${response.status}`);
        return data;
      };

      const mediaKeyFromPublicPath = (path = "") => {
        if (/^https?:\/\//.test(path)) {
          try {
            return new URL(path).pathname.replace(/^\/+/, "");
          } catch {
            return path.replace(/^\/+/, "");
          }
        }
        return path.replace(/^\/+/, "");
      };

      const mediaUrlFromPublicPath = (path = "") => {
        if (!path || /^https?:\/\//.test(path)) return path;
        if (!ASSET_BASE_URL) return path;
        return `${ASSET_BASE_URL.replace(/\/$/, "")}/${mediaKeyFromPublicPath(path)}`;
      };

      const mediaContentValue = (asset) => {
        if (!asset) return "";
        if (asset.remote) return asset.url || mediaUrlFromPublicPath(asset.publicPath);
        return asset.publicPath || "";
      };

      const mediaRootFromPublicRoot = (publicRoot = "/article-assets") => publicRoot.replace(/^\/+|\/+$/g, "");

      const mergeMediaAssets = (localAssets = [], remoteAssets = []) => {
        const seen = new Set();
        return [...remoteAssets, ...localAssets].filter((asset) => {
          const identity = asset.key || asset.publicPath || asset.path || asset.name;
          if (!identity || seen.has(identity)) return false;
          seen.add(identity);
          return true;
        });
      };

      const mediaApiList = async (publicRoot) => {
        const prefix = mediaRootFromPublicRoot(publicRoot);
        const data = await mediaApi(`/media?prefix=${encodeURIComponent(prefix)}`);
        const mediaListPayload = data && typeof data === "object" ? data : { objects: [], folders: [] };
        const mediaFolders = Array.isArray(mediaListPayload.folders) ? mediaListPayload.folders : [];
        const mediaObjects = Array.isArray(mediaListPayload.objects) ? mediaListPayload.objects : [];
        const section = sectionForMediaRoot(normalizePublicRoot(publicRoot));
        if (section) {
          mediaDirectoryState(section).folders = mediaFolders.map((folder) => ({
            ...folder,
            type: "folder",
            publicPath: normalizePublicRoot(folder.path || folder.key),
            folderPrefix: folder.key,
          }));
        }
        return mediaObjects.map((item) => ({
          name: item.name,
          key: item.key,
          path: item.key,
          publicPath: item.path,
          url: item.url,
          size: item.size,
          uploaded: item.uploaded,
          remote: true,
          type: "file",
        }));
      };

      const mediaApiCreateFolder = async (publicRoot) => {
        const form = new FormData();
        form.append("key", mediaKeyFromPublicPath(publicRoot));
        return mediaApi("/media/folder", {
          method: "POST",
          body: form,
        });
      };

      const mediaApiUpload = async (upload) => {
        const form = new FormData();
        form.append("key", upload.key || mediaKeyFromPublicPath(upload.publicPath));
        form.append("file", upload.file, upload.name);
        return mediaApi("/media/upload", {
          method: "POST",
          body: form,
        });
      };

      const mediaApiDelete = async (asset) => {
        const key = asset.key || mediaKeyFromPublicPath(asset.publicPath);
        return mediaApi(`/media?key=${encodeURIComponent(key)}`, {
          method: "DELETE",
        });
      };

      const syncRemoteMediaOperations = async ({ uploads, deletes }) => {
        if (!uploads.length && !deletes.length) return;
        requireMediaAccess();
        for (const upload of uploads) await mediaApiUpload(upload);
        for (const deleted of deletes) await mediaApiDelete(deleted);
      };

      const github = async (path, options = {}) => {
        const method = options.method || "GET";
        const isWrite = method !== "GET";
        if (isWrite && !state.token) throw new Error("保存、删除、上传需要先输入 GitHub Token");
        const response = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}${path}`, {
          ...options,
          headers: {
            Accept: "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            ...(state.token ? { Authorization: `Bearer ${state.token}` } : {}),
            ...(options.headers || {}),
          },
        });
        const data = await response.json().catch(() => null);
        if (!response.ok) throw new Error(data?.message || `GitHub API error ${response.status}`);
        return data;
      };

      const getFile = async (path, ref = BRANCH) => {
        return github(`/contents/${path}?ref=${encodeURIComponent(ref)}`);
      };

      const getDir = async (path) => {
        return github(`/contents/${path}?ref=${BRANCH}`);
      };

      const putFile = async ({ path, content, message, sha }) => {
        return github(`/contents/${path}`, {
          method: "PUT",
          body: JSON.stringify({
            message,
            content,
            branch: BRANCH,
            ...(sha ? { sha } : {}),
          }),
        });
      };

      const deleteFile = async ({ path, sha, message }) => {
        return github(`/contents/${path}`, {
          method: "DELETE",
          body: JSON.stringify({
            message,
            sha,
            branch: BRANCH,
          }),
        });
      };

      const getBranchRef = async () => {
        return github(`/git/ref/heads/${BRANCH}`);
      };

      const getGitCommit = async (sha) => {
        return github(`/git/commits/${sha}`);
      };

      const createGitBlob = async ({ content }) => {
        return github("/git/blobs", {
          method: "POST",
          body: JSON.stringify({
            content,
            encoding: "base64",
          }),
        });
      };

      const createGitTree = async ({ baseTreeSha, tree }) => {
        return github("/git/trees", {
          method: "POST",
          body: JSON.stringify({
            base_tree: baseTreeSha,
            tree,
          }),
        });
      };

      const createGitCommit = async ({ message, treeSha, parentSha }) => {
        return github("/git/commits", {
          method: "POST",
          body: JSON.stringify({
            message,
            tree: treeSha,
            parents: [parentSha],
          }),
        });
      };

      const updateBranchRef = async (sha) => {
        return github(`/git/refs/heads/${BRANCH}`, {
          method: "PATCH",
          body: JSON.stringify({
            sha,
            force: false,
          }),
        });
      };

      const parseFrontmatter = (content) => {
        const match = content.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
        if (!match) return { data: {}, body: content };
        const data = {};
        for (const line of match[1].split("\n")) {
          const [rawKey, ...rest] = line.split(":");
          if (!rawKey || rest.length === 0) continue;
          const key = rawKey.trim();
          const value = rest.join(":").trim();
          if (value.startsWith("[") && value.endsWith("]")) {
            data[key] = value
              .slice(1, -1)
              .split(",")
              .map((item) => item.trim().replace(/^"|"$/g, ""))
              .filter(Boolean);
          } else if (value === "true" || value === "false") {
            data[key] = value === "true";
          } else {
            data[key] = value.replace(/^"|"$/g, "");
          }
        }
        return { data, body: match[2] };
      };

      const readExportedJson = (content, exportName) => {
        const match = content.match(new RegExp(`export\\s+const\\s+${exportName}(?:\\s*:[^=]+)?\\s*=\\s*([\\s\\S]*);?\\s*$`));
        if (!match) throw new Error(`无法解析 ${exportName}`);
        return JSON.parse(match[1].replace(/;\s*$/, ""));
      };

      const readExportedValue = (content, exportName) => {
        return readExportedJson(content, exportName);
      };

      const stringifyArrayModule = (exportName, items) => `export const ${exportName} = ${JSON.stringify(items, null, 2)};\n`;

      const stringifySettingsModule = (settings) => `export const siteSettings = ${JSON.stringify(settings, null, 2)};\n`;

      const getByPath = (object, path) =>
        path.split(".").reduce((target, key) => (target && Object.prototype.hasOwnProperty.call(target, key) ? target[key] : undefined), object);

      const setByPath = (object, path, value) => {
        const keys = path.split(".");
        let target = object;
        keys.slice(0, -1).forEach((key) => {
          if (!target[key] || typeof target[key] !== "object") target[key] = {};
          target = target[key];
        });
        target[keys.at(-1)] = value;
      };

      const stringifyNavText = (items = []) =>
        items
          .map((item) => `${item.visible !== false ? "true" : "false"}|${item.label || ""}|${item.href || ""}`)
          .join("\n");

      const stringifyCodeLines = (items = []) =>
        items.map((item) => `${item.label || ""}|${item.value || ""}`).join("\n");

      const stringifyTextList = (items = []) =>
        Array.isArray(items) ? items.filter(Boolean).join("\n") : "";

      const stringifyAboutLinks = (items = []) =>
        Array.isArray(items) ? items.map((item) => `${item.label || ""}|${item.href || ""}`).join("\n") : "";

      const parseCodeLines = (text) =>
        text
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const [label = "", ...rest] = line.split("|");
            return { label: label.trim() || "note", value: rest.join("|").trim() };
          })
          .filter((item) => item.value);

      const parseTextList = (text) =>
        text
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean);

      const parseAboutLinks = (text) =>
        text
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const [label = "", ...rest] = line.split("|");
            return { label: label.trim(), href: rest.join("|").trim() };
          })
          .filter((item) => item.label && item.href);

      const parseNavText = (text) =>
        text
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const [visible = "true", label = "", href = ""] = line.split("|").map((part) => part.trim());
            return { href: href || "/", label: label || "未命名", visible: visible !== "false" };
          });

      const stringifyPost = () => {
        const tags = postFields.tags.value
          .split(",")
          .map((tag) => tag.trim())
          .filter(Boolean);
        const lines = [
          "---",
          `title: "${postFields.title.value.trim().replaceAll('"', '\\"')}"`,
          `description: "${postFields.description.value.trim().replaceAll('"', '\\"')}"`,
          `publishDate: ${postFields.publishDate.value}`,
        ];
        if (postFields.cover.value.trim()) lines.push(`cover: "${postFields.cover.value.trim()}"`);
        lines.push(`tags: [${tags.map((tag) => `"${tag.replaceAll('"', '\\"')}"`).join(", ")}]`);
        if (postFields.draft.checked) lines.push("draft: true");
        lines.push("---", "", postFields.body.value.trim(), "");
        return lines.join("\n");
      };

      const renderMarkdownPreview = () => {
        const body = postFields.body.value || "";
        const html = escapeHtml(body)
          .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_match, alt, src) => {
            const url = src.startsWith("/") ? assetUrl(src) : src;
            return `<img src="${url}" alt="${alt}" loading="lazy" />`;
          })
          .replace(/&lt;video class=&quot;post-video&quot; controls playsinline preload=&quot;metadata&quot; src=&quot;([^&]+)&quot;&gt;&lt;\/video&gt;/g, (_match, src) => {
            const url = src.startsWith("/") ? assetUrl(src) : src;
            return `<video class="post-video" controls playsinline preload="metadata" src="${url}"></video>`;
          })
          .replace(/^### (.*)$/gm, "<h3>$1</h3>")
          .replace(/^## (.*)$/gm, "<h2>$1</h2>")
          .replace(/^# (.*)$/gm, "<h1>$1</h1>")
          .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
          .replace(/`([^`]+)`/g, "<code>$1</code>")
          .split(/\n{2,}/)
          .map((block) => (/^<(h[1-3]|img|video)\b/.test(block) ? block : `<p>${block.replace(/\n/g, "<br />")}</p>`))
          .join("");
        $("[data-post-preview]").innerHTML = html || "<p>预览会显示在这里。</p>";
      };

      const insertMarkdownAtCursor = (snippet) => {
        const textarea = postFields.body;
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? textarea.value.length;
        const before = textarea.value.slice(0, start);
        const after = textarea.value.slice(end);
        const prefix = before && !before.endsWith("\n") ? "\n\n" : "";
        const suffix = after && !after.startsWith("\n") ? "\n\n" : "";
        textarea.value = `${before}${prefix}${snippet}${suffix}${after}`;
        const cursor = before.length + prefix.length + snippet.length;
        textarea.focus();
        textarea.setSelectionRange(cursor, cursor);
        renderMarkdownPreview();
      };

      const insertImageMarkdown = (image, altText = "") => {
        const imageValue = mediaContentValue(image);
        if (!imageValue) throw new Error("请先上传或选中一张 ARTICLE_IMAGE_ASSETS 图片");
        const fallbackAlt = image.name?.replace(/\.[^.]+$/, "").replace(/^\d+-/, "").replace(/-[a-z0-9]{8}$/, "").replace(/-/g, " ") || "图片";
        insertMarkdownAtCursor(`![${altText || fallbackAlt}](${imageValue})`);
      };

      const insertVideoHtml = (video) => {
        const videoValue = mediaContentValue(video);
        if (!videoValue) throw new Error("请先上传一个视频");
        insertMarkdownAtCursor(`<video class="post-video" controls playsinline preload="metadata" src="${videoValue}"></video>`);
      };

      const updateCounts = () => {
        const setCount = (key, value) => {
          const node = $(`[data-count="${key}"]`);
          if (node) node.textContent = value;
        };
        setCount("posts", state.posts.length);
        setCount("projects", state.projects.length);
        setCount("recommendations", state.recommendations.length);
        setCount("gallery", state.gallery.length);
        setCount("personalVideos", state.personalVideos.length);
        setCount("articleAssets", state.images.length + state.videos.length);
        setCount("images", state.images.length);
        setCount("personalPhotoAssets", state.personalPhotoAssets.length);
        setCount("videos", state.videos.length);
        setCount("personalVideoAssets", state.personalVideoAssets.length);
        setCount("settings", "编辑");
        setCount("pageCopy", "编辑");
        setCount("drafts", allPendingChanges().length);
      };

      const pendingMediaCount = (kind, publicRoot = "") => {
        const matchesRoot = (item) => !publicRoot || item.publicPath?.startsWith(`${publicRoot}/`);
        const uploads = state.pendingMedia.uploads.filter((item) => item.kind === kind && matchesRoot(item)).length;
        const deletes = state.pendingMedia.deletes.filter((item) => item.kind === kind && matchesRoot(item)).length;
        return { uploads, deletes, total: uploads + deletes };
      };

      const allPendingMedia = () => [...state.pendingMedia.uploads, ...state.pendingMedia.deletes];

      const allPendingChanges = () => [
        ...state.pendingChanges.files,
        ...state.pendingChanges.deletes,
        ...state.pendingMedia.uploads,
        ...state.pendingMedia.deletes,
      ];

      const draftChangeId = (item) => `${item?.draftKind || "change"}:${item?.path || item?.publicPath || item?.label || item?.name || ""}`;

      const selectDraft = (item, selected = true) => {
        const id = draftChangeId(item);
        if (!id) return;
        if (selected) state.pendingDraftSelection.add(id);
        else state.pendingDraftSelection.delete(id);
      };

      const selectedPendingChanges = () => {
        const selected = state.pendingDraftSelection;
        return allPendingChanges().filter((item) => selected.has(draftChangeId(item)));
      };

      const queueContentChange = ({ path, content, label, previewValue = "", settingsScopes = [] }) => {
        state.pendingChanges.deletes = state.pendingChanges.deletes.filter((item) => item.path !== path);
        const existing = state.pendingChanges.files.findIndex((item) => item.path === path);
        const entry = { path, content, label, previewValue, settingsScopes, pending: true, draftKind: "content-write" };
        if (existing >= 0) state.pendingChanges.files[existing] = entry;
        else state.pendingChanges.files.push(entry);
        selectDraft(entry, true);
        updatePendingChangesUi();
      };

      const queueSettingsChange = ({ content, scope, scopeLabel, previewValue = "" }) => {
        const existing = state.pendingChanges.files.find((item) => item.path === SETTINGS_PATH);
        const scopes = new Map(existing?.settingsScopes || []);
        scopes.set(scope, scopeLabel);
        const settingsScopes = Array.from(scopes.entries());
        queueContentChange({
          path: SETTINGS_PATH,
          content,
          label: settingsScopes.map(([, label]) => label).join(" + "),
          previewValue,
          settingsScopes,
        });
      };

      const queueDeleteChange = ({ path, label }) => {
        state.pendingChanges.files = state.pendingChanges.files.filter((item) => item.path !== path);
        const pendingUploadIndex = state.pendingMedia.uploads.findIndex((item) => item.path === path);
        if (pendingUploadIndex >= 0) {
          const [removed] = state.pendingMedia.uploads.splice(pendingUploadIndex, 1);
          selectDraft(removed, false);
          if (removed.previewUrl) URL.revokeObjectURL(removed.previewUrl);
          updatePendingChangesUi();
          return;
        }
        if (!state.pendingChanges.deletes.some((item) => item.path === path)) {
          const entry = { path, label, pending: true, draftKind: "content-delete" };
          state.pendingChanges.deletes.push(entry);
          selectDraft(entry, true);
        }
        updatePendingChangesUi();
      };

      const isPendingDelete = (kind, path) => state.pendingMedia.deletes.some((item) => item.kind === kind && item.path === path);

      const assetPreviewUrl = (asset) => asset?.previewUrl || asset?.url || (asset?.publicPath ? assetUrl(asset.publicPath) : "");

      const assetPreviewForValue = (value = "") => {
        if (!value) return "";
        const item = state.pendingMedia.uploads.find((item) => mediaContentValue(item) === value);
        if (item) return item.previewUrl || mediaUrlFromPublicPath(value) || assetUrl(value);
        return mediaUrlFromPublicPath(value) || assetUrl(value);
      };

      const isInImmediateDirectory = (asset, currentRoot) => {
        const path = asset?.publicPath || "";
        if (!path.startsWith(`${currentRoot}/`)) return false;
        return !path.slice(currentRoot.length + 1).includes("/");
      };

      const visibleMediaAssets = (section) => {
        const config = mediaLibraries[section];
        if (!config) return [];
        const currentRoot = mediaCurrentPublicRoot(section);
        return [
          ...state.pendingMedia.uploads.filter((item) => item.kind === config.kind && isInImmediateDirectory(item, currentRoot)),
          ...state[config.stateKey].filter((asset) => !isPendingDelete(config.kind, asset.path)),
        ];
      };

      const visibleImages = () => visibleMediaAssets("images");

      const visibleVideos = () => visibleMediaAssets("videos");

      const setSelection = (kind, path, checked) => {
        const target = kind === "image" ? state.pendingMedia.selectedImages : state.pendingMedia.selectedVideos;
        if (checked) target.add(path);
        else target.delete(path);
        renderList();
      };

      const clearSelections = (kind) => {
        if (kind === "image") state.pendingMedia.selectedImages.clear();
        else state.pendingMedia.selectedVideos.clear();
      };

      const selectedAssets = (kind) => {
        const selected = kind === "image" ? state.pendingMedia.selectedImages : state.pendingMedia.selectedVideos;
        const assets = isMediaLibrarySection(state.section) ? visibleMediaAssets(state.section) : kind === "image" ? visibleImages() : visibleVideos();
        return assets.filter((asset) => selected.has(asset.path));
      };

      const loadMediaLibrarySection = async (section) => {
        if (section === "images") await loadImages();
        if (section === "personalPhotoAssets") await loadPersonalPhotoAssets();
        if (section === "videos") await loadVideos();
        if (section === "personalVideoAssets") await loadPersonalVideoAssets();
      };

      const parentPublicRoot = (section) => {
        const config = mediaLibraries[section];
        const currentRoot = mediaCurrentPublicRoot(section);
        if (currentRoot === config.publicRoot) return currentRoot;
        const parent = currentRoot.split("/").slice(0, -1).join("/");
        return parent || config.publicRoot;
      };

      const renderMediaDirectoryControls = (section) => {
        const config = mediaLibraries[section];
        const directory = mediaDirectoryState(section);
        const controls = $(`[data-media-directory-controls="${section}"]`);
        if (!config || !directory || !controls) return;
        const currentRoot = mediaCurrentPublicRoot(section);
        const currentNode = controls.querySelector(`[data-media-current-directory="${section}"]`);
        const parentButton = controls.querySelector(`[data-media-parent-folder="${section}"]`);
        const folderList = controls.querySelector(`[data-media-folder-list="${section}"]`);
        if (currentNode) currentNode.textContent = `${currentRoot}/`;
        if (parentButton) parentButton.disabled = currentRoot === config.publicRoot;
        if (!folderList) return;
        folderList.innerHTML = "";
        const folders = directory.folders || [];
        if (!folders.length) {
          folderList.innerHTML = `<span class="font-mono text-xs text-[var(--muted)]">NO_SUBDIRECTORIES</span>`;
          return;
        }
        folders.forEach((folder) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "orbit-button";
          button.dataset.mediaFolderCard = section;
          button.textContent = `${folder.name}/`;
          button.addEventListener("click", () => run(() => selectMediaDirectory(section, folder.publicPath)));
          folderList.append(button);
        });
      };

      const renderAllMediaDirectoryControls = () => Object.keys(mediaLibraries).forEach(renderMediaDirectoryControls);

      const selectMediaDirectory = async (section, publicRoot) => {
        const config = mediaLibraries[section];
        if (!config) return;
        const normalizedRoot = normalizePublicRoot(publicRoot);
        if (normalizedRoot !== config.publicRoot && !normalizedRoot.startsWith(`${config.publicRoot}/`)) {
          throw new Error("目录必须位于当前素材库根目录下。");
        }
        mediaDirectoryState(section).currentPublicRoot = normalizedRoot;
        clearSelections(config.kind);
        await loadMediaLibrarySection(section);
        if (config.kind === "image") selectImage(null);
        else selectVideo(null);
        updateCounts();
        renderList();
        renderMediaDirectoryControls(section);
        updatePendingMediaUi();
      };

      const createMediaFolder = async (section) => {
        const config = mediaLibraries[section];
        const input = $(`[data-media-folder-input="${section}"]`);
        const name = input?.value.trim().replace(/^\/+|\/+$/g, "");
        if (!config || !name) throw new Error("请输入目录名");
        if (name.includes("..") || name.includes("/") || name.includes("\\")) throw new Error("目录名不能包含 /、\\ 或 ..");
        if (mediaStorageMode() !== "r2") throw new Error("R2 目录管理需要先配置并连接 R2 素材库。");
        const nextRoot = `${mediaCurrentPublicRoot(section)}/${name}`;
        await mediaApiCreateFolder(nextRoot);
        if (input) input.value = "";
        await selectMediaDirectory(section, nextRoot);
        setStatus(`R2 目录已创建：${nextRoot}/`);
      };

      const updatePendingMediaUi = () => {
        for (const [section, config] of Object.entries(mediaLibraries)) {
          const count = pendingMediaCount(config.kind, config.publicRoot);
          const summary = $(`[data-media-pending-summary="${config.summaryKey}"]`);
          if (!summary) continue;
          summary.textContent = count.total
            ? "待同步操作：新增 " + count.uploads + "，删除 " + count.deletes + (mediaStorageMode() === "r2" ? "。点同步后会写入 R2。" : "。点同步后会合成一次 commit。")
            : section === "personalPhotoAssets"
              ? "暂无待同步 PersonalPhoto 文件操作。"
              : section === "personalVideoAssets"
                ? "暂无待同步 PersonalVideo 文件操作。"
                : config.kind === "image"
                  ? "暂无待同步图片操作。"
                  : "暂无待同步视频操作。";
        }
        $$('[data-sync-media]').forEach((button) => {
          button.disabled = allPendingMedia().length === 0;
        });
        updatePendingChangesUi();
      };

      const rememberOriginalContent = () => {
        state.original.posts = clone(state.posts);
        state.original.projects = clone(state.projects);
        state.original.recommendations = clone(state.recommendations);
        state.original.gallery = clone(state.gallery);
        state.original.personalVideos = clone(state.personalVideos);
        state.original.settings = clone(state.settings || INITIAL_DATA.settings);
      };

      const entityDiff = (currentItems, originalItems, identity) => {
        const currentMap = new Map(currentItems.map((item) => [identity(item), item]));
        const originalMap = new Map(originalItems.map((item) => [identity(item), item]));
        let added = 0;
        let updated = 0;
        let deleted = 0;
        currentMap.forEach((item, key) => {
          if (!originalMap.has(key)) {
            added += 1;
          } else if (JSON.stringify(item) !== JSON.stringify(originalMap.get(key))) {
            updated += 1;
          }
        });
        originalMap.forEach((_item, key) => {
          if (!currentMap.has(key)) deleted += 1;
        });
        return { added, updated, deleted };
      };

      const contentDraftStats = () => ({
        posts: entityDiff(state.posts, state.original.posts, (item) => item.path || item.name || postSlug(item)),
        projects: entityDiff(state.projects, state.original.projects, (item) => item.name || item.link || JSON.stringify(item)),
        recommendations: entityDiff(state.recommendations, state.original.recommendations, (item) => item.title || item.link || JSON.stringify(item)),
        gallery: entityDiff(state.gallery, state.original.gallery, (item) => item.image || item.title || JSON.stringify(item)),
        personalVideos: entityDiff(state.personalVideos, state.original.personalVideos, (item) => item.video || item.title || JSON.stringify(item)),
      });

      const statLine = (label, stat) => {
        const parts = [
          stat.added ? `新增 ${stat.added}` : "",
          stat.updated ? `修改 ${stat.updated}` : "",
          stat.deleted ? `删除 ${stat.deleted}` : "",
        ].filter(Boolean);
        return `${label}：${parts.length ? parts.join("，") : "无"}`;
      };

      const renderDraftStats = () => {
        const node = $("[data-draft-stats]");
        if (!node) return;
        const stats = contentDraftStats();
        const uploads = state.pendingMedia.uploads;
        const deletes = state.pendingMedia.deletes;
        const imageUploads = uploads.filter((item) => item.kind === "image").length;
        const videoUploads = uploads.filter((item) => item.kind === "video").length;
        const imageDeletes = deletes.filter((item) => item.kind === "image").length;
        const videoDeletes = deletes.filter((item) => item.kind === "video").length;
        node.innerHTML = `
          <div class="orbit-status-card border p-3">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Articles</p>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">${escapeHtml(statLine("文章", stats.posts))}</p>
          </div>
          <div class="orbit-status-card border p-3">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Photos</p>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">${escapeHtml(statLine("照片卡片", stats.gallery))}</p>
          </div>
          <div class="orbit-status-card border p-3">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Content</p>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">${escapeHtml(statLine("项目", stats.projects))}<br />${escapeHtml(statLine("推荐", stats.recommendations))}<br />${escapeHtml(statLine("视频记录", stats.personalVideos))}</p>
          </div>
          <div class="orbit-status-card border p-3">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Media</p>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">图片：上传 ${imageUploads}，删除 ${imageDeletes}<br />视频：上传 ${videoUploads}，删除 ${videoDeletes}</p>
          </div>
        `;
      };

      const draftKindLabel = (item) => {
        if (item.draftKind === "content-write") return "写入内容";
        if (item.draftKind === "content-delete") return "删除内容";
        if (item.draftKind === "media-upload") return item.kind === "video" ? "上传视频" : "上传图片";
        if (item.draftKind === "media-delete") return item.kind === "video" ? "删除视频" : "删除图片";
        return "待处理";
      };

      const firstImageFromExport = (content, exportName, getImage) => {
        try {
          const entries = readExportedValue(content || "", exportName);
          if (!Array.isArray(entries)) return "";
          const entry = entries.find((candidate) => getImage(candidate));
          return assetPreviewForValue(getImage(entry));
        } catch {
          return "";
        }
      };

      const draftPreviewForContent = (item) => {
        if (item.previewValue) return assetPreviewForValue(item.previewValue);
        if (item.path?.startsWith(`${POSTS_PATH}/`)) return assetPreviewForValue(parseFrontmatter(item.content || "").data.cover);
        if (item.path === RECOMMENDATIONS_PATH) {
          try {
            const entries = readExportedValue(item.content || "", "recommendations");
            const entry = Array.isArray(entries) ? entries.find((candidate) => candidate?.image) : null;
            return assetPreviewForValue(entry?.image);
          } catch {
            return "";
          }
        }
        if (item.path === GALLERY_PATH) return firstImageFromExport(item.content, "galleryItems", (entry) => entry?.image);
        if (item.path === PERSONAL_VIDEOS_DATA_PATH) return firstImageFromExport(item.content, "videoItems", (entry) => entry?.poster);
        if (item.path === SETTINGS_PATH) return "";
        return "";
      };

      const renderDrafts = () => {
        renderDraftStats();
        const node = $("[data-draft-list]");
        if (!node) return;
        const items = allPendingChanges();
        if (!items.length) {
          node.innerHTML = `<p class="text-sm text-[var(--muted)]">暂无本地保存。</p>`;
          return;
        }
        node.innerHTML = "";
        items.forEach((item) => {
          const id = draftChangeId(item);
          const selected = state.pendingDraftSelection.has(id);
          const card = document.createElement("article");
          card.className = "orbit-card quiet-card grid gap-3 p-3 md:grid-cols-[auto_96px_minmax(0,1fr)_auto] md:items-center";
          const isMediaDraft = item.draftKind === "media-upload" || item.draftKind === "media-delete";
          const contentPreviewUrl = item.draftKind?.startsWith("content-") ? draftPreviewForContent(item) : "";
          const preview = isMediaDraft && item.kind === "image"
            ? `<img class="aspect-[4/3] w-24 rounded border border-[var(--line)] object-cover" src="${assetPreviewUrl(item)}" alt="" />`
            : isMediaDraft && item.kind === "video"
              ? `<video class="aspect-video w-24 rounded border border-[var(--line)] bg-black object-cover" src="${assetPreviewUrl(item)}" preload="metadata" muted playsinline></video>`
              : contentPreviewUrl
                ? `<img class="aspect-[4/3] w-24 rounded border border-[var(--line)] object-cover" src="${contentPreviewUrl}" alt="" />`
                : `<div class="grid aspect-[4/3] w-24 place-items-center rounded border border-[var(--line)] bg-[var(--surface-soft)] font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">Content</div>`;
          card.innerHTML = `
            <label class="flex items-center gap-2 text-sm text-[var(--muted)]">
              <input data-draft-selected="${escapeHtml(id)}" type="checkbox" ${selected ? "checked" : ""} />
              <span>选择</span>
            </label>
            ${preview}
            <div class="min-w-0">
              <p class="font-semibold">${escapeHtml(item.label || item.name || item.publicPath || item.path || "未命名改动")}</p>
              <p class="mt-1 font-mono text-xs uppercase tracking-[0.16em] text-[var(--muted)]">${escapeHtml(draftKindLabel(item))}</p>
              <p class="mt-2 break-all font-mono text-xs text-[var(--muted)]">${escapeHtml(item.publicPath || item.path || "")}</p>
            </div>
            <button class="orbit-button orbit-danger" data-draft-remove="${escapeHtml(id)}" type="button">取消</button>
          `;
          card.querySelector("[data-draft-selected]").addEventListener("change", (event) => {
            if (event.target.checked) state.pendingDraftSelection.add(id);
            else state.pendingDraftSelection.delete(id);
            updatePendingChangesUi();
          });
          card.querySelector("[data-draft-remove]").addEventListener("click", () => removePendingChange(id));
          node.append(card);
        });
      };

      const updatePendingChangesUi = () => {
        const contentFiles = state.pendingChanges.files.length;
        const contentDeletes = state.pendingChanges.deletes.length;
        const uploads = state.pendingMedia.uploads.length;
        const mediaDeletes = state.pendingMedia.deletes.length;
        const total = contentFiles + contentDeletes + uploads + mediaDeletes;
        if (pendingSummary) {
          pendingSummary.textContent = total
            ? `待同步：写入 ${contentFiles} 个内容文件，删除 ${contentDeletes} 个内容文件，上传 ${uploads} 个媒体文件，删除 ${mediaDeletes} 个媒体文件。`
            : "暂无待同步改动。";
        }
        const button = $("[data-sync-all]");
        if (button) button.disabled = total === 0;
        const selectedButton = $("[data-sync-selected-drafts]");
        if (selectedButton) selectedButton.disabled = selectedPendingChanges().length === 0;
        updateCounts();
        renderDrafts();
        renderUiPresetSelection();
      };

      const cancelPendingMediaPickOutside = (section) => {
        let cancelled = false;
        if (state.pendingImagePick && state.pendingImagePick.section !== section) {
          state.pendingImagePick = null;
          cancelled = true;
        }
        if (state.pendingVideoPick && state.pendingVideoPick.section !== section) {
          state.pendingVideoPick = null;
          cancelled = true;
        }
        return cancelled;
      };

      const selectSection = (section) => {
        const cancelledMediaPick = cancelPendingMediaPickOutside(section);
        state.section = section;
        $$("[data-section]").forEach((button) => {
          const group = button.dataset.sectionGroup;
          const active =
            button.dataset.section === section ||
            (group === "articleAssets" && ["images", "videos"].includes(section)) ||
            (group === "gallery" && ["gallery", "personalPhotoAssets"].includes(section)) ||
            (group === "personalVideos" && ["personalVideos", "personalVideoAssets"].includes(section));
          button.dataset.active = String(active);
        });
        $$("[data-switch-section]").forEach((button) => {
          button.dataset.active = String(button.dataset.switchSection === section);
        });
        $$("[data-view]").forEach((view) => {
          view.hidden = view.dataset.view !== section;
        });
        listKicker.textContent = labels[section].kicker;
        listTitle.textContent = labels[section].title;
        const newButton = $("[data-new-current]");
        newButton.hidden = isMediaLibrarySection(section) || section === "drafts" || section === "pageCopy";
        newButton.textContent = section === "settings" ? "save" : "new";
        renderList();
        if (cancelledMediaPick) setStatus("已取消尚未完成的素材选择，未修改任何字段。");
      };

      const renderList = () => {
        list.innerHTML = "";
        const section = state.section;
        const items =
          section === "posts"
            ? state.posts
            : section === "projects"
              ? state.projects
              : section === "recommendations"
                ? state.recommendations
                : section === "gallery"
                  ? state.gallery
                  : section === "personalVideos"
                    ? state.personalVideos
                    : isMediaLibrarySection(section)
                      ? visibleMediaAssets(section)
                      : [];

        if (!items.length) {
          list.innerHTML = `<p class="text-sm text-[var(--muted)]">${labels[section].empty}</p>`;
          renderMediaGrids();
          return;
        }

        items.forEach((item, index) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "orbit-card quiet-card p-3 text-left transition hover:border-[var(--foreground)]";
          if (section === "posts") {
            button.dataset.active = String(state.current.post?.path === item.path);
            const meta = [
              formatDate(item.data?.publishDate),
              ...(Array.isArray(item.data?.tags) ? item.data.tags : []),
            ].filter(Boolean);
            button.innerHTML = `
              <p class="font-semibold leading-snug">${escapeHtml(postDisplayTitle(item))}</p>
              ${item.data?.description ? `<p class="mt-2 text-sm leading-6 text-[var(--muted)]">${escapeHtml(item.data.description)}</p>` : ""}
              <p class="mt-2 font-mono text-xs text-[var(--muted)]">${escapeHtml(meta.join(" · "))}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">slug: ${escapeHtml(postSlug(item))}</p>
            `;
            button.addEventListener("click", () => loadPost(item));
          } else if (section === "projects") {
            button.dataset.active = String(state.current.projectIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.name || "未命名项目")}</p>
              <p class="mt-1 text-sm text-[var(--muted)]">${escapeHtml(item.year || "")} · ${(item.tags || []).map(escapeHtml).join(", ")}</p>
            `;
            button.addEventListener("click", () => fillProject(index));
          } else if (section === "recommendations") {
            button.dataset.active = String(state.current.recommendationIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.title || "未命名推荐")}</p>
              <p class="mt-1 text-sm text-[var(--muted)]">${escapeHtml(item.category || "other")} · ${escapeHtml(item.creator || "")} ${item.year ? `· ${escapeHtml(item.year)}` : ""}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">${escapeHtml(item.image || "")}</p>
            `;
            button.addEventListener("click", () => fillRecommendation(index));
          } else if (section === "gallery") {
            button.dataset.active = String(state.current.galleryIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.title || "未命名照片")}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">${escapeHtml(item.image || "")}</p>
            `;
            button.addEventListener("click", () => fillGallery(index));
          } else if (section === "personalVideos") {
            button.dataset.active = String(state.current.personalVideoIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.title || "未命名视频")}</p>
              <p class="mt-1 text-sm text-[var(--muted)]">${escapeHtml(item.date || "")}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">${escapeHtml(item.video || "")}</p>
            `;
            button.addEventListener("click", () => fillPersonalVideo(index));
          } else if (isMediaLibrarySection(section) && mediaLibraries[section].kind === "image") {
            button.dataset.active = String(state.current.image?.path === item.path);
            button.innerHTML = `
              <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
                <input data-image-select type="checkbox" ${state.pendingMedia.selectedImages.has(item.path) ? "checked" : ""} />
                <span>${item.pending ? "待新增" : "选择"}</span>
              </label>
              <div class="mb-2 overflow-hidden rounded border border-[var(--line)] bg-black">
                <img class="aspect-[16/10] w-full object-cover" src="${assetPreviewUrl(item)}" alt="" loading="lazy" />
              </div>
              <p class="break-all font-mono text-xs">${escapeHtml(item.publicPath)}</p>
            `;
            button.querySelector("[data-image-select]").addEventListener("click", (event) => event.stopPropagation());
            button.querySelector("[data-image-select]").addEventListener("change", (event) => setSelection("image", item.path, event.target.checked));
            button.addEventListener("click", () => selectImage(item));
          } else if (isMediaLibrarySection(section) && mediaLibraries[section].kind === "video") {
            button.dataset.active = String(state.current.video?.path === item.path);
            button.innerHTML = `
              <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
                <input data-video-select type="checkbox" ${state.pendingMedia.selectedVideos.has(item.path) ? "checked" : ""} />
                <span>${item.pending ? "待新增" : "选择"}</span>
              </label>
              <div class="mb-2 overflow-hidden rounded border border-[var(--line)] bg-black">
                <video class="aspect-video w-full object-cover" src="${assetPreviewUrl(item)}" preload="metadata" muted playsinline></video>
              </div>
              <p class="break-all font-mono text-xs">${escapeHtml(item.publicPath)}</p>
            `;
            button.querySelector("[data-video-select]").addEventListener("click", (event) => event.stopPropagation());
            button.querySelector("[data-video-select]").addEventListener("change", (event) => setSelection("video", item.path, event.target.checked));
            button.addEventListener("click", () => selectVideo(item));
          }
          list.append(button);
        });
        renderMediaGrids();
        updatePendingMediaUi();
      };

      const renderMediaGrid = (section) => {
        const config = mediaLibraries[section];
        const grid = $(`[data-media-grid="${section}"]`);
        if (!config || !grid) return;
        grid.innerHTML = "";
        const folders = mediaDirectoryState(section)?.folders || [];
        const assets = visibleMediaAssets(section);
        if (!folders.length && !assets.length) {
          grid.innerHTML = `<p class="text-sm text-[var(--muted)]">${config.empty}</p>`;
          updatePendingMediaUi();
          renderMediaDirectoryControls(section);
          return;
        }
        folders.forEach((folder) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "orbit-card quiet-card p-4 text-left transition hover:border-[var(--foreground)]";
          button.dataset.mediaFolderCard = section;
          button.innerHTML = `
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">FOLDER</p>
            <p class="mt-3 break-all text-lg font-semibold">${escapeHtml(folder.name)}/</p>
            <p class="mt-2 break-all font-mono text-xs text-[var(--muted)]">${escapeHtml(folder.publicPath)}/</p>
          `;
          button.addEventListener("click", () => run(() => selectMediaDirectory(section, folder.publicPath)));
          grid.append(button);
        });
        assets.forEach((asset) => {
          if (config.kind === "image") {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "orbit-card quiet-card overflow-hidden p-2 text-left transition hover:border-[var(--foreground)]";
            button.dataset.active = String(state.current.image?.path === asset.path);
            button.innerHTML = `
              <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
                <input data-image-select type="checkbox" ${state.pendingMedia.selectedImages.has(asset.path) ? "checked" : ""} />
                <span>${asset.pending ? "待新增" : "选择"}</span>
              </label>
              <div class="overflow-hidden rounded border border-[var(--line)] bg-black">
                <img class="aspect-[4/3] w-full object-cover" src="${assetPreviewUrl(asset)}" alt="" loading="lazy" />
              </div>
              <p class="mt-2 break-all font-mono text-xs">${escapeHtml(asset.publicPath)}</p>
            `;
            button.querySelector("[data-image-select]").addEventListener("click", (event) => event.stopPropagation());
            button.querySelector("[data-image-select]").addEventListener("change", (event) => setSelection("image", asset.path, event.target.checked));
            button.addEventListener("click", () => selectImage(asset));
            grid.append(button);
          } else {
            const card = document.createElement("div");
            card.className = "orbit-card quiet-card overflow-hidden p-2 text-left transition hover:border-[var(--foreground)]";
            card.dataset.active = String(state.current.video?.path === asset.path);
            card.dataset.videoAssetCard = "true";
            card.tabIndex = 0;
            card.setAttribute("role", "button");
            card.innerHTML = `
              <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
                <input data-video-select type="checkbox" ${state.pendingMedia.selectedVideos.has(asset.path) ? "checked" : ""} />
                <span>${asset.pending ? "待新增" : "选择"}</span>
              </label>
              <div class="overflow-hidden rounded border border-[var(--line)] bg-black">
                <video class="aspect-video w-full object-cover" src="${assetPreviewUrl(asset)}" controls playsinline preload="metadata"></video>
              </div>
              <p class="mt-2 break-all font-mono text-xs">${escapeHtml(asset.publicPath)}</p>
            `;
            card.querySelector("[data-video-select]").addEventListener("click", (event) => event.stopPropagation());
            card.querySelector("[data-video-select]").addEventListener("change", (event) => setSelection("video", asset.path, event.target.checked));
            card.addEventListener("click", (event) => {
              if (event.target.closest("video") || event.target.closest("[data-media-select-wrapper]")) return;
              selectVideo(asset);
            });
            card.addEventListener("keydown", (event) => {
              if (event.key !== "Enter" && event.key !== " ") return;
              event.preventDefault();
              selectVideo(asset);
            });
            grid.append(card);
          }
        });
        renderMediaDirectoryControls(section);
        updatePendingMediaUi();
      };

      const renderMediaGrids = () => {
        Object.keys(mediaLibraries).forEach(renderMediaGrid);
        renderAllMediaDirectoryControls();
      };

      const renderImageGrid = () => renderMediaGrid("images");

      const renderVideoGrid = () => {
        renderMediaGrid("videos");
      };

      const loadPosts = async () => {
        const files = await getDir(POSTS_PATH);
        const postFiles = files.filter((file) => /\.(md|mdx)$/.test(file.name));
        state.posts = await Promise.all(
          postFiles.map(async (item) => {
            const file = await getFile(item.path);
            const parsed = parseFrontmatter(fromBase64(file.content));
            return {
              ...item,
              sha: file.sha,
              data: parsed.data,
              body: parsed.body,
            };
          }),
        );
        state.posts.sort((a, b) => new Date(b.data?.publishDate || 0).valueOf() - new Date(a.data?.publishDate || 0).valueOf());
      };

      const loadProjects = async () => {
        const file = await getFile(PROJECTS_PATH);
        state.files.projects = file;
        state.projects = readExportedArray(fromBase64(file.content), "projects");
      };

      const loadRecommendations = async () => {
        const file = await getFile(RECOMMENDATIONS_PATH);
        state.files.recommendations = file;
        state.recommendations = readExportedArray(fromBase64(file.content), "recommendations");
      };

      const loadGallery = async () => {
        const file = await getFile(GALLERY_PATH);
        state.files.gallery = file;
        state.gallery = readExportedArray(fromBase64(file.content), "galleryItems").filter((item) => isPersonalPhotoValue(item.image));
      };

      const loadPersonalVideos = async () => {
        const file = await getFile(PERSONAL_VIDEOS_DATA_PATH);
        state.files.personalVideos = file;
        state.personalVideos = readExportedArray(fromBase64(file.content), "videoItems");
      };

      const loadSettings = async () => {
        const file = await getFile(SETTINGS_PATH);
        state.files.settings = file;
        state.settings = readExportedValue(fromBase64(file.content), "siteSettings");
        fillSettings();
      };

      const loadImages = async () => {
        const currentRoot = mediaCurrentPublicRoot("images");
        if (mediaStorageMode() === "r2") {
          state.images = mergeMediaAssets(currentRoot === "/article-assets" ? INITIAL_DATA.images : [], await mediaApiList(currentRoot));
          return;
        }
        const files = await getDir(mediaTargetDirectory("images"));
        state.images = files
          .filter((file) => file.type === "file" && /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(file.name))
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((file) => ({ ...file, publicPath: `${currentRoot}/${file.name}` }));
      };

      const loadPersonalPhotoAssets = async () => {
        const currentRoot = mediaCurrentPublicRoot("personalPhotoAssets");
        if (mediaStorageMode() === "r2") {
          state.personalPhotoAssets = mergeMediaAssets(currentRoot === "/personal-photo" ? INITIAL_DATA.personalPhotoAssets : [], await mediaApiList(currentRoot));
          return;
        }
        const files = await getDir(mediaTargetDirectory("personalPhotoAssets"));
        state.personalPhotoAssets = files
          .filter((file) => file.type === "file" && /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(file.name))
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((file) => ({ ...file, publicPath: `${currentRoot}/${file.name}` }));
      };

      const loadVideos = async () => {
        const currentRoot = mediaCurrentPublicRoot("videos");
        if (mediaStorageMode() === "r2") {
          state.videos = mergeMediaAssets(currentRoot === "/article-videos" ? INITIAL_DATA.videos : [], await mediaApiList(currentRoot));
          return;
        }
        const files = await getDir(mediaTargetDirectory("videos"));
        state.videos = files
          .filter((file) => file.type === "file" && /\.(mp4|webm|mov|m4v)$/i.test(file.name))
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((file) => ({ ...file, publicPath: `${currentRoot}/${file.name}` }));
      };

      const loadPersonalVideoAssets = async () => {
        const currentRoot = mediaCurrentPublicRoot("personalVideoAssets");
        if (mediaStorageMode() === "r2") {
          state.personalVideoAssets = mergeMediaAssets(currentRoot === "/personal-video" ? INITIAL_DATA.personalVideoAssets : [], await mediaApiList(currentRoot));
          return;
        }
        const files = await getDir(mediaTargetDirectory("personalVideoAssets"));
        state.personalVideoAssets = files
          .filter((file) => file.type === "file" && /\.(mp4|webm|mov|m4v)$/i.test(file.name))
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((file) => ({ ...file, publicPath: `${currentRoot}/${file.name}` }));
      };

      const loadAllMediaLibraries = async () => {
        await Promise.all([loadImages(), loadPersonalPhotoAssets(), loadVideos(), loadPersonalVideoAssets()]);
      };

      const refreshAfterMediaSync = async (successStatus, refreshFailedStatus) => {
        try {
          await loadAllMediaLibraries();
        } catch (error) {
          selectImage(null);
          selectVideo(null);
          updateCounts();
          renderList();
          updatePendingChangesUi();
          setStatus(`${refreshFailedStatus}：${describeMediaError(error)} 请刷新页面后确认 R2 素材库。`);
          return false;
        }
        selectImage(null);
        selectVideo(null);
        updateCounts();
        renderList();
        updatePendingChangesUi();
        setStatus(successStatus);
        return true;
      };

      const applyInitialMediaLibraries = () => {
        state.images = clone(INITIAL_DATA.images);
        state.personalPhotoAssets = clone(INITIAL_DATA.personalPhotoAssets);
        state.videos = clone(INITIAL_DATA.videos);
        state.personalVideoAssets = clone(INITIAL_DATA.personalVideoAssets);
      };

      const loadContentFiles = async () => {
        await Promise.all([
          loadPosts(),
          loadProjects(),
          loadRecommendations(),
          loadGallery(),
          loadPersonalVideos(),
          loadSettings(),
        ]);
      };

      const loadMediaLibrariesSafely = async () => {
        if (mediaStorageMode() === "r2" && !state.mediaToken) {
          applyInitialMediaLibraries();
          return "R2 素材库需要 Media Token，当前只显示仓库内置兜底素材。";
        }
        try {
          await loadAllMediaLibraries();
          return mediaStorageMode() === "r2" ? "R2 素材库已连接。" : "仓库素材库已加载。";
        } catch (error) {
          applyInitialMediaLibraries();
          return `素材库暂时没有加载成功：${error instanceof Error ? error.message : "未知错误"}。文章、主页照片条目和页面配置仍可编辑。`;
        }
      };

      const applyInitialData = () => {
        state.posts = clone(INITIAL_DATA.posts);
        state.projects = clone(INITIAL_DATA.projects);
        state.recommendations = clone(INITIAL_DATA.recommendations);
        state.gallery = clone(INITIAL_DATA.gallery).filter((item) => isPersonalPhotoValue(item.image));
        state.personalVideos = clone(INITIAL_DATA.personalVideos);
        applyInitialMediaLibraries();
        state.settings = clone(INITIAL_DATA.settings);
        state.files.projects = null;
        state.files.recommendations = null;
        state.files.gallery = null;
        state.files.personalVideos = null;
        state.files.settings = null;
        fillSettings();
        rememberOriginalContent();
        updateCounts();
        renderList();
        if (!state.current.post) newPost();
        if (state.current.projectIndex < 0) newProject();
        if (state.current.recommendationIndex < 0) newRecommendation();
        if (state.current.galleryIndex < 0) newGallery();
        if (state.current.personalVideoIndex < 0) newPersonalVideo();
      };

      const loadAll = async () => {
        if (!state.token) {
          state.remoteContentReady = false;
          setStatus("读取当前网站内置内容中...");
          applyInitialData();
          if (mediaStorageMode() === "r2" && state.mediaToken) {
            const mediaStatus = await loadMediaLibrariesSafely();
            updateCounts();
            renderList();
            setStatus(`${mediaStatus} 发布文章和页面数据仍需要 GitHub Token。`);
            return false;
          }
          setStatus("只读模式：内容已加载。线上保存、删除、上传需要 GitHub Token；R2 素材库需要 Media Token。");
          return false;
        }

        state.mode = "github";
        state.remoteContentReady = false;
        setStatus("GitHub 模式：同步仓库内容中...");
        applyInitialData();
        try {
          await loadContentFiles();
          rememberOriginalContent();
        } catch (error) {
          const mediaStatus = await loadMediaLibrariesSafely();
          updateCounts();
          renderList();
          setStatus(`已先显示构建时内置内容。GitHub 内容同步失败：${error instanceof Error ? error.message : "未知错误"}。${mediaStatus}`);
          return false;
        }
        state.remoteContentReady = true;
        const mediaStatus = await loadMediaLibrariesSafely();
        updateCounts();
        renderList();
        if (!state.current.post) newPost();
        if (state.current.projectIndex < 0) newProject();
        if (state.current.recommendationIndex < 0) newRecommendation();
        if (state.current.galleryIndex < 0) newGallery();
        if (state.current.personalVideoIndex < 0) newPersonalVideo();
        setStatus(`GitHub 模式已连接。${mediaStatus} 分项操作会先暂存在当前页面，点“同步全部改动”后才提交到 main 分支。`);
        return true;
      };

      const uiPresetCatalogEntry = (presetId) =>
        availableUiPresets.find((preset) => preset.id === presetId);

      const uiPresetSettings = (settings, presetId) =>
        settings?.ui?.presets?.[presetId] || {};

      const uiPresetLabel = (
        presetId,
        settings = state.settings || state.original.settings || INITIAL_DATA.settings,
      ) =>
        String(uiPresetSettings(settings, presetId).displayName || "").trim() ||
        uiPresetCatalogEntry(presetId)?.label ||
        presetId ||
        "未设置";

      const uiPresetWorkspaceLabel = (
        presetId,
        settings = state.settings || state.original.settings || INITIAL_DATA.settings,
      ) => {
        const displayNameField = uiAppearanceFields.find(
          (field) =>
            field.dataset.uiAppearancePreset === presetId &&
            field.dataset.uiAppearanceField === UI_PRESET_DISPLAY_NAME_FIELD.path,
        );
        if (!displayNameField) return uiPresetLabel(presetId, settings);
        return (
          String(displayNameField.value || "").trim() ||
          uiPresetCatalogEntry(presetId)?.label ||
          presetId ||
          "未设置"
        );
      };

      const uiPresetCode = (presetId) =>
        uiPresetCatalogEntry(presetId)?.code || presetId || "";

      const uiPackageAppearanceFieldDefinitions = (presetId) =>
        uiPresetCatalogEntry(presetId)?.appearanceFields || [];

      const uiAppearanceFieldDefinitions = (presetId) =>
        [UI_PRESET_DISPLAY_NAME_FIELD, ...uiPackageAppearanceFieldDefinitions(presetId)];

      const validateUiAppearanceSettings = (settings, presetId) => {
        const presetSettings = uiPresetSettings(settings, presetId);
        uiAppearanceFieldDefinitions(presetId).forEach((field) => {
          const value = getByPath(presetSettings, field.path);
          const error = appearanceFieldValueError(field, value, { mediaLibraries });
          if (error) {
            throw new Error(`UI ${uiPresetCode(presetId)} 的${field.label}${error}`);
          }
        });
      };

      const uiAppearancePreviewValue = (settings, presetId) => {
        const presetSettings = uiPresetSettings(settings, presetId);
        return firstAppearanceImageValue(
          presetSettings,
          uiAppearanceFieldDefinitions(presetId),
        );
      };

      const renderUiAppearanceEditor = () => {
        const presetId = state.uiAppearancePreset;
        $$("[data-ui-appearance-panel]").forEach((panel) => {
          panel.hidden = panel.dataset.uiAppearancePanel !== presetId;
        });
        if (uiAppearanceSelect && uiAppearanceSelect.value !== presetId) {
          uiAppearanceSelect.value = presetId;
        }
        const statusNode = $("[data-ui-appearance-status]");
        if (statusNode) {
          statusNode.textContent = state.uiAppearanceDirty
            ? `UI ${uiPresetCode(presetId)} 名称或参数有未保存输入。请先保存或恢复后再切换编辑目标。`
            : !uiPackageAppearanceFieldDefinitions(presetId).length
            ? `正在编辑 UI ${uiPresetCode(presetId)} · ${uiPresetWorkspaceLabel(presetId)} 的名称；这个 UI 没有其他专属参数。`
            : `正在编辑 UI ${uiPresetCode(presetId)} · ${uiPresetWorkspaceLabel(presetId)} 的专属参数。`;
        }
      };

      const uiAppearanceControlValue = (field) => {
        if (field.type === "checkbox") return field.checked;
        if (field.dataset.uiAppearanceMissing === "true" && ["range", "color"].includes(field.type)) return "";
        return field.value;
      };

      const setUiAppearanceControlValue = (field, value) => {
        const missing = value == null;
        if (missing) field.dataset.uiAppearanceMissing = "true";
        else delete field.dataset.uiAppearanceMissing;
        if (field.type === "checkbox") {
          field.checked = Boolean(value);
        } else if (missing && field.type === "color") {
          field.value = "#000000";
        } else if (missing && field.type === "range") {
          field.value = field.min || "0";
        } else {
          field.value = value ?? "";
        }
      };

      const fillUiAppearanceSettings = () => {
        const settings = state.settings || clone(INITIAL_DATA.settings);
        uiAppearanceFields.forEach((field) => {
          const presetId = field.dataset.uiAppearancePreset;
          const fieldPath = field.dataset.uiAppearanceField;
          setUiAppearanceControlValue(
            field,
            getByPath(uiPresetSettings(settings, presetId), fieldPath),
          );
        });
        state.uiAppearanceDirty = false;
        renderUiAppearanceEditor();
      };

      const uiAppearanceInputIsDirty = (field, settings = state.settings || INITIAL_DATA.settings) => {
        const presetId = field.dataset.uiAppearancePreset;
        const fieldPath = field.dataset.uiAppearanceField;
        const storedValue = getByPath(uiPresetSettings(settings, presetId), fieldPath);
        return field.type === "checkbox"
          ? uiAppearanceControlValue(field) !== Boolean(storedValue)
          : uiAppearanceControlValue(field) !== String(storedValue ?? "");
      };

      const uiAppearanceInputsAreDirty = () => {
        const settings = state.settings || INITIAL_DATA.settings;
        return uiAppearanceFields.some((field) => uiAppearanceInputIsDirty(field, settings));
      };

      const collectUiAppearanceSettings = (presetId = state.uiAppearancePreset) => {
        const settings = clone(state.settings || INITIAL_DATA.settings);
        const preset = availableUiPresets.find((item) => item.id === presetId);
        if (!preset) throw new Error("这个 UI 包不存在或已被移除");
        const presetSettings = clone(uiPresetSettings(settings, presetId));
        presetSettings.settingsVersion = preset.settingsVersion;
        uiAppearanceFields
          .filter((field) => field.dataset.uiAppearancePreset === presetId)
          .forEach((field) => {
            const fieldPath = field.dataset.uiAppearanceField;
            const fieldDefinition = uiAppearanceFieldDefinitions(presetId)
              .find((item) => item.path === fieldPath);
            if (!fieldDefinition) {
              throw new Error(`UI ${uiPresetCode(presetId)} 的参数定义已经失效，请刷新页面`);
            }
            if (field.dataset.uiAppearanceMissing === "true" && !fieldDefinition?.required) return;
            setByPath(
              presetSettings,
              fieldPath,
              normalizeAppearanceInputValue(
                fieldDefinition,
                uiAppearanceControlValue(field),
              ),
            );
          });
        if (!settings.ui || typeof settings.ui !== "object") settings.ui = {};
        if (!settings.ui.presets || typeof settings.ui.presets !== "object") settings.ui.presets = {};
        settings.ui.presets[presetId] = presetSettings;
        return settings;
      };

      const validateUiAppearanceControls = (presetId) => {
        const invalidField = uiAppearanceFields.find(
          (field) => field.dataset.uiAppearancePreset === presetId && !field.checkValidity(),
        );
        if (!invalidField) return;
        invalidField.reportValidity();
        const definition = uiAppearanceFieldDefinitions(presetId)
          .find((field) => field.path === invalidField.dataset.uiAppearanceField);
        throw new Error(`请检查 UI ${uiPresetCode(presetId)} 的${definition?.label || "专属参数"}`);
      };

      const saveUiAppearanceSettings = async () => {
        if (state.uiPresetDeploying) throw new Error("UI 正在部署，请等待本次提交完成");
        requireWriteAccess();
        const presetId = state.uiAppearancePreset;
        validateUiAppearanceControls(presetId);
        const settings = collectUiAppearanceSettings(presetId);
        validateUiAppearanceSettings(settings, presetId);
        queueSettingsChange({
          content: stringifySettingsModule(settings),
          scope: `ui:${presetId}`,
          scopeLabel: `UI ${uiPresetCode(presetId)} 名称与参数`,
          previewValue: uiAppearancePreviewValue(settings, presetId),
        });
        state.settings = settings;
        state.uiAppearanceDirty = false;
        fillUiAppearanceSettings();
        renderUiPresetSelection();
        setStatus(`UI ${uiPresetCode(presetId)} 名称与专属参数已暂存，其他 UI 未修改。确认后点“同步全部改动”。`);
      };

      const selectUiAppearancePreset = (presetId) => {
        if (!uiPresetIds.has(presetId)) throw new Error("这个 UI 包不存在或已被移除");
        if (presetId === state.uiAppearancePreset) return;
        if (state.uiAppearanceDirty) {
          if (uiAppearanceSelect) uiAppearanceSelect.value = state.uiAppearancePreset;
          throw new Error("当前 UI 参数有未保存输入。请先保存，再切换编辑目标。");
        }
        state.uiAppearancePreset = presetId;
        renderUiAppearanceEditor();
      };

      const renderUiPresetSelection = () => {
        if (!uiPresetSelect) return;
        const settingsPending = state.pendingChanges.files.some((item) => item.path === SETTINGS_PATH);
        const displaySettings = state.settings || state.original.settings || INITIAL_DATA.settings;
        const onlineSettings =
          (settingsPending ? state.original.settings : state.settings) ||
          state.original.settings ||
          INITIAL_DATA.settings;
        const onlinePreset =
          onlineSettings?.ui?.activePreset ||
          state.original.settings?.ui?.activePreset ||
          INITIAL_DATA.settings?.ui?.activePreset ||
          "";
        const selectedPreset = uiPresetSelect.value;
        const deploying = state.uiPresetDeploying;
        const deployTarget = state.uiPresetDeployTarget;
        const presetManager = $("[data-ui-preset-manager]");
        if (presetManager) presetManager.setAttribute("aria-busy", String(deploying));

        $$("[data-ui-preset-card]").forEach((card) => {
          card.dataset.active = String(card.dataset.uiPresetCard === selectedPreset);
        });
        $$("[data-ui-preset-label]").forEach((label) => {
          label.textContent = uiPresetWorkspaceLabel(label.dataset.uiPresetLabel, displaySettings);
        });
        $$("[data-ui-preset-option]").forEach((option) => {
          const presetId = option.dataset.uiPresetOption;
          option.textContent = `UI ${uiPresetCode(presetId)} · ${uiPresetWorkspaceLabel(presetId, displaySettings)}`;
        });
        $$("[data-ui-preset-default-badge]").forEach((badge) => {
          badge.hidden = badge.dataset.uiPresetDefaultBadge !== onlinePreset;
        });
        $$("[data-ui-preset-set-default]").forEach((button) => {
          const presetId = button.dataset.uiPresetSetDefault;
          const presetCode = uiPresetCode(presetId);
          const isOnline = presetId === onlinePreset;
          button.disabled = deploying || isOnline || settingsPending || state.sharedSettingsDirty || state.uiAppearanceDirty;
          button.textContent = deploying
            ? presetId === deployTarget
              ? `正在部署 UI ${presetCode}…`
              : `UI ${uiPresetCode(deployTarget)} 部署中，暂不可操作`
            : isOnline
              ? `UI ${presetCode} 已是线上默认`
              : settingsPending
                ? "请先处理页面配置草稿"
                : `一键部署上线 UI ${presetCode}`;
        });
        uiPresetSelect.disabled = deploying;
        $$("[data-save-settings]").forEach((button) => {
          button.disabled = deploying;
        });
        $$("[data-save-ui-appearance]").forEach((button) => {
          button.disabled = deploying || uiAppearanceFieldDefinitions(state.uiAppearancePreset).length === 0;
        });
        const newCurrentButton = $("[data-new-current]");
        if (newCurrentButton) newCurrentButton.disabled = deploying;
        $$("[data-sync-media]").forEach((button) => {
          button.disabled = deploying || allPendingMedia().length === 0;
        });
        const syncAllButton = $("[data-sync-all]");
        if (syncAllButton) syncAllButton.disabled = deploying || allPendingChanges().length === 0;
        const syncSelectedButton = $("[data-sync-selected-drafts]");
        if (syncSelectedButton) syncSelectedButton.disabled = deploying || selectedPendingChanges().length === 0;

        const currentBuild = $("[data-ui-current-build]");
        if (currentBuild) {
          currentBuild.textContent = `UI ${uiPresetCode(INITIAL_DATA.currentBuildPreset)} · ${uiPresetWorkspaceLabel(INITIAL_DATA.currentBuildPreset, displaySettings)}`;
        }
        const onlineDefault = $("[data-ui-online-default]");
        if (onlineDefault) {
          onlineDefault.textContent = `UI ${uiPresetCode(onlinePreset)} · ${uiPresetLabel(onlinePreset, onlineSettings)}`;
        }

        const localStatus = $("[data-ui-preset-status]");
        if (!localStatus) return;
        if (deploying) {
          localStatus.textContent = `正在部署「${uiPresetWorkspaceLabel(deployTarget)}」（UI ${uiPresetCode(deployTarget)}）。部署按钮与同步入口已临时锁定，请勿重复操作。`;
        } else if (state.sharedSettingsDirty || state.uiAppearanceDirty) {
          localStatus.textContent = "页面中有未保存输入。请先保存或恢复，再部署 UI，避免旧输入覆盖线上配置。";
        } else if (settingsPending) {
          localStatus.textContent = `页面配置存在待同步草稿，线上默认仍是「${uiPresetLabel(onlinePreset, onlineSettings)}」。请先同步或撤销该草稿，再一键部署 UI。`;
        } else if (selectedPreset && selectedPreset !== onlinePreset) {
          localStatus.textContent = `已选择「${uiPresetWorkspaceLabel(selectedPreset)}」。点击“一键部署上线 UI ${uiPresetCode(selectedPreset)}”只会提交 UI 默认项，其他草稿不会一起发布。`;
        } else {
          localStatus.textContent = `当前构建是「${uiPresetWorkspaceLabel(INITIAL_DATA.currentBuildPreset)}」，线上默认是「${uiPresetLabel(onlinePreset, onlineSettings)}」。`;
        }
      };

      const sharedSettingsFieldValue = (settings, key) => {
        if (key === "navText") return stringifyNavText(settings.nav || []);
        if (key === "codeLinesText") return stringifyCodeLines(settings.home?.codeLines || []);
        if (key === "aboutSummaryText") return stringifyTextList(settings.pages?.about?.summary || []);
        if (key === "aboutFocusText") return stringifyTextList(settings.pages?.about?.focus || []);
        if (key === "aboutLinksText") return stringifyAboutLinks(settings.pages?.about?.links || []);
        return getByPath(settings, key) ?? "";
      };

      const sharedSettingsInputIsDirty = (field, settings = state.settings || INITIAL_DATA.settings) =>
        field.value !== String(sharedSettingsFieldValue(settings, field.dataset.settingsField));

      const sharedSettingsInputsAreDirty = () => {
        const settings = state.settings || INITIAL_DATA.settings;
        return settingsFields.some((field) => sharedSettingsInputIsDirty(field, settings));
      };

      const fillSharedSettings = () => {
        const settings = state.settings || clone(INITIAL_DATA.settings);
        settingsFields.forEach((field) => {
          const key = field.dataset.settingsField;
          field.value = sharedSettingsFieldValue(settings, key);
        });
        state.sharedSettingsDirty = false;
        renderUiPresetSelection();
      };

      const fillSettings = () => {
        fillSharedSettings();
        fillUiAppearanceSettings();
      };

      const collectSettings = () => {
        const settings = clone(state.settings || INITIAL_DATA.settings);
        settingsFields.forEach((field) => {
          const key = field.dataset.settingsField;
          if (key === "navText") {
            settings.nav = parseNavText(field.value);
            return;
          }
          if (key === "codeLinesText") {
            settings.home.codeLines = parseCodeLines(field.value);
            return;
          }
          if (key === "aboutSummaryText") {
            setByPath(settings, "pages.about.summary", parseTextList(field.value));
            return;
          }
          if (key === "aboutFocusText") {
            setByPath(settings, "pages.about.focus", parseTextList(field.value));
            return;
          }
          if (key === "aboutLinksText") {
            setByPath(settings, "pages.about.links", parseAboutLinks(field.value));
            return;
          }
          setByPath(settings, key, field.value.trim());
        });

        settings.home.codeLines = Array.isArray(settings.home.codeLines) && settings.home.codeLines.length
          ? settings.home.codeLines
          : [
              { label: "type", value: "Memory = \"文字\" | \"影像\" | \"代码\" | \"偏爱\"" },
              { label: "loop", value: "observe → write → ship → remember" },
              { label: "made_with", value: "Astro · TypeScript · Tailwind" },
            ];

        return settings;
      };

      const sharedSettingsStoragePath = (fieldKey) => ({
        navText: "nav",
        codeLinesText: "home.codeLines",
        aboutSummaryText: "pages.about.summary",
        aboutFocusText: "pages.about.focus",
        aboutLinksText: "pages.about.links",
      })[fieldKey] || fieldKey;

      const mergeQueuedSettingsWithRemote = ({ remoteSettings, localSettings, baseSettings, settingsScopes }) => {
        const sharedPaths = settingsFields.map((field) => {
          const path = sharedSettingsStoragePath(field.dataset.settingsField);
          return {
            path,
            label: field.closest("label")?.querySelector("span")?.textContent?.trim() || path,
          };
        });
        const appearanceFieldsByPreset = Object.fromEntries(
          availableUiPresets.map((preset) => [
            preset.id,
            [UI_PRESET_DISPLAY_NAME_FIELD, ...(preset.appearanceFields || [])],
          ]),
        );
        return mergeScopedSiteSettings({
          remoteSettings,
          localSettings,
          baseSettings,
          settingsScopes,
          sharedPaths,
          appearanceFieldsByPreset,
        });
      };

      const saveSettings = async () => {
        if (state.uiPresetDeploying) throw new Error("UI 正在部署，请等待本次提交完成");
        requireWriteAccess();
        const settings = collectSettings();
        if (!uiPresetIds.has(settings.ui?.activePreset)) throw new Error("请选择有效的 UI 包");
        if (!settings.site?.title) throw new Error("请填写 SEO 标题");
        if (!settings.site?.author) throw new Error("请填写作者");
        if (!settings.home?.headline) throw new Error("请填写首页大标题");
        if (!settings.nav?.length) throw new Error("至少保留一条导航");
        ["articles", "gallery", "videos", "recommendations", "about"].forEach((key) => {
          if (!settings.pages?.[key]?.title) throw new Error(`请填写 ${key} 栏目标题`);
        });
        queueSettingsChange({
          content: stringifySettingsModule(settings),
          scope: "shared",
          scopeLabel: "共享内容",
          previewValue: "",
        });
        state.settings = settings;
        state.sharedSettingsDirty = false;
        fillSharedSettings();
        setStatus("共享内容已暂存，将同步到全部 UI。确认无误后点“同步全部改动”。");
      };

      const setDefaultUiPreset = async (presetId) => {
        if (!uiPresetIds.has(presetId)) throw new Error("这个 UI 包不存在或已被移除");
        if (!uiPresetSelect) throw new Error("UI 包选择器没有加载成功");
        requireWriteAccess();
        if (state.uiPresetDeploying) throw new Error("已有 UI 正在部署，请稍候");
        if (state.sharedSettingsDirty || state.uiAppearanceDirty) {
          throw new Error("页面中有未保存输入。请先保存或恢复，再一键部署 UI。");
        }
        if (state.pendingChanges.files.some((item) => item.path === SETTINGS_PATH)) {
          throw new Error("页面配置已有待同步修改。请先同步或撤销该草稿，再一键部署 UI，避免改变草稿内容。");
        }

        uiPresetSelect.value = presetId;
        state.uiPresetDeploying = true;
        state.uiPresetDeployTarget = presetId;
        renderUiPresetSelection();
        setStatus(`正在读取 main 最新配置并部署 UI ${uiPresetCode(presetId)}...`);

        try {
          const remoteFile = await getFile(SETTINGS_PATH);
          const latestSettings = readExportedValue(fromBase64(remoteFile.content), "siteSettings");
          if (!latestSettings || typeof latestSettings !== "object") throw new Error("main 分支页面配置无法解析");
          if (!remoteFile.sha) throw new Error("没有读取到 main 页面配置的版本号");

          const deploymentSettings = clone(latestSettings);
          setByPath(deploymentSettings, "ui.activePreset", presetId);
          const serializedSettings = stringifySettingsModule(deploymentSettings);

          if (latestSettings.ui?.activePreset !== presetId) {
            const result = await putFile({
              path: SETTINGS_PATH,
              content: toBase64(serializedSettings),
              sha: remoteFile.sha,
              message: `Deploy UI ${uiPresetCode(presetId)} (${presetId})`,
            });
            state.files.settings = {
              ...remoteFile,
              content: toBase64(serializedSettings),
              sha: result?.content?.sha || remoteFile.sha,
            };
          } else {
            state.files.settings = remoteFile;
          }

          state.original.settings = clone(deploymentSettings);
          state.settings = clone(deploymentSettings);
          uiPresetSelect.value = presetId;
          fillSettings();
          setStatus(
            latestSettings.ui?.activePreset === presetId
              ? `UI ${uiPresetCode(presetId)} 已经是线上默认，无需重复提交。`
              : `UI ${uiPresetCode(presetId)} 已提交到 main。GitHub Pages 重建完成后自动上线，其他草稿均未发布。`,
          );
        } catch (error) {
          const message = error instanceof Error ? error.message : "未知错误";
          if (/409|conflict|sha|does not match|is at [a-f0-9]+ but expected/i.test(message)) {
            throw new Error("线上页面配置刚被其他操作更新，本次没有覆盖它。请重新点击部署。");
          }
          throw error;
        } finally {
          state.uiPresetDeploying = false;
          state.uiPresetDeployTarget = "";
          renderUiPresetSelection();
        }
      };

      const newPost = () => {
        state.current.post = { slug: "", sha: "", path: "", data: { publishDate: new Date().toISOString().slice(0, 10), tags: [] }, body: "" };
        postFields.slug.value = "";
        postFields.title.value = "";
        postFields.description.value = "";
        postFields.publishDate.value = new Date().toISOString().slice(0, 10);
        postFields.cover.value = "";
        postFields.tags.value = "";
        postFields.draft.checked = false;
        postFields.body.value = "";
        $("[data-post-title]").textContent = "新建文章";
        renderMarkdownPreview();
        renderList();
      };

      const loadPost = async (item) => {
        setStatus("读取文章中...");
        const file = state.token ? await getFile(item.path) : null;
        const parsed = file ? parseFrontmatter(fromBase64(file.content)) : { data: item.data || {}, body: item.body || "" };
        state.current.post = {
          slug: item.name.replace(/\.(md|mdx)$/, ""),
          path: item.path,
          sha: file?.sha || item.sha || "",
          data: parsed.data,
          body: parsed.body,
        };
        postFields.slug.value = state.current.post.slug;
        postFields.title.value = parsed.data.title || "";
        postFields.description.value = parsed.data.description || "";
        postFields.publishDate.value = String(parsed.data.publishDate || new Date().toISOString().slice(0, 10)).slice(0, 10);
        postFields.cover.value = parsed.data.cover || "";
        postFields.tags.value = Array.isArray(parsed.data.tags) ? parsed.data.tags.join(", ") : "";
        postFields.draft.checked = !!parsed.data.draft;
        postFields.body.value = parsed.body || "";
        $("[data-post-title]").textContent = `编辑文章：${parsed.data.title || state.current.post.slug}`;
        renderMarkdownPreview();
        renderList();
        setStatus("文章已载入。");
      };

      const savePost = async () => {
        requireWriteAccess();
        const slug = slugify(postFields.slug.value || postFields.title.value);
        if (!slug) throw new Error("请填写文章标题或 slug");
        if (!postFields.publishDate.value) throw new Error("请选择发布日期");
        postFields.slug.value = slug;

        const path = `${POSTS_PATH}/${slug}.mdx`;
        const current = state.current.post;
        const wasNew = !current?.path;
        const content = stringifyPost();
        queueContentChange({
          path,
          content,
          label: current?.path ? `文章：${slug}` : `新文章：${slug}`,
          previewValue: parseFrontmatter(content).data.cover,
        });

        if (current?.sha && current.path && current.path !== path) {
          queueDeleteChange({ path: current.path, label: `旧文章路径：${current.slug}` });
        } else if (current?.path && current.path !== path) {
          queueDeleteChange({ path: current.path, label: `旧文章路径：${current.slug}` });
        }

        const item = {
          name: `${slug}.mdx`,
          path,
          sha: current?.sha || "",
          slug,
          data: parseFrontmatter(content).data,
          body: parseFrontmatter(content).body,
        };
        const existingIndex = state.posts.findIndex((post) => post.path === current?.path || post.path === path);
        if (existingIndex >= 0) state.posts[existingIndex] = item;
        else state.posts.unshift(item);
        state.posts = state.posts.filter((post, index, items) => items.findIndex((entry) => entry.path === post.path) === index);
        state.posts.sort((a, b) => new Date(b.data?.publishDate || 0).valueOf() - new Date(a.data?.publishDate || 0).valueOf());
        state.current.post = { ...current, slug, path, sha: item.sha, data: item.data, body: item.body };
        updateCounts();
        if (wasNew) newPost();
        else renderList();
        setStatus("文章已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const deletePost = async () => {
        requireWriteAccess();
        const current = state.current.post;
        if (!current?.path) throw new Error("请选择一篇已有文章");
        if (!confirm(`确定删除文章「${current.slug}」吗？`)) return;
        queueDeleteChange({ path: current.path, label: `文章：${current.slug}` });
        state.posts = state.posts.filter((post) => post.path !== current.path);
        updateCounts();
        newPost();
        setStatus("文章删除已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const newProject = () => {
        state.current.projectIndex = -1;
        projectFields.name.value = "";
        projectFields.year.value = new Date().getFullYear().toString();
        projectFields.description.value = "";
        projectFields.tags.value = "";
        projectFields.link.value = "";
        $("[data-project-title]").textContent = "新建项目";
        renderList();
      };

      const fillProject = (index) => {
        const project = state.projects[index];
        state.current.projectIndex = index;
        projectFields.name.value = project?.name || "";
        projectFields.year.value = project?.year || "";
        projectFields.description.value = project?.description || "";
        projectFields.tags.value = Array.isArray(project?.tags) ? project.tags.join(", ") : "";
        projectFields.link.value = project?.link || "";
        $("[data-project-title]").textContent = `编辑项目：${projectFields.name.value || "未命名"}`;
        renderList();
      };

      const saveProject = async () => {
        requireWriteAccess();
        const project = {
          name: projectFields.name.value.trim(),
          year: projectFields.year.value.trim(),
          description: projectFields.description.value.trim(),
          tags: projectFields.tags.value.split(",").map((tag) => tag.trim()).filter(Boolean),
          link: projectFields.link.value.trim() || "#",
        };
        if (!project.name) throw new Error("请填写项目名称");
        if (!project.description) throw new Error("请填写项目简介");
        const wasNew = state.current.projectIndex < 0;
        const items = [...state.projects];
        if (state.current.projectIndex >= 0) items[state.current.projectIndex] = project;
        else items.unshift(project);
        queueContentChange({
          path: PROJECTS_PATH,
          content: stringifyArrayModule("projects", items),
          label: "项目数据",
        });
        state.projects = items;
        state.current.projectIndex = items.findIndex((item) => item === project);
        updateCounts();
        if (wasNew) newProject();
        else renderList();
        setStatus("项目已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const deleteProject = async () => {
        requireWriteAccess();
        if (state.current.projectIndex < 0) throw new Error("请选择一个已有项目");
        const project = state.projects[state.current.projectIndex];
        if (!confirm(`确定删除项目「${project.name}」吗？`)) return;
        const items = state.projects.filter((_, index) => index !== state.current.projectIndex);
        queueContentChange({
          path: PROJECTS_PATH,
          content: stringifyArrayModule("projects", items),
          label: "项目数据",
        });
        state.projects = items;
        updateCounts();
        newProject();
        setStatus("项目删除已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const newRecommendation = () => {
        state.current.recommendationIndex = -1;
        recommendationFields.title.value = "";
        recommendationFields.category.value = "book";
        recommendationFields.creator.value = "";
        recommendationFields.year.value = new Date().getFullYear().toString();
        recommendationFields.description.value = "";
        recommendationFields.image.value = "";
        recommendationFields.link.value = "";
        recommendationFields.rating.value = "";
        recommendationFields.tags.value = "";
        $("[data-recommendation-title]").textContent = "新建推荐";
        renderRecommendationPreview();
        renderList();
      };

      const fillRecommendation = (index) => {
        const item = state.recommendations[index];
        state.current.recommendationIndex = index;
        recommendationFields.title.value = item?.title || "";
        recommendationFields.category.value = item?.category || "other";
        recommendationFields.creator.value = item?.creator || "";
        recommendationFields.year.value = item?.year || "";
        recommendationFields.description.value = item?.description || "";
        recommendationFields.image.value = item?.image || "";
        recommendationFields.link.value = item?.link || "";
        recommendationFields.rating.value = item?.rating || "";
        recommendationFields.tags.value = Array.isArray(item?.tags) ? item.tags.join(", ") : "";
        $("[data-recommendation-title]").textContent = `编辑推荐：${recommendationFields.title.value || "未命名"}`;
        renderRecommendationPreview();
        renderList();
      };

      const renderRecommendationPreview = () => {
        const image = recommendationFields.image.value.trim();
        const preview = $("[data-recommendation-preview]");
        const empty = $("[data-recommendation-empty]");
        preview.hidden = !image;
        preview.classList.toggle("hidden", !image);
        empty.hidden = !!image;
        if (image) preview.src = assetPreviewForValue(image);
        else preview.removeAttribute("src");
        preview.alt = recommendationFields.title.value.trim();
        $("[data-recommendation-preview-title]").textContent = recommendationFields.title.value.trim() || "预览";
        $("[data-recommendation-preview-meta]").textContent = [
          recommendationFields.category.value,
          recommendationFields.creator.value.trim(),
          recommendationFields.year.value.trim(),
          recommendationFields.rating.value.trim(),
        ].filter(Boolean).join(" · ");
        $("[data-recommendation-preview-description]").textContent =
          recommendationFields.description.value.trim() || "推荐理由会显示在这里。";
      };

      const saveRecommendation = async () => {
        requireWriteAccess();
        const item = {
          title: recommendationFields.title.value.trim(),
          category: recommendationFields.category.value,
          creator: recommendationFields.creator.value.trim(),
          year: recommendationFields.year.value.trim(),
          description: recommendationFields.description.value.trim(),
          image: recommendationFields.image.value.trim(),
          link: recommendationFields.link.value.trim() || "#",
          rating: recommendationFields.rating.value.trim(),
          tags: recommendationFields.tags.value.split(",").map((tag) => tag.trim()).filter(Boolean),
        };
        if (!item.title) throw new Error("请填写推荐名称");
        if (!item.description) throw new Error("请填写推荐理由");
        const wasNew = state.current.recommendationIndex < 0;
        const items = [...state.recommendations];
        if (state.current.recommendationIndex >= 0) items[state.current.recommendationIndex] = item;
        else items.unshift(item);
        queueContentChange({
          path: RECOMMENDATIONS_PATH,
          content: stringifyArrayModule("recommendations", items),
          label: "推荐数据",
          previewValue: item.image,
        });
        state.recommendations = items;
        state.current.recommendationIndex = items.findIndex((entry) => entry === item);
        updateCounts();
        if (wasNew) newRecommendation();
        else renderList();
        setStatus("推荐已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const deleteRecommendation = async () => {
        requireWriteAccess();
        if (state.current.recommendationIndex < 0) throw new Error("请选择一个已有推荐");
        const item = state.recommendations[state.current.recommendationIndex];
        if (!confirm(`确定删除推荐「${item.title}」吗？`)) return;
        const items = state.recommendations.filter((_, index) => index !== state.current.recommendationIndex);
        queueContentChange({
          path: RECOMMENDATIONS_PATH,
          content: stringifyArrayModule("recommendations", items),
          label: "推荐数据",
        });
        state.recommendations = items;
        updateCounts();
        newRecommendation();
        setStatus("推荐删除已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const newGallery = () => {
        state.current.galleryIndex = -1;
        galleryFields.title.value = "";
        galleryFields.description.value = "";
        galleryFields.image.value = "";
        galleryFields.height.value = "medium";
        $("[data-gallery-title]").textContent = "新建照片卡片";
        renderGalleryPreview();
        renderList();
      };

      const fillGallery = (index) => {
        const item = state.gallery[index];
        state.current.galleryIndex = index;
        galleryFields.title.value = item?.title || "";
        galleryFields.description.value = item?.description || "";
        galleryFields.image.value = item?.image || "";
        galleryFields.height.value = item?.height || "medium";
        $("[data-gallery-title]").textContent = `编辑照片：${galleryFields.title.value || "未命名"}`;
        renderGalleryPreview();
        renderList();
      };

      const renderGalleryPreview = () => {
        const image = galleryFields.image.value.trim();
        const preview = $("[data-gallery-preview]");
        const empty = $("[data-gallery-empty]");
        preview.hidden = !image;
        preview.classList.toggle("hidden", !image);
        empty.hidden = !!image;
        if (image) preview.src = assetPreviewForValue(image);
        else preview.removeAttribute("src");
        preview.alt = galleryFields.title.value.trim();
        $("[data-gallery-preview-title]").textContent = galleryFields.title.value.trim() || "预览";
        $("[data-gallery-preview-description]").textContent = galleryFields.description.value.trim() || "上传或选择照片后显示。";
      };

      const saveGallery = async () => {
        requireWriteAccess();
        const item = {
          title: galleryFields.title.value.trim(),
          description: galleryFields.description.value.trim(),
          image: galleryFields.image.value.trim(),
          height: galleryFields.height.value,
        };
        if (!item.title) throw new Error("请填写照片标题");
        if (!item.image) throw new Error("请选择或上传照片");
        if (!isPersonalPhotoValue(item.image)) throw new Error("主页照片只能使用 /personal-photo/ 路径或对应的 R2 主页照片 URL。ARTICLE_IMAGE_ASSETS 的 /article-assets/ 不会进入前台图集。");
        const wasNew = state.current.galleryIndex < 0;
        const items = [...state.gallery];
        if (state.current.galleryIndex >= 0) items[state.current.galleryIndex] = item;
        else items.unshift(item);
        queueContentChange({
          path: GALLERY_PATH,
          content: stringifyArrayModule("galleryItems", items),
          label: "PersonalPhoto 数据",
          previewValue: item.image,
        });
        state.gallery = items;
        state.current.galleryIndex = items.findIndex((entry) => entry === item);
        updateCounts();
        if (wasNew) newGallery();
        else renderList();
        setStatus("PersonalPhoto 已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const deleteGallery = async () => {
        requireWriteAccess();
        if (state.current.galleryIndex < 0) throw new Error("请选择一个已有照片");
        const item = state.gallery[state.current.galleryIndex];
        if (!confirm(`确定删除 PersonalPhoto「${item.title}」吗？`)) return;
        const items = state.gallery.filter((_, index) => index !== state.current.galleryIndex);
        queueContentChange({
          path: GALLERY_PATH,
          content: stringifyArrayModule("galleryItems", items),
          label: "PersonalPhoto 数据",
        });
        state.gallery = items;
        updateCounts();
        newGallery();

        let fileStatus = "";
        const canDeletePhotoFile =
          isPersonalPhotoValue(item.image) &&
          (mediaStorageMode() === "r2" || item.image?.startsWith("/personal-photo/")) &&
          !items.some((entry) => entry.image === item.image);
        if (canDeletePhotoFile && confirm("这张 PersonalPhoto 没有被其他照片卡片引用，是否同时删除图片文件？")) {
          if (mediaStorageMode() === "r2") {
            state.pendingMedia.deletes.push({
              kind: "image",
              name: item.title,
              path: mediaKeyFromPublicPath(item.image),
              key: mediaKeyFromPublicPath(item.image),
              publicPath: item.image,
              remote: true,
              draftKind: "media-delete",
            });
            selectDraft(state.pendingMedia.deletes.at(-1), true);
            updatePendingChangesUi();
          } else {
            const imagePath = publicPathToRepoPath(item.image);
            queueDeleteChange({ path: imagePath, label: `PersonalPhoto 文件：${item.title}` });
          }
          fileStatus = "图片文件删除也已暂存。";
        }

        setStatus(`PersonalPhoto 删除已暂存。${fileStatus}`);
      };

      const newPersonalVideo = () => {
        state.current.personalVideoIndex = -1;
        personalVideoFields.title.value = "";
        personalVideoFields.description.value = "";
        personalVideoFields.date.value = new Date().toISOString().slice(0, 10);
        personalVideoFields.video.value = "";
        personalVideoFields.poster.value = "";
        $("[data-personal-video-title]").textContent = "新建视频记录";
        renderPersonalVideoPreview();
        renderList();
      };

      const fillPersonalVideo = (index) => {
        const item = state.personalVideos[index];
        state.current.personalVideoIndex = index;
        personalVideoFields.title.value = item?.title || "";
        personalVideoFields.description.value = item?.description || "";
        personalVideoFields.date.value = item?.date || new Date().toISOString().slice(0, 10);
        personalVideoFields.video.value = item?.video || "";
        personalVideoFields.poster.value = item?.poster || "";
        $("[data-personal-video-title]").textContent = `编辑视频：${personalVideoFields.title.value || "未命名"}`;
        renderPersonalVideoPreview();
        renderList();
      };

      const renderPersonalVideoPreview = () => {
        const video = personalVideoFields.video.value.trim();
        const poster = personalVideoFields.poster.value.trim();
        const preview = $("[data-personal-video-preview]");
        const empty = $("[data-personal-video-empty]");
        preview.hidden = !video;
        preview.classList.toggle("hidden", !video);
        empty.hidden = !!video;
        if (video) preview.src = assetPreviewForValue(video);
        else preview.removeAttribute("src");
        preview.poster = poster ? assetPreviewForValue(poster) : "";
        $("[data-personal-video-preview-title]").textContent = personalVideoFields.title.value.trim() || "预览";
        $("[data-personal-video-preview-description]").textContent =
          personalVideoFields.description.value.trim() || "上传或选择视频后显示。";
      };

      const savePersonalVideo = async () => {
        requireWriteAccess();
        const item = {
          title: personalVideoFields.title.value.trim(),
          description: personalVideoFields.description.value.trim(),
          video: personalVideoFields.video.value.trim(),
          poster: personalVideoFields.poster.value.trim(),
          date: personalVideoFields.date.value,
        };
        if (!item.title) throw new Error("请填写视频标题");
        if (!item.video) throw new Error("请上传或填写视频路径");
        const wasNew = state.current.personalVideoIndex < 0;
        const items = [...state.personalVideos];
        if (state.current.personalVideoIndex >= 0) items[state.current.personalVideoIndex] = item;
        else items.unshift(item);
        queueContentChange({
          path: PERSONAL_VIDEOS_DATA_PATH,
          content: stringifyArrayModule("videoItems", items),
          label: "PersonalVideo 数据",
          previewValue: item.poster,
        });
        state.personalVideos = items;
        state.current.personalVideoIndex = items.findIndex((entry) => entry === item);
        updateCounts();
        if (wasNew) newPersonalVideo();
        else renderList();
        setStatus("PersonalVideo 已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const deletePersonalVideo = async () => {
        requireWriteAccess();
        if (state.current.personalVideoIndex < 0) throw new Error("请选择一个已有视频记录");
        const item = state.personalVideos[state.current.personalVideoIndex];
        if (!confirm(`确定删除 PersonalVideo「${item.title}」吗？`)) return;
        const items = state.personalVideos.filter((_, index) => index !== state.current.personalVideoIndex);
        queueContentChange({
          path: PERSONAL_VIDEOS_DATA_PATH,
          content: stringifyArrayModule("videoItems", items),
          label: "PersonalVideo 数据",
        });
        state.personalVideos = items;
        updateCounts();
        newPersonalVideo();

        let fileStatus = "";
        const canDeleteVideoFile =
          isPersonalVideoValue(item.video) &&
          (mediaStorageMode() === "r2" || item.video?.startsWith("/personal-video/")) &&
          !items.some((entry) => entry.video === item.video);
        if (canDeleteVideoFile && confirm("这段 PersonalVideo 没有被其他视频记录引用，是否同时删除视频文件？")) {
          if (mediaStorageMode() === "r2") {
            state.pendingMedia.deletes.push({
              kind: "video",
              name: item.title,
              path: mediaKeyFromPublicPath(item.video),
              key: mediaKeyFromPublicPath(item.video),
              publicPath: item.video,
              remote: true,
              draftKind: "media-delete",
            });
            selectDraft(state.pendingMedia.deletes.at(-1), true);
            updatePendingChangesUi();
          } else {
            const videoPath = publicPathToRepoPath(item.video);
            queueDeleteChange({ path: videoPath, label: `PersonalVideo 文件：${item.title}` });
          }
          fileStatus = "视频文件删除也已暂存。";
        }

        setStatus(`PersonalVideo 删除已暂存。${fileStatus}`);
      };

      const makeUploadName = (file) => {
        const typeExtensions = {
          "image/jpeg": "jpg",
          "image/png": "png",
          "image/webp": "webp",
          "image/gif": "gif",
          "image/avif": "avif",
          "image/svg+xml": "svg",
          "video/mp4": "mp4",
          "video/webm": "webm",
          "video/quicktime": "mov",
        };
        const extension = typeExtensions[file.type] || (file.name.split(".").pop() || "png").toLowerCase();
        const baseName = slugifyFile(file.name.replace(/\.[^.]+$/, "")) || "media";
        const suffix = crypto.randomUUID ? crypto.randomUUID().slice(0, 8) : Math.random().toString(36).slice(2, 10);
        return `${Date.now()}-${baseName}-${suffix}.${extension}`;
      };

      const MEDIA_LIMITS = {
        image: {
          types: ["image/jpeg", "image/png", "image/webp", "image/avif"],
          extensions: ["jpg", "jpeg", "png", "webp", "avif"],
          label: "图片",
          formats: "JPG、PNG、WebP 或 AVIF",
        },
        video: {
          maxSize: 50 * 1024 * 1024,
          types: ["video/mp4", "video/webm", "video/quicktime"],
          extensions: ["mp4", "webm", "mov"],
          label: "视频",
          formats: "MP4、WebM 或 MOV",
        },
      };

      const formatFileSize = (size) => {
        if (size >= 1024 * 1024) return `${(size / 1024 / 1024).toFixed(1).replace(/\.0$/, "")}MB`;
        if (size >= 1024) return `${Math.ceil(size / 1024)}KB`;
        return `${size}B`;
      };

      const getFileExtension = (file) => (file.name.split(".").pop() || "").toLowerCase();

      const validateMediaFile = (file, kind) => {
        const rule = MEDIA_LIMITS[kind];
        const extension = getFileExtension(file);
        const hasAllowedType = file.type ? rule.types.includes(file.type) : false;
        const hasAllowedExtension = rule.extensions.includes(extension);

        if (!hasAllowedType && !hasAllowedExtension) {
          throw new Error(`${file.name} 格式不支持。${rule.label}请上传 ${rule.formats}。`);
        }

        if (rule.maxSize && file.size > rule.maxSize) {
          throw new Error(`${file.name} 太大了：${formatFileSize(file.size)}。${rule.label}请控制在 ${formatFileSize(rule.maxSize)} 以内。`);
        }
      };

      const validateMediaFiles = (files, kind) => {
        files.forEach((file) => validateMediaFile(file, kind));
      };

      const uploadMediaFile = async (file, directory = ARTICLE_IMAGE_ASSETS_PATH, publicRoot = "/article-assets") => {
        const safeName = makeUploadName(file);
        const path = `${directory}/${safeName}`;
        const publicPath = `${publicRoot}/${safeName}`;
        const remote = mediaStorageMode() === "r2";
        const isVideo = publicRoot.startsWith("/article-videos") || publicRoot.startsWith("/personal-video");
        const queued = {
          kind: isVideo ? "video" : "image",
          name: safeName,
          path: remote ? mediaKeyFromPublicPath(publicPath) : path,
          key: mediaKeyFromPublicPath(publicPath),
          publicPath,
          ...(remote ? { url: mediaUrlFromPublicPath(publicPath) } : {}),
          ...(remote ? { file, remote: true } : { content: arrayBufferToBase64(await file.arrayBuffer()) }),
          previewUrl: URL.createObjectURL(file),
          pending: true,
          draftKind: "media-upload",
        };
        state.pendingMedia.uploads.push(queued);
        selectDraft(queued, true);
        updatePendingChangesUi();
        return queued;
      };

      const addUploadedAssetIfVisible = (asset) => {
        if (asset.publicPath?.startsWith("/article-assets/") && !state.images.some((image) => image.path === asset.path)) {
          state.images = [asset, ...state.images];
        }
        if (asset.publicPath?.startsWith("/article-videos/") && !state.videos.some((video) => video.path === asset.path)) {
          state.videos = [asset, ...state.videos];
        }
      };

      const removePendingMediaByPath = (path) => {
        const existing = state.pendingMedia.uploads.findIndex((item) => item.path === path);
        if (existing >= 0) {
          const [removed] = state.pendingMedia.uploads.splice(existing, 1);
          selectDraft(removed, false);
          if (removed.previewUrl) URL.revokeObjectURL(removed.previewUrl);
        }
        state.pendingMedia.deletes = state.pendingMedia.deletes.filter((item) => {
          const keep = item.path !== path;
          if (!keep) selectDraft(item, false);
          return keep;
        });
        state.images = state.images.filter((image) => image.path !== path);
        state.videos = state.videos.filter((video) => video.path !== path);
        updatePendingChangesUi();
      };

      const restorePostPath = (path) => {
        const original = state.original.posts.find((post) => post.path === path);
        state.posts = state.posts.filter((post) => post.path !== path);
        if (original) state.posts.push(clone(original));
        state.posts.sort((a, b) => new Date(b.data?.publishDate || 0).valueOf() - new Date(a.data?.publishDate || 0).valueOf());
        if (state.current.post?.path === path) newPost();
      };

      const revertContentPath = (path) => {
        if (path.startsWith(`${POSTS_PATH}/`)) {
          restorePostPath(path);
        } else if (path === PROJECTS_PATH) {
          state.projects = clone(state.original.projects);
          newProject();
        } else if (path === RECOMMENDATIONS_PATH) {
          state.recommendations = clone(state.original.recommendations);
          newRecommendation();
        } else if (path === GALLERY_PATH) {
          state.gallery = clone(state.original.gallery);
          newGallery();
        } else if (path === PERSONAL_VIDEOS_DATA_PATH) {
          state.personalVideos = clone(state.original.personalVideos);
          newPersonalVideo();
        } else if (path === SETTINGS_PATH) {
          state.settings = clone(state.original.settings || INITIAL_DATA.settings);
          fillSettings();
        }
      };

      const removePendingChange = (id) => {
        const pendingSettingsDraft = state.pendingChanges.files.find(
          (item) => draftChangeId(item) === id && item.path === SETTINGS_PATH,
        );
        const settingsInputState = pendingSettingsDraft ? captureSettingsInputState() : null;
        const removeFrom = (items) => {
          const index = items.findIndex((item) => draftChangeId(item) === id);
          if (index < 0) return null;
          const [removed] = items.splice(index, 1);
          state.pendingDraftSelection.delete(id);
          return removed;
        };
        const removedFile = removeFrom(state.pendingChanges.files);
        const removedDelete = removeFrom(state.pendingChanges.deletes);
        const removedUpload = removeFrom(state.pendingMedia.uploads);
        const removedMediaDelete = removeFrom(state.pendingMedia.deletes);

        if (removedUpload?.previewUrl) URL.revokeObjectURL(removedUpload.previewUrl);
        if (removedFile?.path) revertContentPath(removedFile.path);
        if (removedDelete?.path) revertContentPath(removedDelete.path);
        if (settingsInputState) restoreSettingsInputState(settingsInputState);
        if (removedUpload?.path) {
          state.images = state.images.filter((image) => image.path !== removedUpload.path);
          state.personalPhotoAssets = state.personalPhotoAssets.filter((image) => image.path !== removedUpload.path);
          state.videos = state.videos.filter((video) => video.path !== removedUpload.path);
          state.personalVideoAssets = state.personalVideoAssets.filter((video) => video.path !== removedUpload.path);
        }
        if (removedMediaDelete && state.current.image?.path === removedMediaDelete.path) selectImage(null);
        if (removedMediaDelete && state.current.video?.path === removedMediaDelete.path) selectVideo(null);
        updateCounts();
        renderList();
        updatePendingChangesUi();
        setStatus(
          settingsInputState && (settingsInputState.sharedDirty || settingsInputState.uiAppearanceDirty)
            ? "已取消这条本地保存，尚未保存的页面配置输入仍然保留。"
            : "已取消这条本地保存。",
        );
      };

      const markSyncedContentAsOriginal = (files, deletes) => {
        files.forEach((file) => {
          if (file.path.startsWith(`${POSTS_PATH}/`)) {
            const post = state.posts.find((item) => item.path === file.path);
            state.original.posts = state.original.posts.filter((item) => item.path !== file.path);
            if (post) state.original.posts.push(clone(post));
          } else if (file.path === PROJECTS_PATH) {
            state.original.projects = clone(state.projects);
          } else if (file.path === RECOMMENDATIONS_PATH) {
            state.original.recommendations = clone(state.recommendations);
          } else if (file.path === GALLERY_PATH) {
            state.original.gallery = clone(state.gallery);
          } else if (file.path === PERSONAL_VIDEOS_DATA_PATH) {
            state.original.personalVideos = clone(state.personalVideos);
          } else if (file.path === SETTINGS_PATH) {
            state.original.settings = clone(state.settings || INITIAL_DATA.settings);
          }
        });
        deletes.forEach((deleted) => {
          if (deleted.path.startsWith(`${POSTS_PATH}/`)) {
            state.original.posts = state.original.posts.filter((item) => item.path !== deleted.path);
          }
        });
      };

      const clearSyncedPendingChanges = (selectedIds, uploads, files, deletes) => {
        uploads.forEach((upload) => {
          if (upload.previewUrl) URL.revokeObjectURL(upload.previewUrl);
        });
        state.pendingMedia.uploads = state.pendingMedia.uploads.filter((item) => !selectedIds.has(draftChangeId(item)));
        state.pendingMedia.deletes = state.pendingMedia.deletes.filter((item) => !selectedIds.has(draftChangeId(item)));
        state.pendingChanges.files = state.pendingChanges.files.filter((item) => !selectedIds.has(draftChangeId(item)));
        state.pendingChanges.deletes = state.pendingChanges.deletes.filter((item) => !selectedIds.has(draftChangeId(item)));
        selectedIds.forEach((id) => state.pendingDraftSelection.delete(id));
        state.pendingMedia.selectedImages.clear();
        state.pendingMedia.selectedVideos.clear();
        markSyncedContentAsOriginal(files, deletes);
      };

      const syncPendingChanges = async (changes = allPendingChanges(), options = {}) => {
        if (state.uiPresetDeploying) throw new Error("UI 正在部署，请等待本次提交完成");
        const {
          skipConfirmation = false,
          commitMessage = "",
        } = options;
        const selectedIds = new Set(changes.map(draftChangeId));
        const uploads = state.pendingMedia.uploads.filter((item) => selectedIds.has(draftChangeId(item)));
        const mediaDeletes = state.pendingMedia.deletes.filter((item) => selectedIds.has(draftChangeId(item)));
        const remoteUploads = uploads.filter((item) => usesRemoteMedia(item));
        const remoteDeletes = mediaDeletes.filter((item) => usesRemoteMedia(item));
        const gitUploads = uploads.filter((item) => !usesRemoteMedia(item));
        const gitMediaDeletes = mediaDeletes.filter((item) => !usesRemoteMedia(item));
        const files = state.pendingChanges.files.filter((item) => selectedIds.has(draftChangeId(item)));
        const deletes = state.pendingChanges.deletes.filter((item) => selectedIds.has(draftChangeId(item)));
        if (!uploads.length && !mediaDeletes.length && !files.length && !deletes.length) throw new Error("暂无待同步操作");
        if (files.length || deletes.length || gitUploads.length || gitMediaDeletes.length) requireWriteAccess();
        if (remoteUploads.length || remoteDeletes.length) requireMediaAccess();

        const summaryParts = [];
        if (files.length) summaryParts.push("write " + files.length + " content files");
        if (deletes.length) summaryParts.push("delete " + deletes.length + " content files");
        if (uploads.length) summaryParts.push("upload " + uploads.length + " media files");
        if (mediaDeletes.length) summaryParts.push("delete " + mediaDeletes.length + " media files");
        const summary = summaryParts.join(", ");
        const commitNotice = files.length || deletes.length || gitUploads.length || gitMediaDeletes.length
          ? "这会在 GitHub main 分支生成 1 次 commit。"
          : "这次只有 R2 媒体操作，不会生成 Git commit。";
        if (!skipConfirmation && !confirm("确定同步全部待处理改动吗？\n" + summary + "\n\n" + commitNotice)) return false;

        if (remoteUploads.length) {
          setStatus("上传 R2 媒体文件中...");
          await syncRemoteMediaOperations({ uploads: remoteUploads, deletes: [] });
        }

        if (!files.length && !deletes.length && !gitUploads.length && !gitMediaDeletes.length) {
          if (remoteDeletes.length) {
            setStatus("删除 R2 媒体文件中...");
            await syncRemoteMediaOperations({ uploads: [], deletes: remoteDeletes });
          }
          clearSyncedPendingChanges(selectedIds, uploads, files, deletes);
          await refreshAfterMediaSync("R2 媒体操作已同步。", "R2 媒体操作已同步，但素材列表刷新失败");
          return true;
        }

        setStatus("创建 GitHub 批量提交中...");
        const branchRef = await getBranchRef();
        const parentSha = branchRef.object.sha;
        const parentCommit = await getGitCommit(parentSha);
        const treeEntries = [];
        let mergedSyncedSettings = null;
        let mergedSettingsRemoteFile = null;
        let mergedSettingsBlobSha = "";

        for (const file of files) {
          let fileContent = file.content;
          if (file.path === SETTINGS_PATH) {
            if (!file.settingsScopes?.length) {
              throw new Error("页面配置草稿缺少字段范围，请撤销这条草稿后重新保存，避免覆盖其他 UI 参数。");
            }
            const remoteFile = await getFile(SETTINGS_PATH, parentSha);
            const remoteSettings = readExportedValue(fromBase64(remoteFile.content), "siteSettings");
            const localSettings = readExportedValue(file.content, "siteSettings");
            mergedSyncedSettings = mergeQueuedSettingsWithRemote({
              remoteSettings,
              localSettings,
              baseSettings: state.original.settings || INITIAL_DATA.settings,
              settingsScopes: file.settingsScopes,
            });
            mergedSettingsRemoteFile = remoteFile;
            fileContent = stringifySettingsModule(mergedSyncedSettings);
          }
          const blob = await createGitBlob({ content: toBase64(fileContent) });
          if (file.path === SETTINGS_PATH) mergedSettingsBlobSha = blob.sha;
          treeEntries.push({
            path: file.path,
            mode: "100644",
            type: "blob",
            sha: blob.sha,
          });
        }
        for (const upload of gitUploads) {
          const blob = await createGitBlob({ content: upload.content });
          treeEntries.push({
            path: upload.path,
            mode: "100644",
            type: "blob",
            sha: blob.sha,
          });
        }
        for (const deleted of [...deletes, ...gitMediaDeletes]) {
          treeEntries.push({
            path: deleted.path,
            mode: "100644",
            type: "blob",
            sha: null,
          });
        }

        const tree = await createGitTree({
          baseTreeSha: parentCommit.tree.sha,
          tree: treeEntries,
        });
        const commit = await createGitCommit({
          message: commitMessage || `Sync site updates: ${summary}`,
          treeSha: tree.sha,
          parentSha,
        });
        await updateBranchRef(commit.sha);

        const remoteDeleteIds = new Set(remoteDeletes.map(draftChangeId));
        const committedIds = new Set(
          [...selectedIds].filter((id) => !remoteDeleteIds.has(id)),
        );

        if (mergedSyncedSettings) {
          const settingsInputState = captureSettingsInputState();
          const serializedSettings = stringifySettingsModule(mergedSyncedSettings);
          state.settings = clone(mergedSyncedSettings);
          state.files.settings = {
            ...(mergedSettingsRemoteFile || {}),
            content: toBase64(serializedSettings),
            sha: mergedSettingsBlobSha || mergedSettingsRemoteFile?.sha,
          };
          fillSettings();
          restoreSettingsInputState(settingsInputState);
        }
        clearSyncedPendingChanges(committedIds, uploads, files, deletes);
        if (remoteDeletes.length) {
          updatePendingChangesUi();
          setStatus("GitHub 内容已提交，正在删除 R2 媒体文件...");
          try {
            await syncRemoteMediaOperations({ uploads: [], deletes: remoteDeletes });
          } catch (error) {
            updatePendingChangesUi();
            throw new Error(
              `GitHub 内容已提交，但 R2 文件删除失败；删除草稿已保留，可直接重试：${describeMediaError(error)}`,
            );
          }
          clearSyncedPendingChanges(remoteDeleteIds, [], [], []);
        }
        if (remoteUploads.length || remoteDeletes.length) {
          await refreshAfterMediaSync("全部待处理改动已同步为 1 次 Git commit。", "全部待处理改动已同步，但素材列表刷新失败");
          return true;
        }
        selectImage(null);
        selectVideo(null);
        updateCounts();
        renderList();
        updatePendingChangesUi();
        setStatus("全部待处理改动已同步为 1 次 Git commit。");
        return true;
      };

      const syncSelectedPendingChanges = async () => {
        const selected = selectedPendingChanges();
        if (!selected.length) throw new Error("请先在本地保存页选择要同步的改动。");
        await syncPendingChanges(selected);
      };

      const uploadImages = async (files, options = {}) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        if (!files.length) return [];
        const directory = options.directory || ARTICLE_IMAGE_ASSETS_PATH;
        const publicRoot = options.publicRoot || "/article-assets";
        const reloadAssets = options.reloadAssets ?? directory === ARTICLE_IMAGE_ASSETS_PATH;
        validateMediaFiles(files, "image");
        setStatus(`上传 ${files.length} 张图片中...`);
        const uploaded = [];
        for (const file of files) {
          const image = await uploadMediaFile(file, directory, publicRoot);
          uploaded.push(image);
          if (reloadAssets) addUploadedAssetIfVisible(image);
        }
        updateCounts();
        renderList();
        if (reloadAssets) selectImage(uploaded.at(-1));
        setStatus("图片已暂存。确认无误后点“同步全部改动”一次提交。");
        return uploaded;
      };

      const uploadVideo = async (file, options = {}) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        validateMediaFile(file, "video");
        const directory = options.directory || ARTICLE_VIDEO_ASSETS_PATH;
        const publicRoot = options.publicRoot || "/article-videos";
        const reloadAssets = options.reloadAssets ?? directory === ARTICLE_VIDEO_ASSETS_PATH;
        setStatus("上传视频中...");
        const video = await uploadMediaFile(file, directory, publicRoot);
        if (reloadAssets) addUploadedAssetIfVisible(video);
        if (reloadAssets) {
          selectVideo(video);
          updateCounts();
          renderList();
        }
        setStatus("视频已暂存。确认无误后点“同步全部改动”一次提交。");
        return video;
      };

      const applyUiAppearanceMediaValue = (mediaValue, pick, expectedKind) => {
        const libraryKey = pick?.section || (expectedKind === "video" ? "personalVideoAssets" : "personalPhotoAssets");
        const library = mediaLibraries[libraryKey];
        if (!library || library.kind !== expectedKind) {
          throw new Error(`这个 UI 字段需要 ${expectedKind === "video" ? "视频" : "图片"}素材库。`);
        }
        if (!isMediaLibraryValue(mediaValue, libraryKey)) {
          throw new Error(`UI 资源只能选择 ${library.publicRoot} 素材库中的文件。`);
        }
        const presetId = pick?.presetId;
        const fieldPath = pick?.fieldPath;
        const field = uiAppearanceFields.find(
          (candidate) =>
            candidate.dataset.uiAppearancePreset === presetId &&
            candidate.dataset.uiAppearanceField === fieldPath,
        );
        if (!field) throw new Error("没有找到对应的 UI 专属参数字段。");
        setUiAppearanceControlValue(field, mediaValue);
        state.uiAppearanceDirty = uiAppearanceInputsAreDirty();
        renderUiAppearanceEditor();
        renderUiPresetSelection();
      };

      const imagePickTargets = {
        postCover: {
          section: "images",
          label: "文章封面",
          apply: (image, imageValue) => {
            postFields.cover.value = imageValue;
            renderMarkdownPreview();
          },
        },
        postBody: {
          section: "images",
          label: "文章正文",
          apply: (image) => insertImageMarkdown(image),
        },
        recommendationImage: {
          section: "images",
          label: "推荐封面",
          apply: (image, imageValue) => {
            recommendationFields.image.value = imageValue;
            renderRecommendationPreview();
          },
        },
        galleryImage: {
          section: "personalPhotoAssets",
          label: "PERSONAL_PHOTO 图片",
          apply: (image, imageValue) => {
            if (!isPersonalPhotoValue(imageValue)) throw new Error("PERSONAL_PHOTO 只能选择 /personal-photo/ 里的图片。");
            galleryFields.image.value = imageValue;
            renderGalleryPreview();
          },
        },
        personalVideoPoster: {
          section: "images",
          label: "PERSONAL_VIDEO 封面",
          apply: (image, imageValue) => {
            personalVideoFields.poster.value = imageValue;
            renderPersonalVideoPreview();
          },
        },
        uiAppearanceImage: {
          section: "personalPhotoAssets",
          label: "UI 专属图片",
          apply: (_image, imageValue, pick) => {
            applyUiAppearanceMediaValue(imageValue, pick, "image");
          },
        },
      };

      const videoPickTargets = {
        uiAppearanceVideo: {
          section: "personalVideoAssets",
          label: "UI 专属视频",
          apply: (_video, videoValue, pick) => {
            applyUiAppearanceMediaValue(videoValue, pick, "video");
          },
        },
      };

      const startImagePicker = (targetKey, sectionKey = "", context = {}) => {
        const target = imagePickTargets[targetKey];
        if (!target) throw new Error("未知的图片选择目标。");
        const section = sectionKey || target.section;
        if (!isMediaLibrarySection(section) || mediaLibraries[section].kind !== "image") {
          throw new Error("这个 UI 字段引用的图片素材库尚未配置。");
        }
        state.pendingImagePick = {
          target: targetKey,
          section,
          returnSection: state.section,
          presetId: context.presetId || "",
          fieldPath: context.fieldPath || "",
        };
        selectSection(section);
        setStatus(`请选择一张图片填入${target.label}。`);
      };

      const applyPickedImage = (pick, image) => {
        const target = imagePickTargets[pick?.target];
        const imageValue = mediaContentValue(image);
        if (!target || !imageValue) return;
        target.apply(image, imageValue, pick);
        state.pendingImagePick = null;
        if (pick.returnSection) selectSection(pick.returnSection);
        setStatus(`已把选中的图片填入${target.label}。`);
      };

      const startVideoPicker = (targetKey, sectionKey = "", context = {}) => {
        const target = videoPickTargets[targetKey];
        if (!target) throw new Error("未知的视频选择目标。");
        const section = sectionKey || target.section;
        if (!isMediaLibrarySection(section) || mediaLibraries[section].kind !== "video") {
          throw new Error("这个 UI 字段引用的视频素材库尚未配置。");
        }
        state.pendingVideoPick = {
          target: targetKey,
          section,
          returnSection: state.section,
          presetId: context.presetId || "",
          fieldPath: context.fieldPath || "",
        };
        selectSection(section);
        setStatus(`请选择一个视频填入${target.label}。`);
      };

      const applyPickedVideo = (pick, video) => {
        const target = videoPickTargets[pick?.target];
        const videoValue = mediaContentValue(video);
        if (!target || !videoValue) return;
        target.apply(video, videoValue, pick);
        state.pendingVideoPick = null;
        if (pick.returnSection) selectSection(pick.returnSection);
        setStatus(`已把选中的视频填入${target.label}。`);
      };

      const selectImage = (image) => {
        state.current.image = image;
        const preview = $("[data-selected-image-preview]");
        const empty = $("[data-selected-image-empty]");
        preview.hidden = !image?.publicPath;
        preview.classList.toggle("hidden", !image?.publicPath);
        empty.hidden = !!image?.publicPath;
        if (image?.publicPath) preview.src = assetPreviewUrl(image);
        else preview.removeAttribute("src");
        $("[data-selected-image-path]").value = mediaContentValue(image);
        renderList();
        if (state.pendingImagePick && image?.publicPath) applyPickedImage(state.pendingImagePick, image);
      };

      const selectVideo = (video) => {
        state.current.video = video;
        const preview = $("[data-selected-video-preview]");
        const empty = $("[data-selected-video-empty]");
        preview.hidden = !video?.publicPath;
        preview.classList.toggle("hidden", !video?.publicPath);
        empty.hidden = !!video?.publicPath;
        if (video?.publicPath) preview.src = assetPreviewUrl(video);
        else preview.removeAttribute("src");
        $("[data-selected-video-path]").value = mediaContentValue(video);
        renderList();
        if (state.pendingVideoPick && video?.publicPath) applyPickedVideo(state.pendingVideoPick, video);
      };

      const queueMediaUploads = async (files, kindOrSection) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        if (!files.length) return;
        const config = mediaLibraries[kindOrSection] || (kindOrSection === "image" ? mediaLibraries.images : mediaLibraries.videos);
        const kind = config.kind;
        const isImage = kind === "image";
        const section = mediaLibraries[kindOrSection] ? kindOrSection : kindOrSection === "image" ? "images" : "videos";
        const directory = mediaTargetDirectory(section);
        const publicRoot = mediaTargetPublicRoot(kindOrSection);
        const remote = mediaStorageMode() === "r2";
        validateMediaFiles(files, kind);
        setStatus("加入" + files.length + " 个" + (isImage ? "图片" : "视频") + "到待同步队列中...");
        for (const file of files) {
          const safeName = makeUploadName(file);
          const publicPath = publicRoot + "/" + safeName;
          const path = remote ? mediaKeyFromPublicPath(publicPath) : directory + "/" + safeName;
          state.pendingMedia.uploads.push({
            kind,
            name: safeName,
            path,
            key: mediaKeyFromPublicPath(publicPath),
            publicPath,
            ...(remote ? { url: mediaUrlFromPublicPath(publicPath) } : {}),
            ...(remote ? { file, remote: true } : { content: arrayBufferToBase64(await file.arrayBuffer()) }),
            previewUrl: URL.createObjectURL(file),
            pending: true,
            draftKind: "media-upload",
          });
          selectDraft(state.pendingMedia.uploads.at(-1), true);
        }
        clearSelections(kind);
        const latest = state.pendingMedia.uploads.filter((item) => item.kind === kind && item.publicPath?.startsWith(`${publicRoot}/`)).at(-1);
        if (isImage) selectImage(latest);
        else selectVideo(latest);
        updatePendingMediaUi();
        setStatus("已加入待同步队列。继续操作，最后点“同步待处理操作”即可一次提交。");
      };

      const queueMediaDeletes = (kind) => {
        if (mediaStorageMode() === "r2") requireMediaAccess();
        else requireWriteAccess();
        const isImage = kind === "image";
        const assets = selectedAssets(kind);
        if (!assets.length) throw new Error("请先勾选要删除的" + (isImage ? "图片" : "视频"));
        const names = assets.map((asset) => asset.name || asset.publicPath).join("、");
        if (!confirm("确定把 " + assets.length + " 个" + (isImage ? "图片" : "视频") + "加入删除队列吗？\n" + names + "\n\n真正删除会在你点击“同步待处理操作”后发生。")) return;
        for (const asset of assets) {
          const pendingUploadIndex = state.pendingMedia.uploads.findIndex((item) => item.kind === kind && item.path === asset.path);
          if (pendingUploadIndex >= 0) {
            const [removed] = state.pendingMedia.uploads.splice(pendingUploadIndex, 1);
            if (removed.previewUrl) URL.revokeObjectURL(removed.previewUrl);
            continue;
          }
          if (!isPendingDelete(kind, asset.path)) {
            state.pendingMedia.deletes.push({
              kind,
              name: asset.name,
              path: asset.path,
              key: asset.key || mediaKeyFromPublicPath(asset.publicPath),
              publicPath: asset.publicPath,
              remote: usesRemoteMedia(asset),
              draftKind: "media-delete",
            });
            selectDraft(state.pendingMedia.deletes.at(-1), true);
          }
        }
        clearSelections(kind);
        if (isImage && assets.some((asset) => asset.path === state.current.image?.path)) selectImage(null);
        if (!isImage && assets.some((asset) => asset.path === state.current.video?.path)) selectVideo(null);
        renderList();
        updatePendingMediaUi();
        setStatus("已加入删除队列。继续操作，最后点“同步待处理操作”即可一次提交。");
      };

      const syncPendingMedia = async () => {
        requireWriteAccess();
        const uploads = [...state.pendingMedia.uploads];
        const deletes = [...state.pendingMedia.deletes];
        if (!uploads.length && !deletes.length) throw new Error("暂无待同步操作");
        const summaryParts = [];
        const imageUploads = uploads.filter((item) => item.kind === "image").length;
        const videoUploads = uploads.filter((item) => item.kind === "video").length;
        const imageDeletes = deletes.filter((item) => item.kind === "image").length;
        const videoDeletes = deletes.filter((item) => item.kind === "video").length;
        if (imageUploads) summaryParts.push("add " + imageUploads + " images");
        if (videoUploads) summaryParts.push("add " + videoUploads + " videos");
        if (imageDeletes) summaryParts.push("delete " + imageDeletes + " images");
        if (videoDeletes) summaryParts.push("delete " + videoDeletes + " videos");
        const summary = summaryParts.join(", ");
        if (!confirm("确定同步待处理操作吗？\n" + summary + "\n\n这会在 GitHub main 分支生成 1 次 commit。")) return;

        setStatus("创建 GitHub 批量提交中...");
        const branchRef = await getBranchRef();
        const parentSha = branchRef.object.sha;
        const parentCommit = await getGitCommit(parentSha);
        const treeEntries = [];
        for (const upload of uploads) {
          const blob = await createGitBlob({ content: upload.content });
          treeEntries.push({
            path: upload.path,
            mode: "100644",
            type: "blob",
            sha: blob.sha,
          });
        }
        for (const deleted of deletes) {
          treeEntries.push({
            path: deleted.path,
            mode: "100644",
            type: "blob",
            sha: null,
          });
        }
        const tree = await createGitTree({
          baseTreeSha: parentCommit.tree.sha,
          tree: treeEntries,
        });
        const commit = await createGitCommit({
          message: `Sync media assets: ${summary}`,
          treeSha: tree.sha,
          parentSha,
        });
        await updateBranchRef(commit.sha);

        uploads.forEach((upload) => {
          if (upload.previewUrl) URL.revokeObjectURL(upload.previewUrl);
        });
        state.pendingMedia.uploads = [];
        state.pendingMedia.deletes = [];
        state.pendingMedia.selectedImages.clear();
        state.pendingMedia.selectedVideos.clear();
        await loadAllMediaLibraries();
        selectImage(null);
        selectVideo(null);
        updateCounts();
        renderList();
        setStatus("待处理媒体操作已同步为 1 次 Git commit。");
      };

      const deleteImage = async () => {
        requireWriteAccess();
        const image = state.current.image;
        if (!image?.path) throw new Error("请选择一张图片");
        if (!confirm(`确定删除图片「${image.name}」吗？如果文章或图集还在引用它，页面会显示破图。`)) return;
        const sha = image.sha || (await getFile(image.path)).sha;
        await deleteFile({ path: image.path, sha, message: `Delete image: ${image.name}` });
        state.current.image = null;
        await loadImages();
        updateCounts();
        selectImage(null);
        renderList();
        setStatus("图片已删除。");
      };

      const deleteVideo = async () => {
        requireWriteAccess();
        const video = state.current.video;
        if (!video?.path) throw new Error("请选择一个视频");
        if (!confirm(`确定删除视频「${video.name}」吗？如果文章或项目还在引用它，页面会显示无法播放。`)) return;
        const sha = video.sha || (await getFile(video.path)).sha;
        await deleteFile({ path: video.path, sha, message: `Delete video: ${video.name}` });
        state.current.video = null;
        await loadVideos();
        updateCounts();
        selectVideo(null);
        renderList();
        setStatus("视频已删除。");
      };

      const captureSettingsInputState = () => ({
        sharedDirty: state.sharedSettingsDirty,
        uiAppearanceDirty: state.uiAppearanceDirty,
        uiAppearancePreset: state.uiAppearancePreset,
        sharedValues: state.sharedSettingsDirty
          ? settingsFields
              .filter((field) => sharedSettingsInputIsDirty(field))
              .map((field) => [field.dataset.settingsField, field.value])
          : [],
        appearanceValues: state.uiAppearanceDirty
          ? uiAppearanceFields
              .filter((field) => uiAppearanceInputIsDirty(field))
              .map((field) => [
                field.dataset.uiAppearancePreset,
                field.dataset.uiAppearanceField,
                uiAppearanceControlValue(field),
              ])
          : [],
      });

      const restoreSettingsInputState = (snapshot) => {
        if (uiPresetIds.has(snapshot.uiAppearancePreset)) {
          state.uiAppearancePreset = snapshot.uiAppearancePreset;
        }
        snapshot.sharedValues.forEach(([fieldPath, value]) => {
          const field = settingsFields.find((candidate) => candidate.dataset.settingsField === fieldPath);
          if (field) field.value = value;
        });
        snapshot.appearanceValues.forEach(([presetId, fieldPath, value]) => {
          const field = uiAppearanceFields.find(
            (candidate) =>
              candidate.dataset.uiAppearancePreset === presetId &&
              candidate.dataset.uiAppearanceField === fieldPath,
          );
          if (field) setUiAppearanceControlValue(field, value);
        });
        state.sharedSettingsDirty = snapshot.sharedDirty && sharedSettingsInputsAreDirty();
        state.uiAppearanceDirty = snapshot.uiAppearanceDirty && uiAppearanceInputsAreDirty();
        renderUiAppearanceEditor();
        renderUiPresetSelection();
      };

      const connect = async () => {
        const token = $("[data-token-input]").value.trim();
        const mediaToken = $("[data-media-token-input]").value.trim();
        if (!token && !mediaToken) return;
        const settingsInputState = captureSettingsInputState();
        const hasPendingContentWork =
          state.pendingChanges.files.length > 0 || state.pendingChanges.deletes.length > 0;
        state.token = token;
        state.mediaToken = mediaToken;
        state.mode = "github";
        sessionStorage.removeItem(TOKEN_KEY);
        sessionStorage.removeItem(MEDIA_TOKEN_KEY);
        if (token) sessionStorage.setItem(TOKEN_KEY, token);
        if (mediaToken) sessionStorage.setItem(MEDIA_TOKEN_KEY, mediaToken);
        if (hasPendingContentWork) {
          const mediaStatus = await loadMediaLibrariesSafely();
          updateCounts();
          renderList();
          renderUiPresetSelection();
          setStatus(`凭据已更新。为保护待同步内容草稿，页面内容没有重新加载；${mediaStatus}`);
          return;
        }
        const contentReady = await loadAll();
        restoreSettingsInputState(settingsInputState);
        if (allPendingMedia().length) {
          setStatus(
            contentReady
              ? "GitHub 最新内容与素材库已刷新，待同步媒体队列和未保存的页面配置输入均已保留。"
              : "素材库已刷新，待同步媒体队列和未保存的页面配置输入均已保留。",
          );
        } else if ((state.sharedSettingsDirty || state.uiAppearanceDirty) && contentReady) {
          setStatus("GitHub 内容已刷新，连接前尚未保存的页面配置输入已保留。");
        } else if (state.sharedSettingsDirty || state.uiAppearanceDirty) {
          setStatus("连接前的页面配置输入已保留，但 GitHub 最新内容没有完整加载；请检查 Token 后重新连接。");
        }
      };

      const clearToken = async () => {
        const hasUnsavedWork =
          allPendingChanges().length > 0 || state.sharedSettingsDirty || state.uiAppearanceDirty;
        state.token = "";
        state.mediaToken = "";
        sessionStorage.removeItem(TOKEN_KEY);
        sessionStorage.removeItem(MEDIA_TOKEN_KEY);
        $("[data-token-input]").value = "";
        $("[data-media-token-input]").value = "";
        state.mode = "readonly";
        if (hasUnsavedWork) {
          renderUiPresetSelection();
          setStatus("凭据已清除。为保护待同步草稿或未保存输入，当前内容没有重新加载。");
          return;
        }
        state.remoteContentReady = false;
        await loadAll();
      };

      const run = async (task) => {
        try {
          await task();
        } catch (error) {
          setStatus(error.message || "操作失败");
        }
      };

      window.addEventListener("beforeunload", (event) => {
        if (!allPendingChanges().length && !state.sharedSettingsDirty && !state.uiAppearanceDirty) return;
        event.preventDefault();
        event.returnValue = "";
      });

      $$("[data-section]").forEach((button) => {
        button.addEventListener("click", () => selectSection(button.dataset.section));
      });
      $$("[data-switch-section]").forEach((button) => {
        button.addEventListener("click", () => selectSection(button.dataset.switchSection));
      });

      $("[data-save-token]").addEventListener("click", () => run(connect));
      $("[data-token-input]").value = state.token;
      $("[data-media-token-input]").value = state.mediaToken;
      $("[data-auth-form]").addEventListener("submit", (event) => {
        event.preventDefault();
        run(connect);
      });
      $("[data-clear-token]").addEventListener("click", () => run(clearToken));
      $("[data-new-current]").addEventListener("click", () => {
        if (state.section === "posts") newPost();
        if (state.section === "projects") newProject();
        if (state.section === "recommendations") newRecommendation();
        if (state.section === "gallery") newGallery();
        if (state.section === "personalVideos") newPersonalVideo();
        if (state.section === "settings") run(saveSettings);
      });

      $$("[data-image-pick-target]").forEach((button) => {
        button.addEventListener("click", () => run(() => startImagePicker(
          button.dataset.imagePickTarget,
          button.dataset.imagePickSection,
          {
            presetId: button.dataset.imagePickPreset,
            fieldPath: button.dataset.imagePickField,
          },
        )));
      });
      $$("[data-video-pick-target]").forEach((button) => {
        button.addEventListener("click", () => run(() => startVideoPicker(
          button.dataset.videoPickTarget,
          button.dataset.videoPickSection,
          {
            presetId: button.dataset.videoPickPreset,
            fieldPath: button.dataset.videoPickField,
          },
        )));
      });

      $("[data-save-post]").addEventListener("click", () => run(savePost));
      $("[data-delete-post]").addEventListener("click", () => run(deletePost));
      $("[data-post-upload-cover]").addEventListener("click", () => $("[data-post-cover-file]").click());
      $("[data-post-cover-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file]);
          postFields.cover.value = mediaContentValue(image);
        });
      });
      $("[data-post-upload-body-image]").addEventListener("click", () => $("[data-post-body-image-file]").click());
      $("[data-post-body-image-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file]);
          insertImageMarkdown(image);
          setStatus("图片已上传到 ARTICLE_IMAGE_ASSETS，并插入正文。");
        });
      });
      $("[data-post-upload-video]").addEventListener("click", () => $("[data-post-video-file]").click());
      $("[data-post-video-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const video = await uploadVideo(file);
          insertVideoHtml(video);
          setStatus("视频已上传到 videos，并插入正文。");
        });
      });
      $("[data-post-insert-selected-image]").addEventListener("click", () =>
        run(async () => {
          insertImageMarkdown(state.current.image);
          setStatus("已把选中的 ARTICLE_IMAGE_ASSETS 图片插入正文。");
        }),
      );

      $("[data-save-project]").addEventListener("click", () => run(saveProject));
      $("[data-delete-project]").addEventListener("click", () => run(deleteProject));

      $("[data-save-recommendation]").addEventListener("click", () => run(saveRecommendation));
      $("[data-delete-recommendation]").addEventListener("click", () => run(deleteRecommendation));
      $("[data-recommendation-upload-image]").addEventListener("click", () => $("[data-recommendation-image-file]").click());
      $("[data-recommendation-image-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file], {
            directory: RECOMMENDATION_ASSETS_PATH,
            publicRoot: "/recommendation-assets",
            reloadAssets: false,
          });
          recommendationFields.image.value = mediaContentValue(image);
          renderRecommendationPreview();
          setStatus("推荐封面已上传到 RECOMMENDATION_ASSETS。");
        });
      });
      $("[data-recommendation-use-selected-image]").addEventListener("click", () =>
        run(async () => {
          const imageValue = mediaContentValue(state.current.image);
          if (!imageValue) throw new Error("请先在 ARTICLE_IMAGE_ASSETS 选择一张图片");
          recommendationFields.image.value = imageValue;
          renderRecommendationPreview();
          setStatus("已把选中的 ARTICLE_IMAGE_ASSETS 图片设为推荐封面。");
        }),
      );

      $("[data-save-gallery]").addEventListener("click", () => run(saveGallery));
      $("[data-delete-gallery]").addEventListener("click", () => run(deleteGallery));
      $("[data-gallery-upload-image]").addEventListener("click", () => $("[data-gallery-image-file]").click());
      $("[data-gallery-image-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file], {
            directory: PERSONAL_PHOTO_PATH,
            publicRoot: "/personal-photo",
            reloadAssets: false,
          });
          galleryFields.image.value = mediaContentValue(image);
          renderGalleryPreview();
          setStatus("PersonalPhoto 已上传，请补充标题和描述后保存照片。");
        });
      });

      $("[data-save-personal-video]").addEventListener("click", () => run(savePersonalVideo));
      $("[data-delete-personal-video]").addEventListener("click", () => run(deletePersonalVideo));
      $("[data-personal-video-upload]").addEventListener("click", () => $("[data-personal-video-file]").click());
      $("[data-personal-video-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const video = await uploadVideo(file, {
            directory: PERSONAL_VIDEO_PATH,
            publicRoot: "/personal-video",
            reloadAssets: false,
          });
          personalVideoFields.video.value = mediaContentValue(video);
          renderPersonalVideoPreview();
          setStatus("PersonalVideo 已上传，请补充标题和描述后保存视频。");
        });
      });
      $("[data-personal-video-poster-upload]").addEventListener("click", () => $("[data-personal-video-poster-file]").click());
      $("[data-personal-video-poster-file]").addEventListener("change", (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        run(async () => {
          const [image] = await uploadImages([file]);
          personalVideoFields.poster.value = mediaContentValue(image);
          renderPersonalVideoPreview();
          setStatus("视频封面图已上传到 ARTICLE_IMAGE_ASSETS。");
        });
      });

      $("[data-upload-image]").addEventListener("click", () => $("[data-image-file]").click());
      $("[data-image-file]").addEventListener("change", (event) =>
        run(async () => {
          await queueMediaUploads(Array.from(event.target.files || []), "image");
          event.target.value = "";
        }),
      );
      $("[data-delete-image]").addEventListener("click", () => run(() => queueMediaDeletes("image")));

      $("[data-upload-personal-photo-asset]").addEventListener("click", () => $("[data-personal-photo-asset-file]").click());
      $("[data-personal-photo-asset-file]").addEventListener("change", (event) =>
        run(async () => {
          await queueMediaUploads(Array.from(event.target.files || []), "personalPhotoAssets");
          event.target.value = "";
        }),
      );
      $("[data-delete-personal-photo-asset]").addEventListener("click", () => run(() => queueMediaDeletes("image")));

      $("[data-upload-video]").addEventListener("click", () => $("[data-video-file]").click());
      $("[data-video-file]").addEventListener("change", (event) => {
        const files = Array.from(event.target.files || []);
        run(async () => {
          await queueMediaUploads(files, "video");
          event.target.value = "";
        });
      });
      $("[data-insert-selected-video]").addEventListener("click", () =>
        run(async () => {
          insertVideoHtml(state.current.video);
          setStatus("已把选中的 ARTICLE_VIDEO_ASSETS 视频插入正文。");
          selectSection("posts");
        }),
      );
      $("[data-delete-video]").addEventListener("click", () => run(() => queueMediaDeletes("video")));

      $("[data-upload-personal-video-asset]").addEventListener("click", () => $("[data-personal-video-asset-file]").click());
      $("[data-personal-video-asset-file]").addEventListener("change", (event) => {
        const files = Array.from(event.target.files || []);
        run(async () => {
          await queueMediaUploads(files, "personalVideoAssets");
          event.target.value = "";
        });
      });
      $("[data-delete-personal-video-asset]").addEventListener("click", () => run(() => queueMediaDeletes("video")));

      $$("[data-media-create-folder]").forEach((button) => {
        button.addEventListener("click", () => run(() => createMediaFolder(button.dataset.mediaCreateFolder)));
      });
      $$("[data-media-folder-input]").forEach((input) => {
        input.addEventListener("keydown", (event) => {
          if (event.key !== "Enter") return;
          event.preventDefault();
          run(() => createMediaFolder(input.dataset.mediaFolderInput));
        });
      });
      $$("[data-media-parent-folder]").forEach((button) => {
        button.addEventListener("click", () => run(() => selectMediaDirectory(button.dataset.mediaParentFolder, parentPublicRoot(button.dataset.mediaParentFolder))));
      });

      $$("[data-sync-media]").forEach((button) => button.addEventListener("click", () => run(syncPendingChanges)));
      $("[data-sync-all]").addEventListener("click", () => run(syncPendingChanges));
      $("[data-sync-selected-drafts]").addEventListener("click", () => run(syncSelectedPendingChanges));
      $("[data-select-all-drafts]").addEventListener("click", () => {
        allPendingChanges().forEach((item) => selectDraft(item, true));
        updatePendingChangesUi();
      });
      $("[data-select-no-drafts]").addEventListener("click", () => {
        state.pendingDraftSelection.clear();
        updatePendingChangesUi();
      });
      $$("[data-ui-preset-set-default]").forEach((button) => {
        button.addEventListener("click", () => run(() => setDefaultUiPreset(button.dataset.uiPresetSetDefault)));
      });
      uiPresetSelect?.addEventListener("change", renderUiPresetSelection);
      uiAppearanceSelect?.addEventListener("change", () => run(() => selectUiAppearancePreset(uiAppearanceSelect.value)));
      $$("[data-save-settings]").forEach((button) => button.addEventListener("click", () => run(saveSettings)));
      $$("[data-save-ui-appearance]").forEach((button) => button.addEventListener("click", () => run(saveUiAppearanceSettings)));
      settingsFields.forEach((field) => {
        field.addEventListener("input", () => {
          state.sharedSettingsDirty = sharedSettingsInputsAreDirty();
          renderUiPresetSelection();
        });
      });
      uiAppearanceFields.forEach((field) => {
        field.addEventListener("input", () => {
          delete field.dataset.uiAppearanceMissing;
          state.uiAppearanceDirty = uiAppearanceInputsAreDirty();
          renderUiAppearanceEditor();
          renderUiPresetSelection();
        });
      });

      Object.values(postFields).forEach((field) => field.addEventListener("input", renderMarkdownPreview));
      Object.values(recommendationFields).forEach((field) => field.addEventListener("input", renderRecommendationPreview));
      Object.values(galleryFields).forEach((field) => field.addEventListener("input", renderGalleryPreview));
      Object.values(personalVideoFields).forEach((field) => field.addEventListener("input", renderPersonalVideoPreview));

      const prepareEmptyEditors = () => {
        try {
          updateCounts();
          selectSection("posts");
          newPost();
          newProject();
          newRecommendation();
          newGallery();
          newPersonalVideo();
          updatePendingChangesUi();
        } catch (error) {
          console.warn("Initial empty editor setup failed; content loading will continue.", error);
        }
      };

      const initialize = async () => {
        if (state.token) $("[data-token-input]").value = state.token;
        await detectLocalApi();
        await loadAll();
      };

      prepareEmptyEditors();
      run(initialize);
    </script>
  </body>
</html>
