                    <p class="mt-2 text-sm leading-6 text-[var(--muted)]">每行一个导航：显示|文字|链接。例如：true|文章|/articles/</p>
                  </div>
                </div>
                <textarea class="orbit-input mt-4 min-h-56 font-mono text-sm" data-settings-field="navText"></textarea>
              </section>
            </div>
          </section>
        </section>
        </div>
      </div>
    </main>

    <script type="application/json" id="initial-data" set:html={JSON.stringify(initialData)}></script>

    <script>
      const INITIAL_DATA = JSON.parse(document.getElementById("initial-data").textContent);
      const OWNER = "FatDunDun";
      const REPO = "PersonalWebsite";
      const BRANCH = "main";
      const POSTS_PATH = "src/content/posts";
      const PROJECTS_PATH = "src/data/projects.ts";
      const RECOMMENDATIONS_PATH = "src/data/recommendations.ts";
      const GALLERY_PATH = "src/data/gallery.ts";
      const PERSONAL_VIDEOS_DATA_PATH = "src/data/videos.ts";
      const SETTINGS_PATH = "src/data/siteSettings.ts";
      const IMAGES_PATH = "public/images";
      const PERSONAL_PHOTO_PATH = "public/personal-photo";
      const VIDEOS_PATH = "public/videos";
      const PERSONAL_VIDEO_PATH = "public/personal-video";
      const TOKEN_KEY = "silent-orbit-token";
      const MEDIA_TOKEN_KEY = "silent-orbit-media-token";
      const BASE_URL = import.meta.env.BASE_URL;
      const MEDIA_API_URL = import.meta.env.PUBLIC_MEDIA_API_URL || "";
      const ASSET_BASE_URL = import.meta.env.PUBLIC_ASSET_BASE_URL || "";

      const state = {
        mode: "readonly",
        token: sessionStorage.getItem(TOKEN_KEY) || localStorage.getItem(TOKEN_KEY) || "",
        mediaToken: sessionStorage.getItem(MEDIA_TOKEN_KEY) || localStorage.getItem(MEDIA_TOKEN_KEY) || "",
        section: "posts",
        posts: [],
        projects: [],
        recommendations: [],
        gallery: [],
        personalVideos: [],
        images: [],
        videos: [],
        pendingMedia: {
          uploads: [],
          deletes: [],
          selectedImages: new Set(),
          selectedVideos: new Set(),
        },
        pendingChanges: {
          files: [],
          deletes: [],
        },
        settings: null,
        files: {
          projects: null,
          recommendations: null,
          gallery: null,
          personalVideos: null,
          settings: null,
        },
        current: {
          post: null,
          projectIndex: -1,
          recommendationIndex: -1,
          galleryIndex: -1,
          personalVideoIndex: -1,
          image: null,
          video: null,
        },
      };

      const $ = (selector) => document.querySelector(selector);
      const $$ = (selector) => Array.from(document.querySelectorAll(selector));
      const status = $("[data-status]");
      const list = $("[data-list]");
      const listKicker = $("[data-list-kicker]");
      const listTitle = $("[data-list-title]");
      const pendingSummary = $("[data-pending-summary]");

      const postFields = {
        slug: $('[data-post-field="slug"]'),
        title: $('[data-post-field="title"]'),
        description: $('[data-post-field="description"]'),
        publishDate: $('[data-post-field="publishDate"]'),
        cover: $('[data-post-field="cover"]'),
        tags: $('[data-post-field="tags"]'),
        draft: $('[data-post-field="draft"]'),
        body: $('[data-post-field="body"]'),
      };

      const projectFields = {
        name: $('[data-project-field="name"]'),
        year: $('[data-project-field="year"]'),
        description: $('[data-project-field="description"]'),
        tags: $('[data-project-field="tags"]'),
        link: $('[data-project-field="link"]'),
      };

      const recommendationFields = {
        title: $('[data-recommendation-field="title"]'),
        category: $('[data-recommendation-field="category"]'),
        creator: $('[data-recommendation-field="creator"]'),
        year: $('[data-recommendation-field="year"]'),
        description: $('[data-recommendation-field="description"]'),
        image: $('[data-recommendation-field="image"]'),
        link: $('[data-recommendation-field="link"]'),
        rating: $('[data-recommendation-field="rating"]'),
        tags: $('[data-recommendation-field="tags"]'),
      };

      const galleryFields = {
        title: $('[data-gallery-field="title"]'),
        description: $('[data-gallery-field="description"]'),
        image: $('[data-gallery-field="image"]'),
        height: $('[data-gallery-field="height"]'),
      };

      const personalVideoFields = {
        title: $('[data-personal-video-field="title"]'),
        description: $('[data-personal-video-field="description"]'),
        date: $('[data-personal-video-field="date"]'),
        video: $('[data-personal-video-field="video"]'),
        poster: $('[data-personal-video-field="poster"]'),
      };

      const settingsFields = $$("[data-settings-field]");

      const labels = {
        posts: { kicker: "Posts", title: "文章列表", empty: "暂无文章。" },
        projects: { kicker: "Projects", title: "项目列表", empty: "暂无项目。" },
        recommendations: { kicker: "Taste", title: "推荐列表", empty: "暂无推荐。" },
        gallery: { kicker: "PersonalPhoto", title: "生活照片", empty: "暂无照片。" },
        personalVideos: { kicker: "PersonalVideo", title: "视频记录", empty: "暂无视频记录。" },
        images: { kicker: "Assets", title: "素材图片", empty: "暂无素材图片。" },
        videos: { kicker: "Video Assets", title: "素材视频", empty: "暂无素材视频。" },
        settings: { kicker: "Settings", title: "页面配置", empty: "在右侧编辑网站配置。" },
      };

      const setStatus = (message) => {
        status.textContent = message;
      };

      const escapeHtml = (value = "") =>
        String(value).replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);

      const formatDate = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.valueOf())) return String(value);
        return new Intl.DateTimeFormat("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        }).format(date);
      };

      const postSlug = (post) => post.slug || post.name?.replace(/\.(md|mdx)$/, "") || "";
      const postDisplayTitle = (post) => post.data?.title || post.title || postSlug(post) || "未命名文章";
      const isPersonalPhotoPath = (path = "") => path.startsWith("/personal-photo/");

      const slugify = (value) =>
        value
          .trim()
          .toLowerCase()
          .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 80);

      const slugifyFile = (value) =>
        value
          .trim()
          .toLowerCase()
          .normalize("NFKD")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 60);

      const toBase64 = (text) => {
        const bytes = new TextEncoder().encode(text);
        let binary = "";
        for (let index = 0; index < bytes.length; index += 1) binary += String.fromCharCode(bytes[index]);
        return btoa(binary);
      };

      const fromBase64 = (base64) => {
        const binary = atob(base64.replace(/\n/g, ""));
        const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
        return new TextDecoder().decode(bytes);
      };

      const arrayBufferToBase64 = (buffer) => {
        const bytes = new Uint8Array(buffer);
        let binary = "";
        for (let index = 0; index < bytes.length; index += 1) binary += String.fromCharCode(bytes[index]);
        return btoa(binary);
      };

      const withBase = (path) => {
        if (!path) return "";
        if (/^https?:\/\//.test(path)) return path;
        const base = BASE_URL.endsWith("/") ? BASE_URL : `${BASE_URL}/`;
        return new URL(`${base}${path.replace(/^\/+/, "")}`, location.origin).toString();
      };

      const assetUrl = (path) => {
        if (!path) return "";
        if (/^https?:\/\//.test(path)) return path;
        const cleanPath = path.replace(/^\/+/, "");
        if (ASSET_BASE_URL && /^(images|personal-photo|videos|personal-video)\//.test(cleanPath)) {
          return `${ASSET_BASE_URL.replace(/\/$/, "")}/${cleanPath}`;
        }
        return withBase(path);
      };

      const publicPathToRepoPath = (path) => (path?.startsWith("/") ? `public${path}` : "");

      const clone = (value) => JSON.parse(JSON.stringify(value));

      const mediaStorageMode = () => (MEDIA_API_URL ? "r2" : "github");

      const usesRemoteMedia = (item) => item?.remote === true || mediaStorageMode() === "r2";

      const detectLocalApi = async () => {
        state.mode = state.token ? "github" : "readonly";
      };

      const requireWriteAccess = () => {
        if (!state.token) throw new Error("暂存、删除、上传和同步需要先输入 GitHub Token。改动会先留在当前页面，点“同步全部改动”后才提交到 GitHub main 分支。");
      };

      const requireMediaAccess = () => {
        if (mediaStorageMode() !== "r2") return;
        if (!state.mediaToken) throw new Error("R2 上传、删除和读取素材库需要先输入 Media Token。这个值对应 Cloudflare Worker 的 ADMIN_TOKEN。");
      };

      const mediaApi = async (path, options = {}) => {
        requireMediaAccess();
        const response = await fetch(`${MEDIA_API_URL.replace(/\/$/, "")}${path}`, {
          ...options,
          headers: {
            Authorization: `Bearer ${state.mediaToken}`,
            ...(options.headers || {}),
          },
        });
        const data = await response.json().catch(() => null);
        if (!response.ok) throw new Error(data?.message || `Media API error ${response.status}`);
        return data;
      };

      const mediaKeyFromPublicPath = (path = "") => path.replace(/^\/+/, "");

      const mediaRootFromPublicRoot = (publicRoot = "/images") => publicRoot.replace(/^\/+|\/+$/g, "");

      const mediaApiList = async (publicRoot) => {
        const prefix = mediaRootFromPublicRoot(publicRoot);
        const data = await mediaApi(`/media?prefix=${encodeURIComponent(prefix)}`);
        return (data.objects || []).map((item) => ({
          name: item.name,
          key: item.key,
          path: item.key,
          publicPath: item.path,
          url: item.url,
          size: item.size,
          uploaded: item.uploaded,
          remote: true,
          type: "file",
        }));
      };

      const mediaApiUpload = async (upload) => {
        const form = new FormData();
        form.append("key", upload.key || mediaKeyFromPublicPath(upload.publicPath));
        form.append("file", upload.file, upload.name);
        return mediaApi("/media/upload", {
          method: "POST",
          body: form,
        });
      };

      const mediaApiDelete = async (asset) => {
        const key = asset.key || mediaKeyFromPublicPath(asset.publicPath);
        return mediaApi(`/media?key=${encodeURIComponent(key)}`, {
          method: "DELETE",
        });
      };

      const syncRemoteMediaOperations = async ({ uploads, deletes }) => {
        if (!uploads.length && !deletes.length) return;
        requireMediaAccess();
        for (const upload of uploads) await mediaApiUpload(upload);
        for (const deleted of deletes) await mediaApiDelete(deleted);
      };

      const github = async (path, options = {}) => {
        const method = options.method || "GET";
        const isWrite = method !== "GET";
        if (isWrite && !state.token) throw new Error("保存、删除、上传需要先输入 GitHub Token");
        const response = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}${path}`, {
          ...options,
          headers: {
            Accept: "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            ...(state.token ? { Authorization: `Bearer ${state.token}` } : {}),
            ...(options.headers || {}),
          },
        });
        const data = await response.json().catch(() => null);
        if (!response.ok) throw new Error(data?.message || `GitHub API error ${response.status}`);
        return data;
      };

      const getFile = async (path) => {
        return github(`/contents/${path}?ref=${BRANCH}`);
      };

      const getDir = async (path) => {
        return github(`/contents/${path}?ref=${BRANCH}`);
      };

      const putFile = async ({ path, content, message, sha }) => {
        return github(`/contents/${path}`, {
          method: "PUT",
          body: JSON.stringify({
            message,
            content,
            branch: BRANCH,
            ...(sha ? { sha } : {}),
          }),
        });
      };

      const deleteFile = async ({ path, sha, message }) => {
        return github(`/contents/${path}`, {
          method: "DELETE",
          body: JSON.stringify({
            message,
            sha,
            branch: BRANCH,
          }),
        });
      };

      const getBranchRef = async () => {
        return github(`/git/ref/heads/${BRANCH}`);
      };

      const getGitCommit = async (sha) => {
        return github(`/git/commits/${sha}`);
      };

      const createGitBlob = async ({ content }) => {
        return github("/git/blobs", {
          method: "POST",
          body: JSON.stringify({
            content,
            encoding: "base64",
          }),
        });
      };

      const createGitTree = async ({ baseTreeSha, tree }) => {
        return github("/git/trees", {
          method: "POST",
          body: JSON.stringify({
            base_tree: baseTreeSha,
            tree,
          }),
        });
      };

      const createGitCommit = async ({ message, treeSha, parentSha }) => {
        return github("/git/commits", {
          method: "POST",
          body: JSON.stringify({
            message,
            tree: treeSha,
            parents: [parentSha],
          }),
        });
      };

      const updateBranchRef = async (sha) => {
        return github(`/git/refs/heads/${BRANCH}`, {
          method: "PATCH",
          body: JSON.stringify({
            sha,
            force: false,
          }),
        });
      };

      const parseFrontmatter = (content) => {
        const match = content.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
        if (!match) return { data: {}, body: content };
        const data = {};
        for (const line of match[1].split("\n")) {
          const [rawKey, ...rest] = line.split(":");
          if (!rawKey || rest.length === 0) continue;
          const key = rawKey.trim();
          const value = rest.join(":").trim();
          if (value.startsWith("[") && value.endsWith("]")) {
            data[key] = value
              .slice(1, -1)
              .split(",")
              .map((item) => item.trim().replace(/^"|"$/g, ""))
              .filter(Boolean);
          } else if (value === "true" || value === "false") {
            data[key] = value === "true";
          } else {
            data[key] = value.replace(/^"|"$/g, "");
          }
        }
        return { data, body: match[2] };
      };

      const readExportedArray = (content, exportName) => {
        const match = content.match(new RegExp(`export\\s+const\\s+${exportName}(?:\\s*:[^=]+)?\\s*=\\s*([\\s\\S]*);?\\s*$`));
        if (!match) throw new Error(`无法解析 ${exportName}`);
        return Function(`"use strict"; return (${match[1].replace(/;\s*$/, "")});`)();
      };

      const readExportedValue = (content, exportName) => {
        const match = content.match(new RegExp(`export\\s+const\\s+${exportName}(?:\\s*:[^=]+)?\\s*=\\s*([\\s\\S]*);?\\s*$`));
        if (!match) throw new Error(`无法解析 ${exportName}`);
        return Function(`"use strict"; return (${match[1].replace(/;\s*$/, "")});`)();
      };

      const stringifyArrayModule = (exportName, items) => `export const ${exportName} = ${JSON.stringify(items, null, 2)};\n`;

      const stringifySettingsModule = (settings) => `export const siteSettings = ${JSON.stringify(settings, null, 2)};\n`;

      const getByPath = (object, path) =>
        path.split(".").reduce((target, key) => (target && Object.prototype.hasOwnProperty.call(target, key) ? target[key] : undefined), object);

      const setByPath = (object, path, value) => {
        const keys = path.split(".");
        let target = object;
        keys.slice(0, -1).forEach((key) => {
          if (!target[key] || typeof target[key] !== "object") target[key] = {};
          target = target[key];
        });
        target[keys.at(-1)] = value;
      };

      const stringifyNavText = (items = []) =>
        items
          .map((item) => `${item.visible !== false ? "true" : "false"}|${item.label || ""}|${item.href || ""}`)
          .join("\n");

      const stringifyCodeLines = (items = []) =>
        items.map((item) => `${item.label || ""}|${item.value || ""}`).join("\n");

      const parseCodeLines = (text) =>
        text
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const [label = "", ...rest] = line.split("|");
            return { label: label.trim() || "note", value: rest.join("|").trim() };
          })
          .filter((item) => item.value);

      const parseNavText = (text) =>
        text
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const [visible = "true", label = "", href = ""] = line.split("|").map((part) => part.trim());
            return { href: href || "/", label: label || "未命名", visible: visible !== "false" };
          });

      const stringifyPost = () => {
        const tags = postFields.tags.value
          .split(",")
          .map((tag) => tag.trim())
          .filter(Boolean);
        const lines = [
          "---",
          `title: "${postFields.title.value.trim().replaceAll('"', '\\"')}"`,
          `description: "${postFields.description.value.trim().replaceAll('"', '\\"')}"`,
          `publishDate: ${postFields.publishDate.value}`,
        ];
        if (postFields.cover.value.trim()) lines.push(`cover: "${postFields.cover.value.trim()}"`);
        lines.push(`tags: [${tags.map((tag) => `"${tag.replaceAll('"', '\\"')}"`).join(", ")}]`);
        if (postFields.draft.checked) lines.push("draft: true");
        lines.push("---", "", postFields.body.value.trim(), "");
        return lines.join("\n");
      };

      const renderMarkdownPreview = () => {
        const body = postFields.body.value || "";
        const html = escapeHtml(body)
          .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_match, alt, src) => {
            const url = src.startsWith("/") ? assetUrl(src) : src;
            return `<img src="${url}" alt="${alt}" loading="lazy" />`;
          })
          .replace(/&lt;video class=&quot;post-video&quot; controls playsinline preload=&quot;metadata&quot; src=&quot;([^&]+)&quot;&gt;&lt;\/video&gt;/g, (_match, src) => {
            const url = src.startsWith("/") ? assetUrl(src) : src;
            return `<video class="post-video" controls playsinline preload="metadata" src="${url}"></video>`;
          })
          .replace(/^### (.*)$/gm, "<h3>$1</h3>")
          .replace(/^## (.*)$/gm, "<h2>$1</h2>")
          .replace(/^# (.*)$/gm, "<h1>$1</h1>")
          .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
          .replace(/`([^`]+)`/g, "<code>$1</code>")
          .split(/\n{2,}/)
          .map((block) => (/^<(h[1-3]|img|video)\b/.test(block) ? block : `<p>${block.replace(/\n/g, "<br />")}</p>`))
          .join("");
        $("[data-post-preview]").innerHTML = html || "<p>预览会显示在这里。</p>";
      };

      const insertMarkdownAtCursor = (snippet) => {
        const textarea = postFields.body;
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? textarea.value.length;
        const before = textarea.value.slice(0, start);
        const after = textarea.value.slice(end);
        const prefix = before && !before.endsWith("\n") ? "\n\n" : "";
        const suffix = after && !after.startsWith("\n") ? "\n\n" : "";
        textarea.value = `${before}${prefix}${snippet}${suffix}${after}`;
        const cursor = before.length + prefix.length + snippet.length;
        textarea.focus();
        textarea.setSelectionRange(cursor, cursor);
        renderMarkdownPreview();
      };

      const insertImageMarkdown = (image, altText = "") => {
        if (!image?.publicPath) throw new Error("请先上传或选中一张素材图片");
        const fallbackAlt = image.name?.replace(/\.[^.]+$/, "").replace(/^\d+-/, "").replace(/-[a-z0-9]{8}$/, "").replace(/-/g, " ") || "图片";
        insertMarkdownAtCursor(`![${altText || fallbackAlt}](${image.publicPath})`);
      };

      const insertVideoHtml = (video) => {
        if (!video?.publicPath) throw new Error("请先上传一个视频");
        insertMarkdownAtCursor(`<video class="post-video" controls playsinline preload="metadata" src="${video.publicPath}"></video>`);
      };

      const updateCounts = () => {
        $('[data-count="posts"]').textContent = state.posts.length;
        $('[data-count="projects"]').textContent = state.projects.length;
        $('[data-count="recommendations"]').textContent = state.recommendations.length;
        $('[data-count="gallery"]').textContent = state.gallery.length;
        $('[data-count="personalVideos"]').textContent = state.personalVideos.length;
        $('[data-count="images"]').textContent = state.images.length;
        $('[data-count="videos"]').textContent = state.videos.length;
        $('[data-count="settings"]').textContent = "编辑";
      };

      const pendingMediaCount = (kind) => {
        const uploads = state.pendingMedia.uploads.filter((item) => item.kind === kind).length;
        const deletes = state.pendingMedia.deletes.filter((item) => item.kind === kind).length;
        return { uploads, deletes, total: uploads + deletes };
      };

      const allPendingMedia = () => [...state.pendingMedia.uploads, ...state.pendingMedia.deletes];

      const allPendingChanges = () => [
        ...state.pendingChanges.files,
        ...state.pendingChanges.deletes,
        ...state.pendingMedia.uploads,
        ...state.pendingMedia.deletes,
      ];

      const queueContentChange = ({ path, content, label }) => {
        state.pendingChanges.deletes = state.pendingChanges.deletes.filter((item) => item.path !== path);
        const existing = state.pendingChanges.files.findIndex((item) => item.path === path);
        const entry = { path, content, label, pending: true };
        if (existing >= 0) state.pendingChanges.files[existing] = entry;
        else state.pendingChanges.files.push(entry);
        updatePendingChangesUi();
      };

      const queueDeleteChange = ({ path, label }) => {
        state.pendingChanges.files = state.pendingChanges.files.filter((item) => item.path !== path);
        const pendingUploadIndex = state.pendingMedia.uploads.findIndex((item) => item.path === path);
        if (pendingUploadIndex >= 0) {
          const [removed] = state.pendingMedia.uploads.splice(pendingUploadIndex, 1);
          if (removed.previewUrl) URL.revokeObjectURL(removed.previewUrl);
          updatePendingChangesUi();
          return;
        }
        if (!state.pendingChanges.deletes.some((item) => item.path === path)) {
          state.pendingChanges.deletes.push({ path, label, pending: true });
        }
        updatePendingChangesUi();
      };

      const isPendingDelete = (kind, path) => state.pendingMedia.deletes.some((item) => item.kind === kind && item.path === path);

      const assetPreviewUrl = (asset) => asset?.previewUrl || asset?.url || (asset?.publicPath ? assetUrl(asset.publicPath) : "");

      const visibleImages = () => [
        ...state.pendingMedia.uploads.filter((item) => item.kind === "image" && item.publicPath?.startsWith("/images/")),
        ...state.images.filter((image) => !isPendingDelete("image", image.path)),
      ];

      const visibleVideos = () => [
        ...state.pendingMedia.uploads.filter((item) => item.kind === "video" && item.publicPath?.startsWith("/videos/")),
        ...state.videos.filter((video) => !isPendingDelete("video", video.path)),
      ];

      const setSelection = (kind, path, checked) => {
        const target = kind === "image" ? state.pendingMedia.selectedImages : state.pendingMedia.selectedVideos;
        if (checked) target.add(path);
        else target.delete(path);
        renderList();
      };

      const clearSelections = (kind) => {
        if (kind === "image") state.pendingMedia.selectedImages.clear();
        else state.pendingMedia.selectedVideos.clear();
      };

      const selectedAssets = (kind) => {
        const selected = kind === "image" ? state.pendingMedia.selectedImages : state.pendingMedia.selectedVideos;
        const assets = kind === "image" ? visibleImages() : visibleVideos();
        return assets.filter((asset) => selected.has(asset.path));
      };

      const updatePendingMediaUi = () => {
        const imageCount = pendingMediaCount("image");
        const videoCount = pendingMediaCount("video");
        const imageSummary = $('[data-media-pending-summary="images"]');
        const videoSummary = $('[data-media-pending-summary="videos"]');
        if (imageSummary) {
          imageSummary.textContent = imageCount.total
            ? "待同步图片操作：新增 " + imageCount.uploads + "，删除 " + imageCount.deletes + (mediaStorageMode() === "r2" ? "。点同步后会写入 R2。" : "。点同步后会合成一次 commit。")
            : "暂无待同步图片操作。";
        }
        if (videoSummary) {
          videoSummary.textContent = videoCount.total
            ? "待同步视频操作：新增 " + videoCount.uploads + "，删除 " + videoCount.deletes + (mediaStorageMode() === "r2" ? "。点同步后会写入 R2。" : "。点同步后会合成一次 commit。")
            : "暂无待同步视频操作。";
        }
        $$('[data-sync-media]').forEach((button) => {
          button.disabled = allPendingMedia().length === 0;
        });
        updatePendingChangesUi();
      };

      const updatePendingChangesUi = () => {
        const contentFiles = state.pendingChanges.files.length;
        const contentDeletes = state.pendingChanges.deletes.length;
        const uploads = state.pendingMedia.uploads.length;
        const mediaDeletes = state.pendingMedia.deletes.length;
        const total = contentFiles + contentDeletes + uploads + mediaDeletes;
        if (pendingSummary) {
          pendingSummary.textContent = total
            ? `待同步：写入 ${contentFiles} 个内容文件，删除 ${contentDeletes} 个内容文件，上传 ${uploads} 个媒体文件，删除 ${mediaDeletes} 个媒体文件。`
            : "暂无待同步改动。";
        }
        const button = $("[data-sync-all]");
        if (button) button.disabled = total === 0;
      };

      const selectSection = (section) => {
        state.section = section;
        $$("[data-section]").forEach((button) => {
          button.dataset.active = String(button.dataset.section === section);
        });
        $$("[data-view]").forEach((view) => {
          view.hidden = view.dataset.view !== section;
        });
        listKicker.textContent = labels[section].kicker;
        listTitle.textContent = labels[section].title;
        $("[data-new-current]").textContent = section === "settings" ? "save" : "new";
        renderList();
      };

      const renderList = () => {
        list.innerHTML = "";
        const section = state.section;
        const items =
          section === "posts"
            ? state.posts
            : section === "projects"
              ? state.projects
              : section === "recommendations"
                ? state.recommendations
                : section === "gallery"
                  ? state.gallery
                  : section === "personalVideos"
                    ? state.personalVideos
                    : section === "images"
                      ? visibleImages()
                      : section === "videos"
                        ? visibleVideos()
                        : [];

        if (!items.length) {
          list.innerHTML = `<p class="text-sm text-[var(--muted)]">${labels[section].empty}</p>`;
          renderImageGrid();
          renderVideoGrid();
          return;
        }

        items.forEach((item, index) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "orbit-card quiet-card p-3 text-left transition hover:border-[var(--foreground)]";
          if (section === "posts") {
            button.dataset.active = String(state.current.post?.path === item.path);
            const meta = [
              formatDate(item.data?.publishDate),
              ...(Array.isArray(item.data?.tags) ? item.data.tags : []),
            ].filter(Boolean);
            button.innerHTML = `
              <p class="font-semibold leading-snug">${escapeHtml(postDisplayTitle(item))}</p>
              ${item.data?.description ? `<p class="mt-2 text-sm leading-6 text-[var(--muted)]">${escapeHtml(item.data.description)}</p>` : ""}
              <p class="mt-2 font-mono text-xs text-[var(--muted)]">${escapeHtml(meta.join(" · "))}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">slug: ${escapeHtml(postSlug(item))}</p>
            `;
            button.addEventListener("click", () => loadPost(item));
          } else if (section === "projects") {
            button.dataset.active = String(state.current.projectIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.name || "未命名项目")}</p>
              <p class="mt-1 text-sm text-[var(--muted)]">${escapeHtml(item.year || "")} · ${(item.tags || []).map(escapeHtml).join(", ")}</p>
            `;
            button.addEventListener("click", () => fillProject(index));
          } else if (section === "recommendations") {
            button.dataset.active = String(state.current.recommendationIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.title || "未命名推荐")}</p>
              <p class="mt-1 text-sm text-[var(--muted)]">${escapeHtml(item.category || "other")} · ${escapeHtml(item.creator || "")} ${item.year ? `· ${escapeHtml(item.year)}` : ""}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">${escapeHtml(item.image || "")}</p>
            `;
            button.addEventListener("click", () => fillRecommendation(index));
          } else if (section === "gallery") {
            button.dataset.active = String(state.current.galleryIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.title || "未命名照片")}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">${escapeHtml(item.image || "")}</p>
            `;
            button.addEventListener("click", () => fillGallery(index));
          } else if (section === "personalVideos") {
            button.dataset.active = String(state.current.personalVideoIndex === index);
            button.innerHTML = `
              <p class="font-semibold">${escapeHtml(item.title || "未命名视频")}</p>
              <p class="mt-1 text-sm text-[var(--muted)]">${escapeHtml(item.date || "")}</p>
              <p class="mt-1 font-mono text-xs text-[var(--muted)]">${escapeHtml(item.video || "")}</p>
            `;
            button.addEventListener("click", () => fillPersonalVideo(index));
          } else if (section === "images") {
            button.dataset.active = String(state.current.image?.path === item.path);
            button.innerHTML = `
              <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
                <input data-image-select type="checkbox" ${state.pendingMedia.selectedImages.has(item.path) ? "checked" : ""} />
                <span>${item.pending ? "待新增" : "选择"}</span>
              </label>
              <div class="mb-2 overflow-hidden rounded border border-[var(--line)] bg-black">
                <img class="aspect-[16/10] w-full object-cover" src="${assetPreviewUrl(item)}" alt="" loading="lazy" />
              </div>
              <p class="break-all font-mono text-xs">${escapeHtml(item.publicPath)}</p>
            `;
            button.querySelector("[data-image-select]").addEventListener("click", (event) => event.stopPropagation());
            button.querySelector("[data-image-select]").addEventListener("change", (event) => setSelection("image", item.path, event.target.checked));
            button.addEventListener("click", () => selectImage(item));
          } else {
            button.dataset.active = String(state.current.video?.path === item.path);
            button.innerHTML = `
              <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
                <input data-video-select type="checkbox" ${state.pendingMedia.selectedVideos.has(item.path) ? "checked" : ""} />
                <span>${item.pending ? "待新增" : "选择"}</span>
              </label>
              <div class="mb-2 overflow-hidden rounded border border-[var(--line)] bg-black">
                <video class="aspect-video w-full object-cover" src="${assetPreviewUrl(item)}" preload="metadata" muted playsinline></video>
              </div>
              <p class="break-all font-mono text-xs">${escapeHtml(item.publicPath)}</p>
            `;
            button.querySelector("[data-video-select]").addEventListener("click", (event) => event.stopPropagation());
            button.querySelector("[data-video-select]").addEventListener("change", (event) => setSelection("video", item.path, event.target.checked));
            button.addEventListener("click", () => selectVideo(item));
          }
          list.append(button);
        });
        renderImageGrid();
        renderVideoGrid();
        updatePendingMediaUi();
      };

      const renderImageGrid = () => {
        const grid = $("[data-image-grid]");
        if (!grid) return;
        grid.innerHTML = "";
        const images = visibleImages();
        if (!images.length) {
          grid.innerHTML = '<p class="text-sm text-[var(--muted)]">暂无图片。</p>';
          updatePendingMediaUi();
          return;
        }
        images.forEach((image) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "orbit-card quiet-card overflow-hidden p-2 text-left transition hover:border-[var(--foreground)]";
          button.dataset.active = String(state.current.image?.path === image.path);
          button.innerHTML = `
            <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
              <input data-image-select type="checkbox" ${state.pendingMedia.selectedImages.has(image.path) ? "checked" : ""} />
              <span>${image.pending ? "待新增" : "选择"}</span>
            </label>
            <div class="overflow-hidden rounded border border-[var(--line)] bg-black">
              <img class="aspect-[4/3] w-full object-cover" src="${assetPreviewUrl(image)}" alt="" loading="lazy" />
            </div>
            <p class="mt-2 break-all font-mono text-xs">${escapeHtml(image.publicPath)}</p>
          `;
          button.querySelector("[data-image-select]").addEventListener("click", (event) => event.stopPropagation());
          button.querySelector("[data-image-select]").addEventListener("change", (event) => setSelection("image", image.path, event.target.checked));
          button.addEventListener("click", () => selectImage(image));
          grid.append(button);
        });
        updatePendingMediaUi();
      };

      const renderVideoGrid = () => {
        const grid = $("[data-video-grid]");
        if (!grid) return;
        grid.innerHTML = "";
        const videos = visibleVideos();
        if (!videos.length) {
          grid.innerHTML = '<p class="text-sm text-[var(--muted)]">暂无视频。</p>';
          updatePendingMediaUi();
          return;
        }
        videos.forEach((video) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "orbit-card quiet-card overflow-hidden p-2 text-left transition hover:border-[var(--foreground)]";
          button.dataset.active = String(state.current.video?.path === video.path);
          button.innerHTML = `
            <label class="mb-2 flex items-center gap-2 text-xs text-[var(--muted)]" data-media-select-wrapper>
              <input data-video-select type="checkbox" ${state.pendingMedia.selectedVideos.has(video.path) ? "checked" : ""} />
              <span>${video.pending ? "待新增" : "选择"}</span>
            </label>
            <div class="overflow-hidden rounded border border-[var(--line)] bg-black">
              <video class="aspect-video w-full object-cover" src="${assetPreviewUrl(video)}" preload="metadata" muted playsinline></video>
            </div>
            <p class="mt-2 break-all font-mono text-xs">${escapeHtml(video.publicPath)}</p>
          `;
          button.querySelector("[data-video-select]").addEventListener("click", (event) => event.stopPropagation());
          button.querySelector("[data-video-select]").addEventListener("change", (event) => setSelection("video", video.path, event.target.checked));
          button.addEventListener("click", () => selectVideo(video));
          grid.append(button);
        });
        updatePendingMediaUi();
      };

      const loadPosts = async () => {
        const files = await getDir(POSTS_PATH);
        const postFiles = files.filter((file) => /\.(md|mdx)$/.test(file.name));
        state.posts = await Promise.all(
          postFiles.map(async (item) => {
            const file = await getFile(item.path);
            const parsed = parseFrontmatter(fromBase64(file.content));
            return {
              ...item,
              sha: file.sha,
              data: parsed.data,
              body: parsed.body,
            };
          }),
        );
        state.posts.sort((a, b) => new Date(b.data?.publishDate || 0).valueOf() - new Date(a.data?.publishDate || 0).valueOf());
      };

      const loadProjects = async () => {
        const file = await getFile(PROJECTS_PATH);
        state.files.projects = file;
        state.projects = readExportedArray(fromBase64(file.content), "projects");
      };

      const loadRecommendations = async () => {
        const file = await getFile(RECOMMENDATIONS_PATH);
        state.files.recommendations = file;
        state.recommendations = readExportedArray(fromBase64(file.content), "recommendations");
      };

      const loadGallery = async () => {
        const file = await getFile(GALLERY_PATH);
        state.files.gallery = file;
        state.gallery = readExportedArray(fromBase64(file.content), "galleryItems").filter((item) => isPersonalPhotoPath(item.image));
      };

      const loadPersonalVideos = async () => {
        const file = await getFile(PERSONAL_VIDEOS_DATA_PATH);
        state.files.personalVideos = file;
        state.personalVideos = readExportedArray(fromBase64(file.content), "videoItems");
      };

      const loadSettings = async () => {
        const file = await getFile(SETTINGS_PATH);
        state.files.settings = file;
        state.settings = readExportedValue(fromBase64(file.content), "siteSettings");
        fillSettings();
      };

      const loadImages = async () => {
        if (mediaStorageMode() === "r2") {
          state.images = await mediaApiList("/images");
          return;
        }
        const files = await getDir(IMAGES_PATH);
        state.images = files
          .filter((file) => file.type === "file" && /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(file.name))
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((file) => ({ ...file, publicPath: `/images/${file.name}` }));
      };

      const loadVideos = async () => {
        if (mediaStorageMode() === "r2") {
          state.videos = await mediaApiList("/videos");
          return;
        }
        const files = await getDir(VIDEOS_PATH);
        state.videos = files
          .filter((file) => file.type === "file" && /\.(mp4|webm|mov|m4v)$/i.test(file.name))
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((file) => ({ ...file, publicPath: `/videos/${file.name}` }));
      };

      const applyInitialData = () => {
        state.posts = clone(INITIAL_DATA.posts);
        state.projects = clone(INITIAL_DATA.projects);
        state.recommendations = clone(INITIAL_DATA.recommendations);
        state.gallery = clone(INITIAL_DATA.gallery).filter((item) => isPersonalPhotoPath(item.image));
        state.personalVideos = clone(INITIAL_DATA.personalVideos);
        state.images = clone(INITIAL_DATA.images);
        state.videos = clone(INITIAL_DATA.videos);
        state.settings = clone(INITIAL_DATA.settings);
        state.files.projects = null;
        state.files.recommendations = null;
        state.files.gallery = null;
        state.files.personalVideos = null;
        state.files.settings = null;
        fillSettings();
        updateCounts();
        renderList();
        if (!state.current.post) newPost();
        if (state.current.projectIndex < 0) newProject();
        if (state.current.recommendationIndex < 0) newRecommendation();
        if (state.current.galleryIndex < 0) newGallery();
        if (state.current.personalVideoIndex < 0) newPersonalVideo();
      };

      const loadAll = async () => {
        if (!state.token) {
          setStatus("读取当前网站内置内容中...");
          applyInitialData();
          if (mediaStorageMode() === "r2" && state.mediaToken) {
            await Promise.all([loadImages(), loadVideos()]);
            updateCounts();
            renderList();
            setStatus("媒体模式已连接：可管理 R2 素材库。发布文章和页面数据仍需要 GitHub Token。");
            return;
          }
          setStatus("只读模式：内容已加载。线上保存、删除、上传需要 GitHub Token；R2 素材库需要 Media Token。");
          return;
        }

        state.mode = "github";
        setStatus("GitHub 模式：同步仓库内容中...");
        await Promise.all([loadPosts(), loadProjects(), loadRecommendations(), loadGallery(), loadPersonalVideos(), loadImages(), loadVideos(), loadSettings()]);
        updateCounts();
        renderList();
        if (!state.current.post) newPost();
        if (state.current.projectIndex < 0) newProject();
        if (state.current.recommendationIndex < 0) newRecommendation();
        if (state.current.galleryIndex < 0) newGallery();
        if (state.current.personalVideoIndex < 0) newPersonalVideo();
        setStatus("GitHub 模式已连接。分项操作会先暂存在当前页面，点“同步全部改动”后才提交到 main 分支。");
      };

      const fillSettings = () => {
        const settings = state.settings || clone(INITIAL_DATA.settings);
        settingsFields.forEach((field) => {
          const key = field.dataset.settingsField;
          if (key === "navText") {
            field.value = stringifyNavText(settings.nav || []);
            return;
          }
          if (key === "codeLinesText") {
            field.value = stringifyCodeLines(settings.home?.codeLines || []);
            return;
          }
          field.value = getByPath(settings, key) ?? "";
        });
      };

      const collectSettings = () => {
        const settings = clone(state.settings || INITIAL_DATA.settings);
        settingsFields.forEach((field) => {
          const key = field.dataset.settingsField;
          if (key === "navText") {
            settings.nav = parseNavText(field.value);
            return;
          }
          if (key === "codeLinesText") {
            settings.home.codeLines = parseCodeLines(field.value);
            return;
          }
          setByPath(settings, key, field.value.trim());
        });

        settings.home.codeLines = Array.isArray(settings.home.codeLines) && settings.home.codeLines.length
          ? settings.home.codeLines
          : [
              { label: "type", value: "Memory = \"文字\" | \"影像\" | \"代码\" | \"偏爱\"" },
              { label: "loop", value: "observe → write → ship → remember" },
              { label: "made_with", value: "Astro · TypeScript · Tailwind" },
            ];

        return settings;
      };

      const saveSettings = async () => {
        requireWriteAccess();
        const settings = collectSettings();
        if (!settings.site?.title) throw new Error("请填写 SEO 标题");
        if (!settings.site?.author) throw new Error("请填写作者");
        if (!settings.home?.headline) throw new Error("请填写首页大标题");
        if (!settings.nav?.length) throw new Error("至少保留一条导航");
        queueContentChange({
          path: SETTINGS_PATH,
          content: stringifySettingsModule(settings),
          label: "页面配置",
        });
        state.settings = settings;
        fillSettings();
        setStatus("页面配置已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const newPost = () => {
        state.current.post = { slug: "", sha: "", path: "", data: { publishDate: new Date().toISOString().slice(0, 10), tags: [] }, body: "" };
        postFields.slug.value = "";
        postFields.title.value = "";
        postFields.description.value = "";
        postFields.publishDate.value = new Date().toISOString().slice(0, 10);
        postFields.cover.value = "";
        postFields.tags.value = "";
        postFields.draft.checked = false;
        postFields.body.value = "";
        $("[data-post-title]").textContent = "新建文章";
        renderMarkdownPreview();
        renderList();
      };

      const loadPost = async (item) => {
        setStatus("读取文章中...");
        const file = state.token ? await getFile(item.path) : null;
        const parsed = file ? parseFrontmatter(fromBase64(file.content)) : { data: item.data || {}, body: item.body || "" };
        state.current.post = {
          slug: item.name.replace(/\.(md|mdx)$/, ""),
          path: item.path,
          sha: file?.sha || item.sha || "",
          data: parsed.data,
          body: parsed.body,
        };
        postFields.slug.value = state.current.post.slug;
        postFields.title.value = parsed.data.title || "";
        postFields.description.value = parsed.data.description || "";
        postFields.publishDate.value = String(parsed.data.publishDate || new Date().toISOString().slice(0, 10)).slice(0, 10);
        postFields.cover.value = parsed.data.cover || "";
        postFields.tags.value = Array.isArray(parsed.data.tags) ? parsed.data.tags.join(", ") : "";
        postFields.draft.checked = !!parsed.data.draft;
        postFields.body.value = parsed.body || "";
        $("[data-post-title]").textContent = `编辑文章：${parsed.data.title || state.current.post.slug}`;
        renderMarkdownPreview();
        renderList();
        setStatus("文章已载入。");
      };

      const savePost = async () => {
        requireWriteAccess();
        const slug = slugify(postFields.slug.value || postFields.title.value);
        if (!slug) throw new Error("请填写文章标题或 slug");
        if (!postFields.publishDate.value) throw new Error("请选择发布日期");
        postFields.slug.value = slug;

        const path = `${POSTS_PATH}/${slug}.mdx`;
        const current = state.current.post;
        const content = stringifyPost();
        queueContentChange({
          path,
          content,
          label: current?.path ? `文章：${slug}` : `新文章：${slug}`,
        });

        if (current?.sha && current.path && current.path !== path) {
          queueDeleteChange({ path: current.path, label: `旧文章路径：${current.slug}` });
        } else if (current?.path && current.path !== path) {
          queueDeleteChange({ path: current.path, label: `旧文章路径：${current.slug}` });
        }

        const item = {
          name: `${slug}.mdx`,
          path,
          sha: current?.sha || "",
          slug,
          data: parseFrontmatter(content).data,
          body: parseFrontmatter(content).body,
        };
        const existingIndex = state.posts.findIndex((post) => post.path === current?.path || post.path === path);
        if (existingIndex >= 0) state.posts[existingIndex] = item;
        else state.posts.unshift(item);
        state.posts = state.posts.filter((post, index, items) => items.findIndex((entry) => entry.path === post.path) === index);
        state.posts.sort((a, b) => new Date(b.data?.publishDate || 0).valueOf() - new Date(a.data?.publishDate || 0).valueOf());
        state.current.post = { ...current, slug, path, sha: item.sha, data: item.data, body: item.body };
        updateCounts();
        renderList();
        setStatus("文章已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const deletePost = async () => {
        requireWriteAccess();
        const current = state.current.post;
        if (!current?.path) throw new Error("请选择一篇已有文章");
        if (!confirm(`确定删除文章「${current.slug}」吗？`)) return;
        queueDeleteChange({ path: current.path, label: `文章：${current.slug}` });
        state.posts = state.posts.filter((post) => post.path !== current.path);
        updateCounts();
        newPost();
        setStatus("文章删除已暂存。确认无误后点“同步全部改动”一次提交。");
      };

      const newProject = () => {
        state.current.projectIndex = -1;
        projectFields.name.value = "";
        projectFields.year.value = new Date().getFullYear().toString();
        projectFields.description.value = "";
        projectFields.tags.value = "";
        projectFields.link.value = "";
        $("[data-project-title]").textContent = "新建项目";
        renderList();
      };

      const fillProject = (index) => {
        const project = state.projects[index];
        state.current.projectIndex = index;
        projectFields.name.value = project?.name || "";
        projectFields.year.value = project?.year || "";
        projectFields.description.value = project?.description || "";
        projectFields.tags.value = Array.isArray(project?.tags) ? project.tags.join(", ") : "";
        projectFields.link.value = project?.link || "";
        $("[data-project-title]").textContent = `编辑项目：${projectFields.name.value || "未命名"}`;
        renderList();
      };

      const saveProject = async () => {
        requireWriteAccess();
        const project = {
          name: projectFields.name.value.trim(),
          year: projectFields.year.value.trim(),
