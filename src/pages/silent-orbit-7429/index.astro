---
import "@/styles/global.css";
import { galleryItems } from "@/data/gallery";
import { projects } from "@/data/projects";
import { recommendations } from "@/data/recommendations";
import { siteSettings } from "@/data/siteSettings";
import { uiPresetCatalog } from "@/ui-packs/catalog.mjs";
import { UI_PRESET_DISPLAY_NAME_FIELD } from "@/ui-packs/settings-contract.mjs";
import { videoItems } from "@/data/videos";
import { getCollection } from "astro:content";
import { readdirSync } from "node:fs";

const posts = await getCollection("posts");
const articleImageAssetsDirectory = new URL("../../../public/article-assets/", import.meta.url);
const imageNames = readdirSync(articleImageAssetsDirectory).filter((name) => /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(name));
const personalPhotoDirectory = new URL("../../../public/personal-photo/", import.meta.url);
const personalPhotoNames = readdirSync(personalPhotoDirectory).filter((name) => /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(name));
const articleVideoAssetsDirectory = new URL("../../../public/article-videos/", import.meta.url);
const videoNames = readdirSync(articleVideoAssetsDirectory).filter((name) => /\.(mp4|webm|mov|m4v)$/i.test(name));
const personalVideoDirectory = new URL("../../../public/personal-video/", import.meta.url);
const personalVideoNames = readdirSync(personalVideoDirectory).filter((name) => /\.(mp4|webm|mov|m4v)$/i.test(name));
const uiPresetOptions = Object.values(uiPresetCatalog);
const currentBuildPreset = import.meta.env.PUBLIC_UI_PRESET || siteSettings.ui.activePreset;
const currentBuildPresetOption = uiPresetOptions.find((preset) => preset.id === currentBuildPreset);
const onlineDefaultPresetOption = uiPresetOptions.find((preset) => preset.id === siteSettings.ui.activePreset);
const uiPresetDisplayName = (preset) =>
  String(siteSettings.ui?.presets?.[preset?.id]?.displayName || "").trim() ||
  preset?.label ||
  preset?.id ||
  "未设置";

const initialData = {
  settings: siteSettings,
  uiPresetCatalog,
  currentBuildPreset,
  posts: posts
    .map((post) => ({
      name: `${post.id}.mdx`,
      path: `src/content/posts/${post.id}.mdx`,
      data: post.data,
      body: post.body || "",
    }))
    .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()),
  projects,
  recommendations,
  gallery: galleryItems,
  personalVideos: videoItems,
  images: imageNames.sort((a, b) => a.localeCompare(b)).map((name) => ({
    name,
    path: `public/article-assets/${name}`,
    publicPath: `/article-assets/${name}`,
  })),
  personalPhotoAssets: personalPhotoNames.sort((a, b) => a.localeCompare(b)).map((name) => ({
    name,
    path: `public/personal-photo/${name}`,
    publicPath: `/personal-photo/${name}`,
  })),
  videos: videoNames.sort((a, b) => a.localeCompare(b)).map((name) => ({
    name,
    path: `public/article-videos/${name}`,
    publicPath: `/article-videos/${name}`,
  })),
  personalVideoAssets: personalVideoNames.sort((a, b) => a.localeCompare(b)).map((name) => ({
    name,
    path: `public/personal-video/${name}`,
    publicPath: `/personal-video/${name}`,
  })),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Silent Orbit</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23171717'/%3E%3Cpath d='M10 17h12M16 10v12' stroke='white' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E" />
    <style>
      .orbit-workbench {
        --orbit-radius-lg: 1.45rem;
        --orbit-radius-md: 0.95rem;
        --orbit-canvas: #ece7df;
        --orbit-canvas-deep: #e4ddd2;
        --orbit-surface: rgb(251 248 242 / 0.82);
        --orbit-surface-solid: #fffaf2;
        --orbit-card: rgb(255 252 246 / 0.74);
        --orbit-field: rgb(248 243 235 / 0.82);
        --orbit-fill: #f2ede5;
        --orbit-fill-hover: #ebe3d8;
        --orbit-ink: #272824;
        --orbit-secondary: #69665f;
        --orbit-border: rgb(74 65 54 / 0.16);
        --orbit-accent: #426c66;
        --orbit-accent-hover: #345954;
        --orbit-accent-soft: rgb(66 108 102 / 0.115);
        --orbit-warm: #8b5b3d;
        --orbit-warm-soft: rgb(139 91 61 / 0.09);
        --orbit-red: #a84e44;
        --orbit-focus-ring: rgb(66 108 102 / 0.22);
        --orbit-shadow: rgb(62 48 33 / 0.10);
        --orbit-highlight: rgb(255 255 255 / 0.62);
        --background: var(--orbit-canvas);
        --foreground: var(--orbit-ink);
        --muted: var(--orbit-secondary);
        --line: var(--orbit-border);
        --surface: var(--orbit-surface-solid);
        --surface-soft: var(--orbit-fill);
        --accent: var(--orbit-accent);
        --accent-strong: var(--orbit-accent-hover);
        --accent-warm: var(--orbit-warm);
        font-family:
          "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui,
          sans-serif;
      }

      .dark .orbit-workbench {
        --orbit-canvas: #191816;
        --orbit-canvas-deep: #121210;
        --orbit-surface: rgb(39 36 31 / 0.86);
        --orbit-surface-solid: #2b2823;
        --orbit-card: rgb(45 41 35 / 0.78);
        --orbit-field: rgb(36 33 29 / 0.88);
        --orbit-fill: #24211d;
        --orbit-fill-hover: #302c26;
        --orbit-ink: #f3ede3;
        --orbit-secondary: #b8afa2;
        --orbit-border: rgb(238 224 204 / 0.14);
        --orbit-accent: #8fb8ad;
        --orbit-accent-hover: #a5c8bf;
        --orbit-accent-soft: rgb(143 184 173 / 0.14);
        --orbit-warm: #d3a278;
        --orbit-warm-soft: rgb(211 162 120 / 0.10);
        --orbit-red: #e77a70;
        --orbit-focus-ring: rgb(143 184 173 / 0.24);
        --orbit-shadow: rgb(0 0 0 / 0.34);
        --orbit-highlight: rgb(255 255 255 / 0.055);
      }

      .orbit-shell {
        position: relative;
        isolation: isolate;
        background:
          radial-gradient(circle at 8% -6%, rgb(139 91 61 / 0.16), transparent 30rem),
          radial-gradient(circle at 96% 2%, rgb(66 108 102 / 0.11), transparent 31rem),
          linear-gradient(180deg, var(--orbit-canvas), var(--orbit-canvas-deep));
        background-attachment: fixed;
      }

      .dark .orbit-shell {
        background:
          radial-gradient(circle at 8% -6%, rgb(211 162 120 / 0.10), transparent 30rem),
          radial-gradient(circle at 96% 2%, rgb(143 184 173 / 0.10), transparent 31rem),
          linear-gradient(180deg, var(--orbit-canvas), var(--orbit-canvas-deep));
      }

      .orbit-workbench::before,
      .orbit-workbench::after {
        content: "";
        position: fixed;
        inset: 0;
        display: block;
        pointer-events: none;
      }

      .orbit-workbench::before {
        z-index: 0;
        background: linear-gradient(180deg, rgb(255 250 242 / 0.34), transparent 24rem);
        opacity: 0.86;
      }

      .orbit-workbench::after {
        z-index: 1;
        background:
          radial-gradient(circle at 54% -8%, rgb(255 252 246 / 0.44), transparent 34rem),
          linear-gradient(180deg, transparent 52%, rgb(91 72 51 / 0.025));
        opacity: 0.68;
      }

      .dark .orbit-workbench::after {
        opacity: 0.26;
      }

      .orbit-stage {
        position: relative;
        z-index: 2;
      }

      .orbit-panel {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--orbit-border);
        border-radius: var(--orbit-radius-lg);
        background:
          linear-gradient(145deg, var(--orbit-highlight), transparent 42%),
          var(--orbit-surface);
        box-shadow:
          inset 0 1px 0 var(--orbit-highlight),
          0 24px 64px var(--orbit-shadow),
          0 4px 14px rgb(62 48 33 / 0.04);
        -webkit-backdrop-filter: blur(24px) saturate(1.08);
        backdrop-filter: blur(24px) saturate(1.08);
      }

      .orbit-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 14% 0%, var(--orbit-warm-soft), transparent 24rem),
          linear-gradient(180deg, var(--orbit-highlight), transparent 11rem);
        opacity: 0.54;
      }

      .orbit-panel > * {
        position: relative;
        z-index: 1;
      }

      .orbit-input {
        width: 100%;
        min-height: 2.75rem;
        border: 1px solid var(--orbit-border);
        border-radius: 0.8rem;
        background: var(--orbit-fill);
        padding: 0.72rem 0.85rem;
        color: var(--orbit-ink);
        outline: none;
        box-shadow:
          inset 0 1px 1px rgb(62 48 33 / 0.045),
          0 1px 0 var(--orbit-highlight);
        transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
      }

      .orbit-input:focus,
      .orbit-input:focus-visible {
        border-color: var(--orbit-accent);
        background: var(--orbit-surface-solid);
        box-shadow:
          inset 0 1px 1px rgb(62 48 33 / 0.025),
          0 0 0 3px var(--orbit-focus-ring);
      }

      .orbit-input::placeholder {
        color: color-mix(in srgb, var(--orbit-secondary) 72%, transparent);
      }

      .orbit-button {
        min-height: 2.5rem;
        border: 1px solid var(--orbit-border);
        border-radius: 0.75rem;
        background: var(--orbit-fill);
        padding: 0.62rem 0.9rem;
        color: var(--orbit-ink);
        -webkit-text-fill-color: var(--orbit-ink);
        font-family:
          "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui,
          sans-serif;
        font-size: 0.78rem;
        font-weight: 620;
        letter-spacing: -0.01em;
        box-shadow:
          inset 0 1px 0 var(--orbit-highlight),
          0 2px 7px rgb(62 48 33 / 0.045);
        transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
      }

      .orbit-button:hover:not(:disabled):not(.orbit-button-primary):not(.orbit-danger) {
        border-color: color-mix(in srgb, var(--orbit-warm) 24%, var(--orbit-border));
        background: var(--orbit-fill-hover);
        color: var(--orbit-ink);
        -webkit-text-fill-color: var(--orbit-ink);
        box-shadow: 0 5px 14px rgb(62 48 33 / 0.075);
        transform: translateY(-1px);
      }

      .orbit-button[data-active="true"]:not(.orbit-button-primary) {
        border-color: color-mix(in srgb, var(--orbit-accent) 34%, var(--orbit-border));
        background: var(--orbit-accent-soft);
        color: var(--orbit-accent);
        -webkit-text-fill-color: var(--orbit-accent);
        box-shadow: inset 0 1px 0 var(--orbit-highlight);
        transform: none;
      }

      .orbit-button-primary {
        border-color: var(--orbit-accent);
        background: var(--orbit-accent);
        color: #fffaf2;
        -webkit-text-fill-color: #fffaf2;
        box-shadow:
          inset 0 1px 0 rgb(255 255 255 / 0.18),
          0 5px 14px color-mix(in srgb, var(--orbit-accent) 24%, transparent);
      }

      .orbit-button-primary:hover,
      .orbit-button-primary[data-active="true"] {
        border-color: var(--orbit-accent-hover);
        background: var(--orbit-accent-hover);
        color: #fffaf2;
        -webkit-text-fill-color: #fffaf2;
        box-shadow:
          inset 0 1px 0 rgb(255 255 255 / 0.16),
          0 7px 18px color-mix(in srgb, var(--orbit-accent) 28%, transparent);
        transform: translateY(-1px);
      }

      .orbit-button:disabled {
        cursor: not-allowed;
        color: color-mix(in srgb, var(--orbit-secondary) 72%, transparent);
        -webkit-text-fill-color: color-mix(in srgb, var(--orbit-secondary) 72%, transparent);
        border-color: transparent;
        background: color-mix(in srgb, var(--orbit-fill) 78%, transparent);
        box-shadow: none;
        opacity: 0.72;
        transform: none;
      }

      .dark .orbit-button {
        color: var(--orbit-ink);
        -webkit-text-fill-color: var(--orbit-ink);
      }

      .dark .orbit-button:hover:not(:disabled):not(.orbit-button-primary):not(.orbit-danger) {
        color: var(--orbit-ink);
        -webkit-text-fill-color: var(--orbit-ink);
      }

      .dark .orbit-button[data-active="true"]:not(.orbit-button-primary) {
        color: var(--orbit-accent);
        -webkit-text-fill-color: var(--orbit-accent);
      }

      .dark .orbit-button-primary {
        color: #fffaf2;
        -webkit-text-fill-color: #fffaf2;
      }

      .dark .orbit-button:disabled {
        color: var(--orbit-secondary);
        -webkit-text-fill-color: var(--orbit-secondary);
      }

      .orbit-danger {
        border-color: color-mix(in srgb, var(--orbit-red) 28%, var(--orbit-border));
        background: color-mix(in srgb, var(--orbit-red) 8%, transparent);
        color: var(--orbit-red);
        -webkit-text-fill-color: var(--orbit-red);
      }

      .orbit-danger:hover:not(:disabled) {
        border-color: color-mix(in srgb, var(--orbit-red) 44%, var(--orbit-border));
        background: color-mix(in srgb, var(--orbit-red) 13%, transparent);
        box-shadow: 0 5px 14px color-mix(in srgb, var(--orbit-red) 12%, transparent);
        transform: translateY(-1px);
      }

      .orbit-card {
        border: 1px solid var(--orbit-border);
        border-radius: var(--orbit-radius-md);
        background:
          linear-gradient(145deg, var(--orbit-highlight), transparent 48%),
          var(--orbit-card);
        box-shadow:
          inset 0 1px 0 var(--orbit-highlight),
          0 7px 22px rgb(62 48 33 / 0.055);
        -webkit-backdrop-filter: blur(16px) saturate(1.04);
        backdrop-filter: blur(16px) saturate(1.04);
        transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease, transform 160ms ease;
      }

      button.orbit-card:hover,
      .orbit-card[role="button"]:hover {
        border-color: color-mix(in srgb, var(--orbit-warm) 26%, var(--orbit-border));
        background:
          linear-gradient(145deg, var(--orbit-highlight), transparent 48%),
          var(--orbit-surface-solid);
        box-shadow:
          inset 0 1px 0 var(--orbit-highlight),
          0 10px 26px rgb(62 48 33 / 0.08);
        transform: translateY(-1px);
      }

      .orbit-card[data-active="true"] {
        border-color: color-mix(in srgb, var(--orbit-accent) 42%, var(--orbit-border));
        background:
          linear-gradient(145deg, var(--orbit-highlight), transparent 48%),
          var(--orbit-accent-soft);
        box-shadow:
          inset 3px 0 0 var(--orbit-accent),
          inset 0 1px 0 var(--orbit-highlight),
          0 9px 24px color-mix(in srgb, var(--orbit-accent) 10%, transparent);
      }

      .orbit-view[hidden] {
        display: none;
      }

      .orbit-list {
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--orbit-secondary) 36%, transparent) transparent;
      }

      .orbit-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 0.5rem;
      }

      .orbit-field-panel {
        border: 1px solid var(--orbit-border);
        border-radius: var(--orbit-radius-md);
        background:
          linear-gradient(145deg, var(--orbit-highlight), transparent 52%),
          var(--orbit-field);
        box-shadow:
          inset 0 1px 0 var(--orbit-highlight),
          0 7px 22px rgb(62 48 33 / 0.05);
        -webkit-backdrop-filter: blur(18px) saturate(1.04);
        backdrop-filter: blur(18px) saturate(1.04);
      }

      .orbit-panel-title {
        font-family:
          "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC",
          Georgia, serif;
        font-weight: 700;
        letter-spacing: -0.025em;
      }

      .orbit-status-card {
        border-color: var(--orbit-border);
        border-radius: 0.95rem;
        background:
          linear-gradient(145deg, var(--orbit-warm-soft), transparent 66%),
          var(--orbit-field);
        box-shadow: inset 0 1px 0 var(--orbit-highlight);
        -webkit-backdrop-filter: blur(14px) saturate(1.02);
        backdrop-filter: blur(14px) saturate(1.02);
      }

      .orbit-workbench .literary-title {
        font-family:
          "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC",
          Georgia, serif;
        font-weight: 700;
        letter-spacing: -0.035em;
      }

      .orbit-view > :first-child h2 {
        font-family:
          "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC",
          Georgia, serif;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .orbit-workbench .exhibition-kicker,
      .orbit-workbench .exhibition-meta {
        font-family:
          "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui,
          sans-serif;
        font-weight: 650;
        letter-spacing: 0.12em;
        color: var(--orbit-warm);
      }

      .orbit-workbench input[type="checkbox"] {
        accent-color: var(--orbit-accent);
      }

      .orbit-button:focus-visible,
      button.orbit-card:focus-visible,
      .orbit-card[role="button"]:focus-visible {
        outline: 3px solid var(--orbit-focus-ring);
        outline-offset: 2px;
      }

      [data-section] {
        min-width: 0;
      }

      [data-section] > span:last-child {
        min-width: 1.45rem;
        border-radius: 999px;
        padding: 0.1rem 0.38rem;
        background: color-mix(in srgb, var(--orbit-secondary) 9%, transparent);
        text-align: center;
      }

      [data-section][data-active="true"] {
        box-shadow:
          inset 3px 0 0 var(--orbit-warm),
          inset 0 1px 0 var(--orbit-highlight);
      }

      [data-section][data-active="true"] > span:last-child {
        background: var(--orbit-accent-soft);
        color: var(--orbit-accent);
      }

      @media (min-width: 1024px) {
        .orbit-actions {
          justify-content: flex-end;
        }
      }

      @media (max-width: 1279px) {
        .orbit-stage {
          gap: 0.8rem;
        }

        .orbit-stage > div > aside.orbit-panel {
          overflow: hidden;
        }

        .orbit-stage > div > aside.orbit-panel > nav {
          display: flex;
          min-width: 0;
          overflow-x: auto;
          gap: 0.4rem;
          padding-bottom: 0.35rem;
          overscroll-behavior-inline: contain;
          scrollbar-color: var(--orbit-warm) transparent;
          scrollbar-width: thin;
        }

        .orbit-stage > div > aside.orbit-panel > nav::-webkit-scrollbar {
          height: 5px;
        }

        .orbit-stage > div > aside.orbit-panel > nav::-webkit-scrollbar-thumb {
          border-radius: 999px;
          background: var(--orbit-warm);
        }

        .orbit-stage > div > aside.orbit-panel > nav .orbit-button {
          flex: 0 0 auto;
          min-width: 8.5rem;
        }

        .orbit-list {
          max-height: none;
        }
      }

      @media (max-width: 639px) {
        .orbit-stage > header.orbit-panel {
          padding: 1rem;
        }

        .orbit-stage > header .exhibition-kicker {
          font-size: 0.78rem;
        }

        .orbit-stage > header .literary-title {
          margin-top: 0.35rem;
          font-size: 2.15rem;
        }

        .orbit-stage > header .literary-title + p {
          display: none;
        }

        [data-auth-form] {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: 0.65rem;
        }

        [data-auth-form] .orbit-input {
          min-height: 2.55rem;
          margin-top: 0.35rem;
        }

        [data-auth-form] > div {
          grid-column: 1 / -1;
        }

        [data-auth-form] .orbit-button {
          flex: 1;
        }
      }

      @media (max-width: 359px) {
        [data-auth-form] {
          grid-template-columns: minmax(0, 1fr);
        }

        [data-auth-form] > div {
          grid-column: auto;
        }
      }
    </style>
  </head>
  <body class="orbit-shell orbit-workbench min-h-screen text-[var(--foreground)]">
    <main class="orbit-stage mx-auto flex min-h-screen w-[min(1680px,calc(100%-1.25rem))] flex-col gap-5 py-4 md:w-[min(1680px,calc(100%-2rem))] md:py-6">
      <header class="orbit-panel exhibition-panel p-5 md:p-7">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
          <div>
            <p class="exhibition-kicker">Silent Orbit</p>
            <h1 class="literary-title mt-3 text-4xl leading-tight md:text-5xl">内容工作台</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">
              文章、项目、推荐、PersonalPhoto、PersonalVideo、素材库和页面配置统一在这里维护。先把分项改动暂存到当前页面，确认后再一次同步到 GitHub main 分支。
            </p>
          </div>

          <form class="grid gap-3 lg:min-w-[500px] lg:grid-cols-[1fr_1fr_auto] lg:items-end" data-auth-form>
            <label class="block">
              <span class="font-mono text-xs text-[var(--muted)]">GitHub Token</span>
              <input
                class="orbit-input mt-2 font-mono text-sm"
                data-token-input
                type="password"
                autocomplete="off"
                placeholder="github_pat_..."
              />
            </label>
            <label class="block">
              <span class="font-mono text-xs text-[var(--muted)]">Media Token</span>
              <input
                class="orbit-input mt-2 font-mono text-sm"
                data-media-token-input
                type="password"
                autocomplete="off"
                placeholder="Worker ADMIN_TOKEN"
              />
            </label>
            <div class="flex flex-wrap items-center gap-2">
              <button class="orbit-button orbit-button-primary" data-save-token type="button">connect</button>
              <button class="orbit-button" data-clear-token type="button">clear</button>
            </div>
          </form>
        </div>
      </header>

      <div class="grid flex-1 gap-5 xl:grid-cols-[220px_minmax(0,1fr)]">
        <aside class="orbit-panel exhibition-panel p-3 xl:sticky xl:top-6 xl:self-start">
          <nav class="grid gap-1.5">
            <button class="orbit-button flex items-center justify-between text-left" data-section="posts" data-active="true" type="button">
              <span>文章</span>
              <span class="text-[var(--muted)]" data-count="posts">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="projects" type="button">
              <span>项目</span>
              <span class="text-[var(--muted)]" data-count="projects">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="recommendations" type="button">
              <span>推荐</span>
              <span class="text-[var(--muted)]" data-count="recommendations">0</span>
            </button>
