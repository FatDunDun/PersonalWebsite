---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { navItems, siteConfig, withBase } from "@/utils/site";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[var(--background)]/88 backdrop-blur-xl">
  <nav class="container flex min-h-14 items-center justify-between gap-5">
    <a href={withBase("/")} class="group flex items-center gap-3 font-semibold">
      <span class="inverse-control grid size-8 place-items-center rounded-md font-mono text-xs transition">
        M
      </span>
      <span class="hidden font-mono text-sm tracking-wide sm:inline">{siteConfig.author}</span>
    </a>

    <div class="flex items-center gap-2">
      <div class="hidden items-center rounded-md border border-[var(--line)] bg-[var(--surface)]/80 p-1 md:flex">
        {navItems.map((item) => {
          const href = withBase(item.href);
          const active = item.href === "/" ? currentPath === withBase("/") : currentPath.startsWith(href);
          return (
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded px-3.5 py-1.5 font-mono text-xs text-[var(--muted)] transition hover:text-[var(--foreground)]",
                active && "nav-pill-active",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
      <ThemeToggle />
    </div>
  </nav>

  <div class="container flex gap-2 overflow-x-auto pb-3 md:hidden">
    {navItems.map((item) => {
      const href = withBase(item.href);
      const active = item.href === "/" ? currentPath === withBase("/") : currentPath.startsWith(href);
      return (
        <a
          href={href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "shrink-0 rounded-md border border-[var(--line)] px-3 py-1.5 font-mono text-xs text-[var(--muted)]",
            active && "nav-pill-active border-[var(--foreground)]",
          ]}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>
