---
interface Props {
  pageId: string;
  pageTitle: string;
}

const { pageId, pageTitle } = Astro.props;
const appId = import.meta.env.PUBLIC_CUSDIS_APP_ID;
const host = import.meta.env.PUBLIC_CUSDIS_HOST || "https://cusdis.com";
const enabled = Boolean(appId);
const pageUrl = Astro.url.href;
---

<section class="mt-14 border-t border-[var(--line)] pt-10">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <p class="text-sm uppercase tracking-[0.24em] text-[var(--accent)]">Comments</p>
      <h2 class="mt-2 text-2xl font-semibold">留言区</h2>
    </div>
  </div>

  {
    enabled ? (
      <div class="rounded-lg border border-[var(--line)] bg-[var(--surface)] p-4">
        <div
          id="cusdis_thread"
          data-host={host}
          data-app-id={appId}
          data-page-id={pageId}
          data-page-url={pageUrl}
          data-page-title={pageTitle}
        />
      </div>
    ) : (
      <div class="rounded-lg border border-dashed border-[var(--line)] bg-[var(--surface-soft)] p-5 text-sm leading-6 text-[var(--muted)]">
        留言区已切换为 Cusdis。配置 PUBLIC_CUSDIS_APP_ID 后，访客可以用昵称和邮箱留言，不需要 GitHub 账号。
      </div>
    )
  }
</section>

{enabled && <script async defer src={`${host}/js/cusdis.es.js`} />}

<script is:inline>
  const syncCusdisTheme = (theme) => {
    window.CUSDIS?.setTheme?.(theme === "dark" ? "dark" : "light");
  };

  window.addEventListener("theme-change", (event) => syncCusdisTheme(event.detail));
</script>
