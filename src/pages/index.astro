---
import { getCollection } from "astro:content";
import AnniversaryTimer from "@/components/AnniversaryTimer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { galleryItems } from "@/data/gallery";
import { projects } from "@/data/projects";
import { formatDate } from "@/utils/format";
import { siteConfig, withBase } from "@/utils/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const featuredFrames = galleryItems.slice(0, 3);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="container grid min-h-[calc(100svh-3.5rem)] gap-10 py-14 md:grid-cols-[1.05fr_0.95fr] md:items-center md:py-20">
    <div>
      <div class="inline-flex items-center gap-2 rounded-md border border-[var(--line)] bg-[var(--surface)] px-3 py-1.5 font-mono text-xs text-[var(--muted)]">
        <span class="size-2 rounded-full bg-[var(--accent)]"></span>
        available for writing / building / archiving
      </div>
      <h1 class="mt-8 max-w-4xl text-5xl font-semibold leading-[0.98] tracking-normal md:text-7xl">
        写作、影像和项目的个人索引。
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--muted)]">
        一个面向长期维护的数字空间：用文章记录思考，用图集保存片刻，用项目沉淀可复用的实验。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase("/projects/")} class="inverse-control rounded-md px-4 py-2.5 font-mono text-sm transition">
          查看项目
        </a>
        <a href={withBase("/articles/")} class="rounded-md border border-[var(--line)] bg-[var(--surface)] px-4 py-2.5 font-mono text-sm text-[var(--foreground)] transition hover:border-[var(--foreground)]">
          阅读文章
        </a>
      </div>
    </div>

    <div class="grid gap-4">
      <div class="rounded-md border border-[var(--line)] bg-[var(--surface)] p-4">
        <div class="flex items-center justify-between border-b border-[var(--line)] pb-3 font-mono text-xs text-[var(--muted)]">
          <span>~/personal-site</span>
          <span>astro.ts</span>
        </div>
        <div class="space-y-3 pt-4 font-mono text-sm">
          <p><span class="text-[var(--muted)]">const</span> focus = <span class="text-[var(--accent)]">["writing", "images", "tools"]</span></p>
          <p><span class="text-[var(--muted)]">status</span>: shipping quietly</p>
          <p><span class="text-[var(--muted)]">stack</span>: Astro · TypeScript · Tailwind</p>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-md border border-[var(--line)] bg-[var(--surface)] p-4">
          <p class="font-mono text-xs text-[var(--muted)]">POSTS</p>
          <p class="mt-2 text-3xl font-semibold">{posts.length}</p>
        </div>
        <div class="rounded-md border border-[var(--line)] bg-[var(--surface)] p-4">
          <p class="font-mono text-xs text-[var(--muted)]">FRAMES</p>
          <p class="mt-2 text-3xl font-semibold">{galleryItems.length}</p>
        </div>
        <div class="rounded-md border border-[var(--line)] bg-[var(--surface)] p-4">
          <p class="font-mono text-xs text-[var(--muted)]">WORKS</p>
          <p class="mt-2 text-3xl font-semibold">{projects.length}</p>
        </div>
      </div>
      <AnniversaryTimer />
    </div>
  </section>

  <section class="container border-t border-[var(--line)] py-14 md:py-18">
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Gallery</p>
        <h2 class="mt-3 text-3xl font-semibold md:text-4xl">图像片段</h2>
      </div>
      <a href={withBase("/gallery/")} class="font-mono text-sm text-[var(--accent)]">/gallery</a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {featuredFrames.map((item, index) => (
        <a href={withBase("/gallery/")} class="group block">
          <figure class="overflow-hidden rounded-md border border-[var(--line)] bg-[var(--surface)]">
            <img
              class:list={[
                "aspect-[16/11] w-full object-cover grayscale transition duration-500 group-hover:grayscale-0",
              ]}
              src={withBase(item.image)}
              alt={item.title}
            />
          </figure>
          <div class="mt-3 flex items-start justify-between gap-4 border-t border-[var(--line)] pt-3">
            <div>
              <h3 class="font-semibold">{item.title}</h3>
              <p class="mt-1 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
            <span class="font-mono text-xs text-[var(--muted)]">0{index + 1}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-[var(--line)] bg-[var(--surface)]/68 py-14 md:py-18">
    <div class="container">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Journal</p>
          <h2 class="mt-3 text-3xl font-semibold md:text-4xl">最近文章</h2>
        </div>
        <a href={withBase("/articles/")} class="font-mono text-sm text-[var(--accent)]">/articles</a>
      </div>
      <div class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
        {posts.map((post) => (
          <a href={withBase(`/articles/${post.id}/`)} class="group grid gap-5 py-6 transition md:grid-cols-[180px_1fr_auto] md:items-center">
            {post.data.cover && <img class="aspect-[4/3] w-full object-cover md:h-28" src={withBase(post.data.cover)} alt="" />}
            <div>
              <p class="text-sm text-[var(--muted)]">{formatDate(post.data.publishDate)}</p>
              <h3 class="mt-2 text-2xl font-semibold leading-snug group-hover:text-[var(--accent)]">{post.data.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">{post.data.description}</p>
            </div>
            <span class="font-mono text-sm text-[var(--accent)]">read</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container py-14 md:py-20">
    <div class="grid gap-8 md:grid-cols-[0.82fr_1.18fr]">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-[var(--accent)]">Works</p>
        <h2 class="mt-3 text-3xl font-semibold md:text-4xl">项目与实验</h2>
      </div>
      <div class="grid gap-0 border-t border-[var(--line)]">
        {projects.slice(0, 2).map((project) => (
          <a href={project.link} class="border-b border-[var(--line)] py-6 transition hover:text-[var(--accent)]">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-semibold">{project.name}</h3>
              <span class="text-sm text-[var(--muted)]">{project.year}</span>
            </div>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{project.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
