---
import { navItems, siteConfig, withBase } from "@/utils/site";

const year = new Date().getFullYear();
---

<footer class="site-footer py-10">
  <div class="container flex flex-col gap-7 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="text-base font-semibold">{siteConfig.name}</p>
      <p class="mt-2 max-w-xl text-sm leading-6 text-[var(--foreground)]">{siteConfig.description}</p>
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--foreground)]">
      {navItems.map((item) => <a class="transition hover:text-[var(--accent)]" href={withBase(item.href)}>{item.label}</a>)}
    </div>
  </div>
  <div class="container mt-8 border-t border-[var(--line)] pt-5 text-xs text-[var(--foreground)]">
    © {year} {siteConfig.author}. {siteConfig.footerNote || "Built with Astro."}
  </div>
</footer>
