---
import { getCollection } from "astro:content";
import AnniversaryTimer from "../components/Anniversary.astro";
import { galleryItems } from "@/data/gallery";
import { projects } from "@/data/projects";
import { recommendations } from "@/data/recommendations";
import { formatDate } from "@/utils/format";
import { assetUrl, homeConfig, imageUrl, uiPresetConfig, withBase } from "@/utils/site";
import { manifest } from "../manifest";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const isPersonalPhotoImage = (image = "") => {
  if (image.startsWith("/personal-photo/")) return true;
  if (/^https?:\/\//.test(image)) {
    try {
      return new URL(image).pathname.startsWith("/personal-photo/");
    } catch {
      return false;
    }
  }
  return false;
};

const personalPhotoItems = galleryItems.filter((item) => isPersonalPhotoImage(item.image));
const featuredFrames = personalPhotoItems.slice(0, 3);
const featuredProjects = projects.slice(0, 3);
const isExternalLink = (href: string) => /^(?:https?:)?\/\//i.test(href);
const isDirectLink = (href: string) => /^(?:[a-z][a-z0-9+.-]*:|#)/i.test(href);
const resolveCtaLink = (href: string) => isExternalLink(href) || isDirectLink(href) ? href : withBase(href);
const primaryCta = homeConfig.primaryButton;
const secondaryCta = homeConfig.secondaryButton;
const hasPrimaryCta = Boolean(primaryCta.label.trim() && primaryCta.href.trim());
const hasSecondaryCta = Boolean(secondaryCta.label.trim() && secondaryCta.href.trim());
const packConfig = uiPresetConfig(manifest.id);
const heroImage = packConfig.appearance?.homeHero?.backgroundImage || "/site-assets/home-exhibition-bg.jpg";
const heroFocalPoint = packConfig.appearance?.homeHero?.focalPoint || "center 34%";
const optimizedHeroImage = imageUrl(heroImage, { width: 1920, quality: 78 });
---

<div class="home-motion" data-home-motion>
  <section class="home-hero container">
      <div class="home-hero__copy reveal-up">
        <p class="exhibition-kicker">{homeConfig.badge}</p>
        <h1 class="editorial-title mt-5 text-[var(--foreground)]">
          {homeConfig.headline}
        </h1>
        <p class="mt-6 text-lg leading-8 text-[var(--muted)] md:text-xl md:leading-9">
          {homeConfig.intro}
        </p>
        <div class="home-hero__actions">
          {hasPrimaryCta && (
            <a
              class="story-button story-button--primary"
              href={resolveCtaLink(primaryCta.href)}
              target={isExternalLink(primaryCta.href) ? "_blank" : undefined}
              rel={isExternalLink(primaryCta.href) ? "noopener noreferrer" : undefined}
            >
              {primaryCta.label}
            </a>
          )}
          {hasSecondaryCta && (
            <a
              class="story-button story-button--secondary"
              href={resolveCtaLink(secondaryCta.href)}
              target={isExternalLink(secondaryCta.href) ? "_blank" : undefined}
              rel={isExternalLink(secondaryCta.href) ? "noopener noreferrer" : undefined}
            >
              {secondaryCta.label}
            </a>
          )}
        </div>
      </div>

      <div
        class="home-hero__visual reveal-up"
        style={`--home-hero-image: url("${optimizedHeroImage}"); --home-hero-position: ${heroFocalPoint}`}
      >
        <aside class="home-hero__overlay">
          <div class="home-hero__metrics">
            <a class="home-hero__metric" href={withBase("/articles/")}>
              <strong>{posts.length}</strong>
              <span>篇近期文章</span>
            </a>
            <a class="home-hero__metric" href={withBase("/projects/")}>
              <strong>{projects.length}</strong>
              <span>个持续项目</span>
            </a>
            <a class="home-hero__metric" href={withBase("/gallery/")}>
              <strong>{personalPhotoItems.length}</strong>
              <span>帧生活切片</span>
            </a>
          </div>
          <div class="home-hero__code">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-white/65">{homeConfig.codePath}</p>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/82">
              {homeConfig.codeLines.map((line) => (
                <p><span class="text-white/55">{line.label}</span> · {line.value}</p>
              ))}
            </div>
          </div>
        </aside>
      </div>
  </section>

  <section class="container grid gap-4 pb-12 md:grid-cols-[0.76fr_1.24fr] md:pb-20">
    <div class="exhibition-panel rounded-[2rem] p-6 md:p-8">
      <p class="exhibition-kicker">{homeConfig.marginKicker}</p>
      <p class="literary-title mt-6 text-3xl leading-snug md:text-4xl">{homeConfig.marginTitle}</p>
      <p class="mt-5 leading-8 text-[var(--muted)]">{homeConfig.marginDescription}</p>
    </div>
    <div class="exhibition-panel rounded-[2rem] p-4 md:p-5">
      <AnniversaryTimer />
    </div>
  </section>

  <section class="container pb-12 md:pb-20">
    <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="exhibition-kicker">Frames / captured light</p>
        <h2 class="literary-title mt-3 text-4xl md:text-5xl">给时间留几张切片</h2>
      </div>
      <a href={withBase("/gallery/")} class="exhibition-meta text-sm">view gallery</a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {featuredFrames.map((item, index) => (
        <a href={withBase("/gallery/")} class="group block reveal-up">
          <figure class="quiet-card overflow-hidden rounded-[1.5rem] p-2">
            <img
              class="aspect-[16/11] w-full rounded-[1.1rem] object-cover transition duration-700 group-hover:scale-[1.035] group-hover:saturate-110"
              src={assetUrl(item.image)}
              alt={item.title}
            />
          </figure>
          <div class="mt-3 flex items-start justify-between gap-4 px-1">
            <div>
              <h3 class="literary-title font-semibold">{item.title}</h3>
              <p class="mt-1 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
            <span class="exhibition-meta text-xs">0{index + 1}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container pb-12 md:pb-20">
    <div class="exhibition-panel rounded-[2rem] p-5 md:p-8">
      <div class="mb-4 flex items-end justify-between gap-4">
        <div>
          <p class="exhibition-kicker">Journal / field notes</p>
          <h2 class="literary-title mt-3 text-4xl md:text-5xl">最近写下的想法</h2>
        </div>
        <a href={withBase("/articles/")} class="exhibition-meta text-sm">all essays</a>
      </div>
      <div class="divide-y divide-[var(--line)]">
        {posts.map((post) => (
          <a href={withBase("/articles/" + post.id + "/")} class="group grid gap-5 py-6 transition md:grid-cols-[160px_1fr_auto] md:items-center">
            {post.data.cover && <img class="aspect-[4/3] w-full rounded-2xl object-cover md:h-28" src={assetUrl(post.data.cover)} alt="" />}
            <div>
              <p class="text-sm text-[var(--muted)]">{formatDate(post.data.publishDate)}</p>
              <h3 class="literary-title mt-2 text-2xl leading-snug group-hover:text-[var(--accent)]">{post.data.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">{post.data.description}</p>
            </div>
            <span class="exhibition-meta text-sm">read</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container pb-12 md:pb-20" data-home-works>
    <div class="exhibition-panel rounded-[2rem] p-5 md:p-8">
      <div class="mb-6">
        <p class="exhibition-kicker">Works / small machines</p>
        <h2 class="literary-title mt-3 text-4xl md:text-5xl">把想法做成工具</h2>
      </div>
      <div class="grid gap-4" data-home-works-list>
        {featuredProjects.map((project, index) => {
          const external = isExternalLink(project.link);
          return (
            <a
              href={project.link}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              class="artifact-card group grid gap-4 rounded-[1.5rem] p-5 transition hover:-translate-y-1 hover:border-[var(--foreground)] md:grid-cols-[72px_1fr_auto] md:items-center"
            >
              <div class="folio-number text-3xl">{String(index + 1).padStart(2, "0")}</div>
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="literary-title text-2xl">{project.name}</h3>
                  <span class="exhibition-meta text-xs">{project.year}</span>
                </div>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">{project.description}</p>
              </div>
              <span class="exhibition-meta text-sm">open</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="container pb-16 md:pb-24">
    <div class="exhibition-panel rounded-[2rem] p-5 md:p-8">
      <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="exhibition-kicker">Taste / private index</p>
          <h2 class="literary-title mt-3 text-4xl md:text-5xl">最近偏爱的事物</h2>
        </div>
        <a href={withBase("/recommendations/")} class="exhibition-meta text-sm">view taste</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {recommendations.slice(0, 2).map((item) => (
          <a href={withBase("/recommendations/")} class="quiet-card group grid grid-cols-[96px_1fr] gap-4 rounded-[1.5rem] p-2 transition hover:border-[var(--foreground)]">
            {item.image && <img class="aspect-[4/5] w-full rounded-[1.1rem] object-cover" src={assetUrl(item.image)} alt={item.title} loading="lazy" />}
            <div class="py-2 pr-2">
              <p class="exhibition-meta text-xs uppercase tracking-[0.2em]">{item.category}</p>
              <h3 class="mt-2 text-lg font-semibold leading-tight group-hover:text-[var(--accent)]">{item.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</div>
