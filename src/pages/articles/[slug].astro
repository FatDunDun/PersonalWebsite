---
import { getCollection, render } from "astro:content";
import WalineComments from "@/components/WalineComments.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/utils/format";
import { assetUrl } from "@/utils/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} type="article">
  <article class="container py-8 md:py-12">
    <header class="page-hero grid gap-8 md:grid-cols-[0.78fr_1.22fr] md:items-end">
      <div class="flex flex-wrap gap-2 font-mono text-sm text-[var(--muted)] md:block">
        <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
        <div class="mt-3 flex flex-wrap gap-2 md:flex-col">
          {post.data.tags.map((tag) => <span class="tag-chip px-2 py-1 text-xs">{tag}</span>)}
        </div>
      </div>
      <div>
        <p class="page-kicker">Article / field note</p>
        <h1 class="page-title mt-4 text-5xl leading-tight md:text-7xl">{post.data.title}</h1>
        <p class="note-rule mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">{post.data.description}</p>
      </div>
    </header>

    {post.data.cover && (
      <div class="artifact-card mt-10 rounded-[2rem] p-2">
        <img class="aspect-[16/9] w-full rounded-[1.5rem] border border-[var(--line)] object-cover photo-shadow" src={assetUrl(post.data.cover)} alt="" />
      </div>
    )}

    <div class="artifact-card mx-auto mt-12 max-w-3xl rounded-[2rem] p-6 md:p-10">
      <div class="prose max-w-none">
      <Content />
      <WalineComments pageId={post.id} />
      </div>
    </div>
  </article>
</BaseLayout>
