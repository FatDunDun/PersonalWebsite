---
import "@/styles/global.css";
import CursorField from "@/components/CursorField.astro";
import { galleryItems } from "@/data/gallery";
import { projects } from "@/data/projects";
import { recommendations } from "@/data/recommendations";
import { siteSettings } from "@/data/siteSettings";
import { videoItems } from "@/data/videos";
import { getCollection } from "astro:content";
import { readdirSync } from "node:fs";

const posts = await getCollection("posts");
const imageDirectory = new URL("../../../public/images/", import.meta.url);
const imageNames = readdirSync(imageDirectory).filter((name) => /\.(png|jpe?g|webp|gif|avif|svg)$/i.test(name));
const videoDirectory = new URL("../../../public/videos/", import.meta.url);
const videoNames = readdirSync(videoDirectory).filter((name) => /\.(mp4|webm|mov|m4v)$/i.test(name));

const initialData = {
  settings: siteSettings,
  posts: posts
    .map((post) => ({
      name: `${post.id}.mdx`,
      path: `src/content/posts/${post.id}.mdx`,
      data: post.data,
      body: post.body || "",
    }))
    .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()),
  projects,
  recommendations,
  gallery: galleryItems,
  personalVideos: videoItems,
  images: imageNames.sort((a, b) => a.localeCompare(b)).map((name) => ({
    name,
    path: `public/images/${name}`,
    publicPath: `/images/${name}`,
  })),
  videos: videoNames.sort((a, b) => a.localeCompare(b)).map((name) => ({
    name,
    path: `public/videos/${name}`,
    publicPath: `/videos/${name}`,
  })),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Silent Orbit</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23171717'/%3E%3Cpath d='M10 17h12M16 10v12' stroke='white' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E" />
    <style>
      .orbit-workbench {
        --orbit-radius-lg: 2rem;
        --orbit-radius-md: 1.35rem;
      }

      .orbit-shell {
        position: relative;
        isolation: isolate;
        background:
          radial-gradient(circle at 14% 10%, color-mix(in srgb, var(--accent-warm) 22%, transparent), transparent 28rem),
          radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--accent-strong) 24%, transparent), transparent 30rem),
          linear-gradient(135deg, color-mix(in srgb, var(--glass-strong) 42%, transparent), transparent 52%),
          var(--background);
        background-attachment: fixed;
      }

      .orbit-workbench::before,
      .orbit-workbench::after {
        content: "";
        position: fixed;
        inset: 0;
        display: block;
        pointer-events: none;
      }

      .orbit-workbench::before {
        z-index: 0;
        background:
          linear-gradient(90deg, rgb(255 255 255 / 0.08) 1px, transparent 1px),
          linear-gradient(180deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
        background-size: 72px 72px;
        mask-image:
          radial-gradient(circle at 72% 18%, #000 0 18rem, transparent 34rem),
          linear-gradient(180deg, #000, transparent 84%);
        opacity: 0.55;
        animation: home-grid-drift 22s linear infinite;
      }

      .orbit-workbench::after {
        z-index: 1;
        background:
          radial-gradient(circle at 72% 12%, rgb(255 255 255 / 0.32), transparent 22rem),
          radial-gradient(circle at 82% 72%, color-mix(in srgb, var(--accent-strong) 22%, transparent), transparent 26rem),
          linear-gradient(180deg, transparent, color-mix(in srgb, var(--background) 54%, transparent));
        mix-blend-mode: screen;
        opacity: 0.7;
      }

      .dark .orbit-workbench::after {
        opacity: 0.44;
      }

      .orbit-stage {
        position: relative;
        z-index: 2;
      }

      .orbit-panel {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--paper-edge);
        border-radius: var(--orbit-radius-lg);
        background:
          linear-gradient(135deg, color-mix(in srgb, var(--glass-strong) 70%, transparent), color-mix(in srgb, var(--glass) 68%, transparent)),
          var(--glass);
        box-shadow: var(--shadow-soft);
        backdrop-filter: blur(26px) saturate(1.15);
      }

      .orbit-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 16% 0%, rgb(255 255 255 / 0.22), transparent 24rem),
          linear-gradient(120deg, transparent 0 34%, rgb(255 255 255 / 0.07) 48%, transparent 64%);
        opacity: 0.84;
      }

      .orbit-panel > * {
        position: relative;
        z-index: 1;
      }

      .orbit-input {
        width: 100%;
        border: 1px solid color-mix(in srgb, var(--paper-edge) 82%, transparent);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--background) 52%, transparent);
        padding: 0.72rem 0.9rem;
        color: var(--foreground);
        outline: none;
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18);
        transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
      }

      .orbit-input:focus {
        border-color: color-mix(in srgb, var(--accent-strong) 62%, var(--foreground));
        background: color-mix(in srgb, var(--surface) 58%, transparent);
        box-shadow:
          inset 0 1px 0 rgb(255 255 255 / 0.2),
          0 0 0 3px color-mix(in srgb, var(--accent-strong) 16%, transparent);
      }

      .orbit-button {
        border: 1px solid color-mix(in srgb, var(--paper-edge) 82%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--glass-strong) 44%, transparent);
        padding: 0.62rem 0.9rem;
        color: var(--foreground);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        box-shadow: 0 1px 0 rgb(255 255 255 / 0.16);
        transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
      }

      .orbit-button:hover,
      .orbit-button[data-active="true"] {
        border-color: color-mix(in srgb, var(--accent-strong) 58%, var(--foreground));
        background: color-mix(in srgb, var(--glass-strong) 72%, transparent);
        box-shadow: 0 14px 34px color-mix(in srgb, var(--accent-strong) 12%, transparent);
        transform: translateY(-1px);
      }

      .orbit-button-primary {
        border-color: color-mix(in srgb, var(--foreground) 86%, var(--accent));
        background: var(--foreground);
        color: var(--background);
      }

      .orbit-danger {
        border-color: color-mix(in srgb, #dc2626 36%, var(--line));
        color: #dc2626;
      }

      .orbit-danger:hover {
        border-color: #dc2626;
      }

      .orbit-card {
        border: 1px solid color-mix(in srgb, var(--paper-edge) 82%, transparent);
        border-radius: var(--orbit-radius-md);
        background:
          linear-gradient(135deg, color-mix(in srgb, var(--glass-strong) 54%, transparent), color-mix(in srgb, var(--glass) 58%, transparent)),
          var(--glass);
        box-shadow: 0 18px 54px rgb(9 26 38 / 0.09);
        backdrop-filter: blur(18px) saturate(1.1);
      }

      .orbit-card[data-active="true"] {
        border-color: color-mix(in srgb, var(--accent-strong) 60%, var(--foreground));
        box-shadow:
          inset 0 0 0 1px color-mix(in srgb, var(--accent-strong) 54%, transparent),
          0 18px 54px color-mix(in srgb, var(--accent-strong) 14%, transparent);
      }

      .orbit-view[hidden] {
        display: none;
      }

      .orbit-list {
        scrollbar-width: thin;
      }

      .orbit-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 0.5rem;
      }

      .orbit-field-panel {
        border: 1px solid color-mix(in srgb, var(--paper-edge) 78%, transparent);
        border-radius: var(--orbit-radius-md);
        background: color-mix(in srgb, var(--glass-strong) 42%, transparent);
        box-shadow: 0 18px 54px rgb(9 26 38 / 0.08);
        backdrop-filter: blur(18px) saturate(1.1);
      }

      .orbit-panel-title {
        font-family:
          "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC",
          Georgia, serif;
        font-weight: 800;
        letter-spacing: 0;
      }

      .orbit-status-card {
        border-color: color-mix(in srgb, var(--paper-edge) 78%, transparent);
        border-radius: 1.25rem;
        background: color-mix(in srgb, var(--background) 44%, transparent);
        backdrop-filter: blur(16px);
      }

      @media (min-width: 1024px) {
        .orbit-actions {
          justify-content: flex-end;
        }
      }
    </style>
  </head>
  <body class="orbit-shell orbit-workbench min-h-screen text-[var(--foreground)]">
    <CursorField />
    <main class="orbit-stage mx-auto flex min-h-screen w-[min(1680px,calc(100%-1.25rem))] flex-col gap-5 py-4 md:w-[min(1680px,calc(100%-2rem))] md:py-6">
      <header class="orbit-panel exhibition-panel p-5 md:p-7">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
          <div>
            <p class="exhibition-kicker">Silent Orbit</p>
            <h1 class="literary-title mt-3 text-4xl leading-tight md:text-5xl">内容工作台</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">
              文章、项目、推荐、PersonalPhoto、PersonalVideo、素材库和页面配置统一在这里维护。先把分项改动暂存到当前页面，确认后再一次同步到 GitHub main 分支。
            </p>
          </div>

          <form class="grid gap-3 lg:min-w-[500px] lg:grid-cols-[1fr_1fr_auto] lg:items-end" data-auth-form>
            <label class="block">
              <span class="font-mono text-xs text-[var(--muted)]">GitHub Token</span>
              <input
                class="orbit-input mt-2 font-mono text-sm"
                data-token-input
                type="password"
                autocomplete="off"
                placeholder="github_pat_..."
              />
            </label>
            <label class="block">
              <span class="font-mono text-xs text-[var(--muted)]">Media Token</span>
              <input
                class="orbit-input mt-2 font-mono text-sm"
                data-media-token-input
                type="password"
                autocomplete="off"
                placeholder="Worker ADMIN_TOKEN"
              />
            </label>
            <div class="flex flex-wrap items-center gap-2">
              <label class="flex items-center gap-2 text-sm text-[var(--muted)]">
                <input data-remember-token type="checkbox" />
                记住
              </label>
              <button class="orbit-button orbit-button-primary" data-save-token type="button">connect</button>
              <button class="orbit-button" data-clear-token type="button">clear</button>
            </div>
          </form>
        </div>
      </header>

      <div class="grid flex-1 gap-5 xl:grid-cols-[220px_minmax(0,1fr)]">
        <aside class="orbit-panel exhibition-panel p-3 xl:sticky xl:top-6 xl:self-start">
          <nav class="grid gap-1.5">
            <button class="orbit-button flex items-center justify-between text-left" data-section="posts" data-active="true" type="button">
              <span>文章</span>
              <span class="text-[var(--muted)]" data-count="posts">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="projects" type="button">
              <span>项目</span>
              <span class="text-[var(--muted)]" data-count="projects">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="recommendations" type="button">
              <span>推荐</span>
              <span class="text-[var(--muted)]" data-count="recommendations">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="gallery" type="button">
              <span>PersonalPhoto</span>
              <span class="text-[var(--muted)]" data-count="gallery">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="personalVideos" type="button">
              <span>PersonalVideo</span>
              <span class="text-[var(--muted)]" data-count="personalVideos">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="images" type="button">
              <span>素材图片库</span>
              <span class="text-[var(--muted)]" data-count="images">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="videos" type="button">
              <span>素材视频库</span>
              <span class="text-[var(--muted)]" data-count="videos">0</span>
            </button>
            <button class="orbit-button flex items-center justify-between text-left" data-section="settings" type="button">
              <span>页面配置</span>
              <span class="text-[var(--muted)]" data-count="settings">编辑</span>
            </button>
          </nav>

          <section class="orbit-status-card mt-4 border p-3">
            <p class="exhibition-meta text-xs uppercase tracking-[0.2em]">Status</p>
            <p class="mt-3 min-h-12 text-sm leading-6 text-[var(--muted)]" data-status>正在读取公开内容。</p>
          </section>

          <section class="orbit-status-card mt-3 border p-3">
            <p class="exhibition-meta text-xs uppercase tracking-[0.2em]">Publish</p>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]" data-pending-summary>暂无待同步改动。</p>
            <button class="orbit-button orbit-button-primary mt-3 w-full" data-sync-all type="button">同步全部改动</button>
          </section>
        </aside>

        <div class="grid min-w-0 gap-5 xl:grid-cols-[300px_minmax(0,1fr)] 2xl:grid-cols-[340px_minmax(0,1fr)]">
        <section class="orbit-panel exhibition-panel p-4">
          <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
            <div>
              <p class="exhibition-meta text-xs uppercase tracking-[0.2em]" data-list-kicker>Posts</p>
              <h2 class="orbit-panel-title mt-1 text-2xl" data-list-title>文章列表</h2>
            </div>
            <button class="orbit-button orbit-button-primary" data-new-current type="button">new</button>
          </div>
          <div class="orbit-list mt-3 grid max-h-[calc(100vh-250px)] gap-2 overflow-auto pr-1" data-list>
            <p class="text-sm text-[var(--muted)]">连接后加载内容。</p>
          </div>
        </section>

        <section class="orbit-panel exhibition-panel min-w-0 p-4 md:p-5">
          <section class="orbit-view" data-view="posts">
            <div class="flex flex-col gap-3 border-b border-[var(--line)] pb-4 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">Post Editor</p>
                <h2 class="mt-1 text-2xl font-semibold" data-post-title>新建文章</h2>
              </div>
              <div class="orbit-actions">
                <button class="orbit-button" data-post-upload-cover type="button">封面</button>
                <button class="orbit-button" data-post-upload-body-image type="button">插入图片</button>
                <button class="orbit-button" data-post-upload-video type="button">插入视频</button>
                <button class="orbit-button" data-post-insert-selected-image type="button">用选中图</button>
                <button class="orbit-button orbit-button-primary" data-save-post type="button">保存文章</button>
                <button class="orbit-button orbit-danger" data-delete-post type="button">删除文章</button>
                <input class="hidden" data-post-cover-file type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
                <input class="hidden" data-post-body-image-file type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
                <input class="hidden" data-post-video-file type="file" accept="video/mp4,video/webm,video/quicktime,.mov" />
              </div>
            </div>

            <div class="mt-4 grid gap-4 2xl:grid-cols-[1fr_0.8fr]">
              <form class="grid gap-4">
                <div class="grid gap-4 md:grid-cols-2">
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Slug</span>
                    <input class="orbit-input mt-2 font-mono text-sm" data-post-field="slug" placeholder="my-new-post" />
                  </label>
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Publish Date</span>
                    <input class="orbit-input mt-2 font-mono text-sm" data-post-field="publishDate" type="date" />
                  </label>
                </div>
                <label>
                  <span class="font-mono text-xs text-[var(--muted)]">Title</span>
                  <input class="orbit-input mt-2 text-sm" data-post-field="title" placeholder="文章标题" />
                </label>
                <label>
                  <span class="font-mono text-xs text-[var(--muted)]">Description</span>
                  <textarea class="orbit-input mt-2 min-h-20 text-sm leading-6" data-post-field="description" placeholder="文章摘要"></textarea>
                </label>
                <div class="grid gap-4 md:grid-cols-2">
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Cover</span>
                    <input class="orbit-input mt-2 font-mono text-sm" data-post-field="cover" placeholder="/images/cover.png" />
                  </label>
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Tags</span>
                    <input class="orbit-input mt-2 text-sm" data-post-field="tags" placeholder="生活, 前端, 随笔" />
                  </label>
                </div>
                <label class="flex items-center gap-2 text-sm text-[var(--muted)]">
                  <input data-post-field="draft" type="checkbox" />
                  保存为草稿
                </label>
                <label>
                  <span class="font-mono text-xs text-[var(--muted)]">Body</span>
                  <span class="ml-2 text-xs text-[var(--muted)]">图片会进入素材图片库；视频会进入 videos，并插入到光标位置。</span>
                  <textarea class="orbit-input mt-2 min-h-[420px] font-mono text-sm leading-7" data-post-field="body" placeholder="开始写 Markdown / MDX..."></textarea>
                </label>
              </form>

              <section class="orbit-field-panel quiet-card p-4">
                <div class="flex items-center justify-between border-b border-[var(--line)] pb-3">
                  <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">Preview</p>
                  <span class="font-mono text-xs text-[var(--muted)]">Markdown</span>
                </div>
                <article class="prose mt-4 max-w-none" data-post-preview></article>
              </section>
            </div>
          </section>

          <section class="orbit-view" data-view="projects" hidden>
            <div class="flex flex-col gap-3 border-b border-[var(--line)] pb-4 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">Project Editor</p>
                <h2 class="mt-1 text-2xl font-semibold" data-project-title>新建项目</h2>
              </div>
              <div class="orbit-actions">
                <button class="orbit-button orbit-button-primary" data-save-project type="button">保存项目</button>
                <button class="orbit-button orbit-danger" data-delete-project type="button">删除项目</button>
              </div>
            </div>

            <form class="mt-4 grid gap-4">
              <div class="grid gap-4 md:grid-cols-2">
                <label>
                  <span class="font-mono text-xs text-[var(--muted)]">Name</span>
                  <input class="orbit-input mt-2 text-sm" data-project-field="name" placeholder="项目名称" />
                </label>
                <label>
                  <span class="font-mono text-xs text-[var(--muted)]">Year</span>
                  <input class="orbit-input mt-2 font-mono text-sm" data-project-field="year" placeholder="2026" />
                </label>
              </div>
              <label>
                <span class="font-mono text-xs text-[var(--muted)]">Description</span>
                <textarea class="orbit-input mt-2 min-h-28 text-sm leading-6" data-project-field="description" placeholder="项目简介"></textarea>
              </label>
              <div class="grid gap-4 md:grid-cols-2">
                <label>
                  <span class="font-mono text-xs text-[var(--muted)]">Tags</span>
                  <input class="orbit-input mt-2 text-sm" data-project-field="tags" placeholder="Astro, Design, Tool" />
                </label>
                <label>
                  <span class="font-mono text-xs text-[var(--muted)]">Link</span>
                  <input class="orbit-input mt-2 font-mono text-sm" data-project-field="link" placeholder="https://..." />
                </label>
              </div>
            </form>
          </section>

          <section class="orbit-view" data-view="recommendations" hidden>
            <div class="flex flex-col gap-3 border-b border-[var(--line)] pb-4 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">Recommendation Editor</p>
                <h2 class="mt-1 text-2xl font-semibold" data-recommendation-title>新建推荐</h2>
              </div>
              <div class="orbit-actions">
                <button class="orbit-button" data-recommendation-upload-image type="button">上传封面</button>
                <button class="orbit-button" data-recommendation-use-selected-image type="button">用选中图</button>
                <button class="orbit-button orbit-button-primary" data-save-recommendation type="button">保存推荐</button>
                <button class="orbit-button orbit-danger" data-delete-recommendation type="button">删除推荐</button>
                <input class="hidden" data-recommendation-image-file type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
              </div>
            </div>

            <div class="mt-4 grid gap-4 2xl:grid-cols-[1fr_320px]">
              <form class="grid gap-4">
                <div class="grid gap-4 md:grid-cols-[1fr_180px]">
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Title</span>
                    <input class="orbit-input mt-2 text-sm" data-recommendation-field="title" placeholder="推荐名称" />
                  </label>
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Category</span>
                    <select class="orbit-input mt-2 font-mono text-sm" data-recommendation-field="category">
                      <option value="book">book / 书籍</option>
                      <option value="film">film / 影视</option>
                      <option value="music">music / 歌曲</option>
                      <option value="game">game / 游戏</option>
                      <option value="other">other / 其他</option>
                    </select>
                  </label>
                </div>
                <div class="grid gap-4 md:grid-cols-3">
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Creator</span>
                    <input class="orbit-input mt-2 text-sm" data-recommendation-field="creator" placeholder="作者 / 导演 / 歌手 / 厂商" />
                  </label>
                  <label>
                    <span class="font-mono text-xs text-[var(--muted)]">Year</span>
